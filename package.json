{
  "name": "ready-apologia",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' astro dev",
    "start": "astro dev",
    "build": "NODE_OPTIONS='--experimental-sqlite' astro build",
    "preview": "astro preview",
    "serve": "node scripts/serve.js",
    "test:seo": "node scripts/test_seo.mjs",
    "test:convenient-revelations": "node --test src/utils/convenientRevelations/model.test.mjs",
    "audit:convenient-revelations": "node scripts/test_convenient_revelations.mjs",
    "test:orv": "NODE_OPTIONS='--experimental-sqlite' node --test src/utils/originsOfRevelation/*.test.mjs && NODE_OPTIONS='--experimental-sqlite' node scripts/test_origins_of_revelation.mjs",
    "test:discover-layout": "node scripts/test_discover_layout.mjs",
    "audit:mecca-to-medina": "node --test src/utils/meccaToMedina/model.test.mjs && node scripts/test_mecca_to_medina.mjs",
    "proposals:mecca-to-medina": "node scripts/gen_mecca_to_medina_data_proposals.mjs",
    "import:hadith": "node scripts/import_hadith.js",
    "test:quran-preservation": "node --test src/utils/quranPreservation/loader.test.mjs",
    "audit:quran-preservation": "node scripts/test_quran_preservation.mjs",
    "test:muhammad-slavery": "node --experimental-sqlite --test src/utils/muhammadSlavery/*.test.mjs",
    "audit:muhammad-slavery": "node --experimental-sqlite scripts/test_muhammad_slavery.mjs",
    "verify:muhammad-slavery": "node --experimental-sqlite scripts/verify_muhammad_slavery_quotes.mjs",
    "gen:muhammad-slavery-arabic": "node --experimental-sqlite scripts/muhammad_slavery/gen_arabic.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "astro": "^6.4.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-zoom-pan-pinch": "^3.4.4"
  }
}
