# Google Analytics 4 Measurement ID
# Set to your property ID (e.g. G-XXXXXXXXXX) for local testing or production deployment.
# If omitted or set to G-PLACEHOLDER, analytics runs safely in debug/mock mode.
PUBLIC_GA_MEASUREMENT_ID=G-PLACEHOLDER

# Microsoft Clarity Project ID
# Set to your Clarity project ID (e.g. z4u6yumza1) to enable session recordings and heatmaps.
# If omitted or set to CLARITY-PLACEHOLDER, Clarity is disabled.
PUBLIC_CLARITY_PROJECT_ID=CLARITY-PLACEHOLDER
