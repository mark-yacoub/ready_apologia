---
/** Permalink for a single annotated hadith in Bukhari (Sunnah.com numbering). */
import HadithPermalinkPage from '../../../components/hadith/HadithPermalinkPage.astro';
import { loadHadithModel } from '../../../utils/hadithLoader.js';

export function getStaticPaths() {
  return [...loadHadithModel().records.values()]
    .filter(record => record.collection === 'bukhari')
    .map(record => ({ params: { num: record.sunnahNum }, props: { record } }));
}

const { record } = Astro.props;
---
<HadithPermalinkPage record={record} />
