---
import { generateBibleTabSEO } from '../../../../../utils/seoFactory.js';
import Layout from '../../../../../layouts/Layout.astro';
import RouteAnalytics from '../../../../../components/common/RouteAnalytics.astro';
import VerseTabs from '../../../../../components/VerseTabs.jsx';
import ManuscriptCarousel from '../../../../../components/ManuscriptCarousel.jsx';
import VideosGrid from '../../../../../components/VideosGrid.astro';
import { R2_BASE_URL } from '../../../../../utils/cdn_config.js';
import { getBibleOgImage } from '../../../../../utils/ogImageResolver.js';
import booksMeta from '../../../../../data/books_meta.json';
import { parseMarkdown } from '../../../../../utils/markdown.js';
import { mapLxxToMt, mapMtToLxx } from '../../../../../utils/scripture_mapper.js';
import SourceFooter from '../../../../../components/SourceFooter.astro';
import { getEvidenceCounts, getFormattedManuscriptsByVerseId, getContradictionsByVerseId, getApologeticsByVerseId, getRawVideosByVerseId } from '../../../../../utils/evidence_repository.js';
import { BUILD_BOOKS } from '../../../../../utils/build_config.js';
import { getScriptureVerseText, getScriptureVerseTextById } from '../../../../../utils/scripture_service.js';
import { enrichVideosWithVerses } from '../../../../../utils/video_service.js';
import { getAllEvidenceVerseSets, parseVerseId } from '../../../../../utils/path_generator.js';

// 1. Pre-render sub-path page routes
export async function getStaticPaths() {
  const { msSet, ctSet, apSet, vdSet, allVerseIds } = getAllEvidenceVerseSets();
  const paths = [];

  const booksToBuild = BUILD_BOOKS;

  allVerseIds.forEach(id => {
    const parts = parseVerseId(id);
    if (parts) {
      const b = parts.book;
      const c = parts.chapter;
      const v = parts.verse;

      if (booksToBuild && !booksToBuild.has(b)) return;

      if (msSet.has(id)) paths.push({ params: { book: b, chapter: c, verse: v, tab: 'manuscripts' } });
      if (ctSet.has(id)) paths.push({ params: { book: b, chapter: c, verse: v, tab: 'contradictions' } });
      if (apSet.has(id)) paths.push({ params: { book: b, chapter: c, verse: v, tab: 'apologetics' } });
      if (vdSet.has(id)) paths.push({ params: { book: b, chapter: c, verse: v, tab: 'videos' } });
    }
  });

  return BUILD_BOOKS ? paths.filter(p => BUILD_BOOKS.has(p.params.book)) : paths;
}

const { book, chapter, verse, tab } = Astro.params;
const verseId = `${book}_${chapter}_${verse}`;

// 1.5 Pre-compute O(1) books map
const booksMetaMap = {};
booksMeta.nt.forEach(b => booksMetaMap[b.id] = b);
booksMeta.ot.forEach(b => booksMetaMap[b.id] = b);

// 2. Find Book Details
const bookMeta = booksMetaMap[book];

if (!bookMeta) {
  return Astro.redirect('/404');
}

const isNT = booksMeta.nt.some(b => b.id === book);

const mtObj = mapLxxToMt(book, chapter, verse);
const mtId = `${mtObj.book}_${mtObj.chapter}_${mtObj.verse}`;
const checkId = isNT ? verseId : mtId;

// 3. Query active evidence counts
const { msCount, ctCount, apCount, vdCount } = getEvidenceCounts(verseId, mtId, checkId, isNT);

// 3.5 Load Verse Text
const verseText = getScriptureVerseText(book, chapter, verse);

// 4. Query active evidence data
let manuscripts = [];
let contradictions = [];
let apologetics = [];
let videos = [];

if (tab === 'manuscripts') {
  manuscripts = getFormattedManuscriptsByVerseId(verseId, mtId, isNT);
}

if (tab === 'contradictions') {
  contradictions = getContradictionsByVerseId(checkId);
}

if (tab === 'apologetics') {
  apologetics = getApologeticsByVerseId(checkId);
}

if (tab === 'videos') {
  const rawVideos = getRawVideosByVerseId(checkId);
  videos = enrichVideosWithVerses(rawVideos, import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL);
}

function formatBookIdToName(id) {
  if (!id) return '';
  const bookCode = id.split('_')[0];
  const found = booksMetaMap[bookCode];
  return found ? found.name : bookCode.toUpperCase();
}

function formatVerseIdToLabel(id) {
  if (!id) return '';
  const p = id.split('_');
  if (!booksMetaMap[p[0]]) return '';

  if (booksMeta.ot.some(b => b.id === p[0])) {
    const m = mapMtToLxx(p[0], p[1], p[2]);
    return `${formatBookIdToName(id)} ${m.chapter}:${m.verse}`;
  }
  return `${formatBookIdToName(id)} ${p[1]}:${p[2]}`;
}

function formatVerseIdToLink(id, targetTab = 'contradictions') {
  if (!id) return '';
  const p = id.split('_');
  const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
  if (booksMeta.ot.some(b => b.id === p[0])) {
    const m = mapMtToLxx(p[0], p[1], p[2]);
    return `${base}/bible/${m.book}/${m.chapter}/${m.verse}/${targetTab}`;
  }
  return `${base}/bible/${p[0]}/${p[1]}/${p[2]}/${targetTab}`;
}
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

// Construct explicit self-referencing canonical URL for the active verse tab
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/bible/${book}/${chapter}/${verse}/${tab}`;

// Generate OG Image from the oldest manuscript
const ogImage = getBibleOgImage(book, chapter, verse, isNT);

const { seoTitle, seoDescription, seoKeywords, seoSchema } = generateBibleTabSEO({
  tab,
  book,
  bookName: bookMeta.name,
  chapter,
  verse,
  manuscripts,
  contradictions,
  apologetics,
  isNT,
  canonicalUrl: canonicalURL
});

---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={seoSchema}
>
  <RouteAnalytics
    eventName="evidence_tab_view"
    params={{
      testament: 'Bible',
      book_or_surah: book,
      chapter_or_ayah: chapter,
      verse_id: `${book}_${chapter}_${verse}`,
      tab_id: tab
    }}
  />
  <div class="verse-detail-container">

    <!-- Top Header Back Navigation -->
    <header class="detail-header select-none">
      <a href={`${base}/bible/${book}/${chapter}#${verse}`} class="back-btn" aria-label="Go back to chapter reader">
        <span class="back-arrow">
          <svg width="6" height="10" fill="none" stroke="currentColor" viewBox="0 0 6 10" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 9L1 5l4-4" />
          </svg>
        </span>
        <span>{bookMeta.name} {chapter}</span>
      </a>

      <!-- Minimalist Heading showing exactly John 1:1 with subtle Settings Ellipsis -->
      <div style="display: flex; align-items: center; gap: 8px;">
        <h2 class="verse-drawer-title">
          {bookMeta.name} {chapter}:{verse}
        </h2>
        <button id="open-tab-settings-btn" class="subtle-ellipsis-btn" aria-label="Customize Verse View" title="Customize Tabs">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12a2 2 0 114 0 2 2 0 01-4 0zm8 0a2 2 0 114 0 2 2 0 01-4 0zm8 0a2 2 0 114 0 2 2 0 01-4 0z" />
          </svg>
        </button>
      </div>
    </header>

    {verseText && (
      <div class="verse-text-reminder select-text">
        "{verseText}"
      </div>
    )}

    <script>
      // Trigger the React modal from the static Astro shell
      // Listen to astro:page-load to re-attach the event listener after View Transitions navigation
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('open-tab-settings-btn');
        if (btn) {
          // Remove old listener to prevent duplicates if the element wasn't destroyed
          btn.onclick = () => {
            window.dispatchEvent(new CustomEvent('open-tab-settings'));
          };
        }
      });
    </script>

    <!-- Static Segmented Tab switcher anchors -->
    <VerseTabs
      client:load
      msCount={msCount}
      ctCount={ctCount}
      apCount={apCount}
      videosCount={vdCount}
      activeTab={tab}
      book={book}
      chapter={chapter}
      verse={verse}
    />

    <!-- ACTIVE TAB PANEL CONTENTS -->
    <div class="tab-panels-window">

      {tab === 'manuscripts' && (
        <div>
          <ManuscriptCarousel
            client:load
            manuscripts={manuscripts}
            verseId={verseId}
            verseLabel={`${bookMeta.name} ${chapter}:${verse}`}
            isNT={isNT}
          />
        </div>
      )}

      {tab === 'contradictions' && (
        <div class="contradiction-panel-container">
          {contradictions.length > 0 ? (
            contradictions.map((ct, index) => {
              const otherVerseId = ct.verse1 === checkId ? ct.verse2 : ct.verse1;
              const otherVerseLabel = formatVerseIdToLabel(otherVerseId);
              const otherVerseLink = formatVerseIdToLink(otherVerseId);
              const otherVerseText = getScriptureVerseTextById(otherVerseId);

              // Determine if details panel is open by default (always open if 1, pre-open 1st if multiple)
              const isInitiallyOpen = contradictions.length === 1 || index === 0;

              return (
                <details open={isInitiallyOpen} class="contradiction-details-card">

                  {/* Interactive Accordion Header Title */}
                  <summary class="contradiction-summary-header select-none">
                    <span class="summary-title">{ct.title}</span>
                    <span class="summary-chevron">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </summary>

                  {/* Collapsible Content Panel */}
                  <div class="contradiction-card-content">

                    {otherVerseId && (
                      <div class="contrasting-verse-section">
                        <div class="contrasting-badge-box select-none">
                          <span class="badge-box-label">Contrasting Link:</span>
                          <a href={otherVerseLink} class="contrasting-link-pill">
                            <span>{otherVerseLabel}</span>
                            <span class="link-arrow">&rarr;</span>
                          </a>
                        </div>
                        {otherVerseText && (
                          <div class="verse-text-reminder select-text contradicting-text-box">
                            "{otherVerseText}"
                          </div>
                        )}
                      </div>
                    )}

                    {/* Optional AI Summary */}
                    {ct.summary && (
                      <div class="ai-summary-box select-none">
                        <span class="ai-icon" title="AI Generated Summary">
                          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                          </svg>
                        </span>
                        <div class="ai-summary-text" set:html={parseMarkdown(ct.summary)} />
                      </div>
                    )}

                    {/* Rich Markdown body parser */}
                    <div class="card-response-body select-text">
                      <div set:html={parseMarkdown(ct.answer)} />
                    </div>

                    {/* Subtle Source Meta Credit Footer */}
                    <SourceFooter item={ct} />

                  </div>

                </details>
              );
            })
          ) : (
            <p class="empty-tabs-placeholder">No alleged contradictions mapped for this verse.</p>
          )}
        </div>
      )}

      {tab === 'apologetics' && (
        <div class="apologetics-panel-container">
          {apologetics.length > 0 ? (
            apologetics.map((ap, index) => {
              // Determine if details panel is open by default (always open if 1, pre-open 1st if multiple)
              const isInitiallyOpen = apologetics.length === 1 || index === 0;

              return (
                <details open={isInitiallyOpen} class="apologetics-details-card">

                  {/* Interactive Accordion Header Title */}
                  <summary class="apologetics-summary-header select-none">
                    <span class="summary-title">{ap.title}</span>
                    <span class="summary-chevron">
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </span>
                  </summary>

                  {/* Collapsible Content Panel */}
                  <div class="apologetics-card-content">

                    {/* Optional AI Summary */}
                    {ap.summary && (
                      <div class="ai-summary-box select-none">
                        <span class="ai-icon" title="AI Generated Summary">
                          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                          </svg>
                        </span>
                        <div class="ai-summary-text" set:html={parseMarkdown(ap.summary)} />
                      </div>
                    )}

                    {/* Rich Markdown body parser */}
                    <div class="card-response-body select-text">
                      <div set:html={parseMarkdown(ap.answer)} />
                    </div>

                    {/* Subtle Source Meta Credit Footer */}
                    <SourceFooter item={ap} />

                  </div>

                </details>
              );
            })
          ) : (
            <p class="empty-tabs-placeholder">No apologetics defenses mapped for this verse.</p>
          )}
        </div>
      )}

      {tab === 'videos' && (
        <div class="videos-panel-container">
          <VideosGrid videos={videos} />
        </div>
      )}

    </div>
  </div>
</Layout>

<style>
	/* ==========================================
	   Tab Sub-Path Detail View CSS
	   ========================================== */

	/* Header Apple Navigation */
	.subtle-ellipsis-btn {
		background: transparent;
		border: none;
		color: var(--color-on-surface-variant);
		opacity: 0.6;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 12px;
		margin: -8px; /* Offset the large padding to maintain visual alignment */
		border-radius: 50%;
		transition: all 0.2s ease;
	}
	.subtle-ellipsis-btn:hover {
		opacity: 1;
		color: var(--color-primary);
		background-color: var(--color-surface-container-low);
	}
	.subtle-ellipsis-btn:active {
		transform: scale(0.95);
	}

	/* Panels */
	.contradiction-panel-container, .apologetics-panel-container {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	/* Semantic Details/Summary Accordion Cards */
	.contradiction-details-card {
		background-color: var(--color-surface);
		border: 1px solid var(--color-outline-variant);
		border-left: 3px solid transparent; /* Keep left border consistent for alignment */
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
		transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
		display: flex;
		flex-direction: column;
	}
	.contradiction-details-card:hover {
		transform: translateY(-1.5px);
		box-shadow: 0 8px 12px -2px rgba(0, 0, 0, 0.03);
		border-color: var(--color-outline);
	}
	.contradiction-details-card[open] {
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04);
		border-color: rgba(151, 69, 67, 0.25);
		border-left: 3px solid var(--color-secondary); /* 3px terracotta edge accent indicators! */
	}

	.contradiction-summary-header {
		padding: 16px;
		cursor: pointer;
		font-family: var(--font-body);
		font-size: 16px;
		font-weight: 800;
		color: var(--color-primary);
		list-style: none; /* Hide default disclosure arrow */
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: background-color 0.15s;
	}
	.contradiction-summary-header::-webkit-details-marker {
		display: none; /* Safari support */
	}
	.contradiction-summary-header:hover {
		background-color: #f9f8f7; /* Soft warm sandstone-cream on hover! */
	}

	.summary-title {
		flex: 1;
		line-height: 1.35;
		padding-right: 10px;
	}

	.summary-chevron {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-on-surface-variant);
		transition: transform 0.2s ease;
	}
	.contradiction-details-card[open] .summary-chevron {
		transform: rotate(180deg);
		color: var(--color-secondary);
	}

	.contradiction-card-content {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		border-top: 1px solid var(--color-outline-variant);
		animation: slideDown 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
	}

	/* ==========================================
	   Apologetics Accordion Specific Rules (Blue Theme)
	   ========================================== */
	.apologetics-details-card {
		background-color: var(--color-surface);
		border: 1px solid var(--color-outline-variant);
		border-left: 3px solid transparent;
		border-radius: 14px;
		overflow: hidden;
		box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
		transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
		display: flex;
		flex-direction: column;
	}
	.apologetics-details-card:hover {
		transform: translateY(-1.5px);
		box-shadow: 0 8px 12px -2px rgba(0, 0, 0, 0.03);
		border-color: var(--color-outline);
	}
	.apologetics-details-card[open] {
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04);
		border-color: rgba(37, 99, 235, 0.25); /* 25% blue border */
		border-left: 3px solid #2563eb; /* 3px Apple Blue edge accent indicator! */
	}

	.apologetics-summary-header {
		padding: 16px;
		cursor: pointer;
		font-family: var(--font-body);
		font-size: 16px;
		font-weight: 800;
		color: var(--color-primary);
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		transition: background-color 0.15s;
	}
	.apologetics-summary-header::-webkit-details-marker {
		display: none;
	}
	.apologetics-summary-header:hover {
		background-color: #f9f8f7; /* soft warm sandstone hover */
	}

	.apologetics-details-card[open] .summary-chevron {
		transform: rotate(180deg);
		color: #2563eb; /* Rotate chevron into Apple Blue! */
	}

	.apologetics-card-content {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		border-top: 1px solid var(--color-outline-variant);
		animation: slideDown 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
	}

	/* Source Meta Credit Footer Layouts */
	.card-footer-source-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px dashed var(--color-outline-variant);
		padding-top: 10px;
		margin-top: 4px;
	}
	.source-meta-text {
		font-size: 10px;
		color: var(--color-on-surface-variant);
		opacity: 0.95;
	}
	.source-meta-label {
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.3px;
		margin-right: 4px;
	}
	.source-name-text {
		font-weight: 700;
	}
	.source-copyright-text {
		font-style: italic;
		margin-left: 4px;
		opacity: 0.85;
	}

	.source-visit-pill-btn {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 8px;
		border-radius: 5px;
		background-color: var(--color-surface-container-low);
		border: 1px solid var(--color-outline-variant);
		color: var(--color-primary);
		font-size: 10px;
		font-weight: 800;
		text-decoration: none;
		transition: all 0.15s;
	}
	.source-visit-pill-btn:hover {
		background-color: var(--color-outline-variant);
		color: var(--color-secondary);
	}
	.source-visit-pill-btn svg {
		stroke: currentColor;
		fill: none;
	}



	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-2px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.card-header {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 3px 7px;
		border-radius: 5px;
		font-size: 9.5px;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		align-self: flex-start;
	}
	.card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.card-icon svg {
		stroke: currentColor;
		fill: none;
	}

	.red-badge {
		background-color: rgba(151, 69, 67, 0.05);
		color: var(--color-secondary);
		border: 1px solid rgba(151, 69, 67, 0.2);
	}
	.blue-badge {
		background-color: rgba(37, 99, 235, 0.05);
		color: #2563eb;
		border: 1px solid rgba(37, 99, 235, 0.2);
	}

	.card-title {
		font-family: var(--font-body);
		font-size: 16px;
		font-weight: 800;
		color: var(--color-primary);
		margin: 0;
		line-height: 1.3;
	}

	/* Contrasting Cross-Reference Link Pill */
	.contrasting-badge-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 8px 10px;
		background-color: #fafafa;
		border: 1px solid var(--color-outline-variant);
		border-radius: 8px;
	}
	.badge-box-label {
		font-size: 10px;
		font-weight: 700;
		color: var(--color-on-surface-variant);
	}
	.contrasting-link-pill {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 3px 8px;
		border-radius: 5px;
		background-color: rgba(151, 69, 67, 0.08);
		border: 1px solid rgba(151, 69, 67, 0.2);
		color: var(--color-secondary);
		font-size: 11px;
		font-weight: 800;
		text-decoration: none;
		transition: background-color 0.15s;
	}
	.contrasting-link-pill:hover {
		background-color: rgba(151, 69, 67, 0.15);
	}
	.link-arrow {
		font-size: 10px;
	}

	/* Exegesis response body styling */
	.card-response-body {
		border-top: 1px solid var(--color-outline-variant);
		padding-top: 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.body-section-label {
		font-size: 9.5px;
		font-weight: 800;
		color: var(--color-primary);
