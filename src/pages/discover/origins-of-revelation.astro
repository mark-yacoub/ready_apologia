---
/**
 * /discover/origins-of-revelation: five things the classical Islamic sources record about how
 * revelation came, each beside the Bible's accounts of angels and of troubling spirits, with the
 * classical scholars' explanation and the New Testament's test of a spirit. One page, same URL.
 *
 * Built on the hadith-reliability design system (`.hrv`) plus a small scoped layer (`.hrv.orv`).
 * Copy: src/utils/originsOfRevelation/content.js. Data: demonic_revelation.json (read-only, locked by
 * dataLock.js) + quoteFixes.js (verified render-time fixes, also proposed to the data owner).
 * Static and stateless: zero React islands, no storage, no URL rewriting on scroll. Old section ids
 * (#initial-encounter, #suicidal-despair, …) land on their new sections via alias anchors.
 */
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import SectionNav from '../../components/discover/origins-of-revelation/SectionNav.astro';
import GlanceRows from '../../components/discover/origins-of-revelation/GlanceRows.astro';
import SectionHead from '../../components/discover/origins-of-revelation/SectionHead.astro';
import ConfrontationFrame from '../../components/discover/origins-of-revelation/ConfrontationFrame.astro';
import WitnessStrip from '../../components/discover/origins-of-revelation/WitnessStrip.astro';
import CardGroup from '../../components/discover/origins-of-revelation/CardGroup.astro';
import ClassicalPair from '../../components/discover/origins-of-revelation/ClassicalPair.astro';
import SourcesBlock from '../../components/discover/origins-of-revelation/SourcesBlock.astro';
import * as CONTENT from '../../utils/originsOfRevelation/content.js';
import { loadOriginsOfRevelation } from '../../utils/originsOfRevelation/model.js';
import { BASE, BASE_PATH, OG_IMAGE, SITE_URL, DATE_PUBLISHED, DATE_MODIFIED, GLANCE_ID, SOURCES_ID, CATALOG_SLUG, discoverHref } from '../../utils/originsOfRevelation/config.js';
import { buildBreadcrumbSchema, SITE_NAME, DEFAULT_LOGO_URL } from '../../utils/seoFactory.js';
import { tl } from '../../utils/hadithReliability/render.js';
import '../../styles/hadith-reliability.css';
import '../../styles/origins-of-revelation.css';

const model = loadOriginsOfRevelation(CONTENT);
const { seo, header, labels, nav, glance, sections, sources, closing } = model;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : SITE_URL;
const canonicalURL = `${site}${BASE_PATH}`;
const ogImage = `${site}${OG_IMAGE}`;

// JSON-LD: BreadcrumbList (unique URLs) + Article (with citations). No FAQPage / ClaimReview.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumbSchema([
      { name: 'Ready Apologia', url: `${site}${BASE}/` },
      { name: 'Discover', url: `${site}${BASE}/discover` },
      { name: seo.title, url: canonicalURL },
    ]),
    {
      '@type': 'Article',
      '@id': `${canonicalURL}#article`,
      headline: seo.title,
      description: seo.description,
      url: canonicalURL,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      image: [ogImage],
      inLanguage: 'en',
      author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      publisher: { '@type': 'Organization', name: SITE_NAME, logo: { '@type': 'ImageObject', url: DEFAULT_LOGO_URL } },
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_MODIFIED,
      citation: model.citations.map(c => ({ '@type': 'CreativeWork', name: c.name, url: c.url })),
    },
  ],
};
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: CATALOG_SLUG }} />
  <article class="hrv orv" id="top">
    <SectionNav nav={nav} labels={labels} backHref={discoverHref()} canonical={canonicalURL} />
    <div class="hrv-wrap">
      <header class="hrv-case-head orv-head">
        <p class="hrv-eyebrow" set:html={tl(header.eyebrow)} />
        <h1 class="hrv-case-h1 orv-h1" set:html={header.h1Html} />
        <p class="hrv-hook orv-hook" set:html={header.hookHtml} />
        <a class="orv-head__context" href={`#${SOURCES_ID}`} title={header.contextText}><span set:html={header.contextHtml} /><Icon name="chevronRight" /></a>
        {header.framingHtml && <p class="orv-framing" set:html={header.framingHtml} />}
        {header.whosWhoHtml && (
          <details class="hrv-disclosure orv-deeper orv-whos-who">
            <summary>
              <span set:html={tl(header.whosWhoSummary)} />
              <Icon name="chevronDown" />
            </summary>
            <div class="hrv-disclosure__body orv-pair__body"><p set:html={header.whosWhoHtml} /></div>
          </details>
        )}
        {model.emphasisNote && <p class="orv-emph" set:html={tl(model.emphasisNote)} />}
      </header>

      <section class="orv-glance-sec" id={GLANCE_ID} aria-labelledby={`${GLANCE_ID}-h`}>
        <h2 class="hrv-eyebrow orv-glance-sec__h" id={`${GLANCE_ID}-h`} set:html={tl(labels.glance)} />
        <GlanceRows rows={glance} />
      </section>

      {sections.map(s => (
        <section class={`hrv-sec orv-sec${s.isItem ? '' : ' orv-sec--method'}`} id={s.id} aria-labelledby={`${s.id}-h`}>
          <SectionHead s={s} context={model.coldContext} />
          {s.showcase && <ConfrontationFrame showcase={s.showcase} />}
          {s.witnesses && <WitnessStrip w={s.witnesses} />}
          {s.introHtml && <p class="orv-intro" set:html={s.introHtml} />}
          {s.groups.length > 0 && (
            <div class="orv-say">
              {labels.sourcesWhat && <p class="hrv-eyebrow orv-what" set:html={tl(labels.sourcesWhat)} />}
              <div class="orv-say__groups">{s.groups.map(g => <CardGroup g={g} labels={labels} />)}</div>
            </div>
          )}
          <ClassicalPair classical={s.classical} evaluation={s.evaluation} deeper={s.deeper} />
        </section>
      ))}

      <section class="hrv-sec orv-sec orv-sec--sources" id={SOURCES_ID} aria-labelledby={`${SOURCES_ID}-h`}>
        <div class="hrv-q__head orv-sec__head">
          <span class="hrv-q__num orv-sec__mark" aria-hidden="true"><Icon name="book" /></span>
          <h2 class="hrv-q__title" id={`${SOURCES_ID}-h`} set:html={tl(labels.sources)} />
        </div>
        <SourcesBlock groups={sources} />
        <div class="orv-closing">
          <h2 class="orv-closing__h" id="closing-h" set:html={tl(closing.heading || labels.closingHeading)} />
          <div class="orv-closing__body" set:html={closing.html} />
        </div>
        {labels.backToTop && <a class="orv-top" href="#top"><Icon name="chevronDown" class="orv-top__icon" /><span set:html={tl(labels.backToTop)} /></a>}
      </section>
    </div>
  </article>
  <script src="../../components/discover/origins-of-revelation/client.js"></script>
</Layout>
