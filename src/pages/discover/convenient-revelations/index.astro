---
import Layout from '../../../layouts/Layout.astro';
import TailwindSetup from '../../../components/TailwindSetup.astro';
import RouteAnalytics from '../../../components/common/RouteAnalytics.astro';

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const pageTitle = "Convenient Revelations | Historical & Fiqh Analysis";
const pageDesc = "An evidentiary investigation into Medinan verses that descended at critical junctions of domestic conflict, financial division, military pressure, and political accountability.";
const pageKeywords = "convenient revelations, quranic exemptions, muhammad privileges, asbab al nuzul, zaynab marriage, aisha slander 4 witnesses, surah al ahzab, quran historical analysis";

const gatewayLinks = [
  {
    id: "evading-accountability",
    partNum: "PART 01",
    title: "Evading Accountability",
    subtitle: "Divine absolutions for household oaths, political slander, and fasting relaxations.",
    accentClass: "cr-part-01",
  },
  {
    id: "spoils-and-etiquette",
    partNum: "PART 02",
    title: "War Spoils, Captives & Etiquette",
    subtitle: "Annulled marriages of captives, night campaigns for the Hijab, and dinner party boundaries.",
    accentClass: "cr-part-02",
  },
  {
    id: "sexual-privileges",
    partNum: "PART 03",
    title: "Sexual Privileges & Exemptions",
    subtitle: "Abolishing equal rotation, lifting the four-wife limit, and dismantling adoption taboos.",
    accentClass: "cr-part-03",
  },
  {
    id: "wealth-and-power",
    partNum: "PART 04",
    title: "Consolidation of Wealth & Power",
    subtitle: "Discretionary monopoly over war booty (Khums & Fay), human capital, and silencing financial demands.",
    accentClass: "cr-part-04",
  }
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  ogImage="/media/convenient_revelations/cover.jpg"
>
  <TailwindSetup />
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: 'convenient-revelations' }} />

  <div class="cr-portal-container">
    {/* Apple Magazine Hero Section */}
    <header class="cr-hero">
      <h1 class="cr-hero-title">
        Convenient Revelations
      </h1>

      <p class="cr-hero-subtitle">
        A four-part historical and textual investigation into specific Medinan revelations within the context of early Islamic political, financial, and domestic consolidation.
      </p>

      {/* Hero Quote Callout Box */}
      <blockquote class="cr-hero-quote">
        <p class="cr-quote-text">
          “O Allah's Messenger! I feel that your Lord hastens in fulfilling your wishes and desires!”
        </p>
        <footer class="cr-quote-footer">
          <span class="cr-quote-author">Aisha bint Abi Bakr</span>
          <a
            href="https://sunnah.com/bukhari:5113"
            target="_blank"
            rel="noopener noreferrer"
            class="cr-quote-source"
            title="Read Sahih al-Bukhari 5113 on Sunnah.com"
          >
            Sahih al-Bukhari 5113 · Book of Wedlock
            <svg aria-hidden="true" class="cr-ext-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </footer>
      </blockquote>
    </header>

    {/* 4 Minimalist Apple Gateway Link Cards */}
    <main class="cr-links-grid" aria-label="Four Thematic Parts">
      {gatewayLinks.map((part) => (
        <a
          href={`${base}/discover/convenient-revelations/${part.id}`}
          class={`cr-link-card ${part.accentClass}`}
        >
          <div class="cr-card-top">
            <span class="cr-part-badge">{part.partNum}</span>
            <svg aria-hidden="true" class="cr-card-arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>

          <h2 class="cr-part-title">{part.title}</h2>
          <p class="cr-part-subtitle">{part.subtitle}</p>
        </a>
      ))}
    </main>

    {/* Canonical Verification Footer */}
    <footer class="cr-portal-footer">
      <div class="cr-footer-badge">VERIFIED SUNNI ORTHODOXY</div>
      <p class="cr-footer-text">
        All entries cite canonical Hadith (Bukhari, Muslim, Abu Dawud, Nasa'i) and classical exegesis (Tafsir al-Tabari, Ibn Kathir).
      </p>
    </footer>
  </div>
</Layout>

<style>
  /* Apple Editorial Gateway Styling */
  .cr-portal-container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 36px 24px 96px;
    font-family: var(--font-body, 'Public Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    color: #09090b;
    line-height: 1.6;
  }

  /* Hero Section */
  .cr-hero {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 40px;
  }

  .cr-hero-title {
    font-family: var(--font-display, 'Literata', Georgia, serif);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #09090b;
    margin: 0 0 16px 0;
  }

  .cr-hero-subtitle {
    font-size: clamp(1.0625rem, 1.8vw, 1.22rem);
    font-weight: 400;
    color: #52525b;
    max-width: 720px;
    margin: 0 auto 30px;
    line-height: 1.55;
  }

  /* Hero Quote Box */
  .cr-hero-quote {
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 20px;
    padding: 24px 28px;
    margin: 0 auto;
    max-width: 700px;
    box-shadow: 0 4px 20px -2px rgba(9, 9, 11, 0.03);
    text-align: center;
  }

  .cr-quote-text {
    font-family: var(--font-display, 'Literata', Georgia, serif);
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-style: italic;
    font-weight: 600;
    color: #09090b;
    margin: 0 0 12px 0;
    line-height: 1.42;
  }

  .cr-quote-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8125rem;
  }

  .cr-quote-author {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #974543;
  }

  .cr-quote-source {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
    color: #71717a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .cr-quote-source:hover {
    color: #974543;
    text-decoration: underline;
  }

  .cr-ext-icon {
    width: 12px;
    height: 12px;
    opacity: 0.7;
  }

  /* 4 Gateway Link Cards Grid */
  .cr-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 56px;
  }

  @media (max-width: 840px) {
    .cr-links-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Link Card Styling */
  .cr-link-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 24px;
    padding: 30px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 20px -2px rgba(9, 9, 11, 0.03);
  }

  .cr-link-card:hover {
    transform: translateY(-4px);
    border-color: #09090b;
    box-shadow: 0 14px 34px -4px rgba(9, 9, 11, 0.09);
  }

  /* Subtle Top Gradient Bar per Part */
  .cr-link-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    transition: height 0.2s ease;
  }

  .cr-part-01::before {
    background: linear-gradient(90deg, #974543, #c56865);
  }
  .cr-part-02::before {
    background: linear-gradient(90deg, #3b3858, #605c86);
  }
  .cr-part-03::before {
    background: linear-gradient(90deg, #7a2e38, #a84754);
  }
  .cr-part-04::before {
    background: linear-gradient(90deg, #6b5224, #9a7837);
  }

  .cr-link-card:hover::before {
    height: 6px;
  }

  /* Top Bar */
  .cr-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .cr-part-badge {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 8px;
  }

  .cr-part-01 .cr-part-badge {
    background: rgba(151, 69, 67, 0.1);
    color: #974543;
  }
  .cr-part-02 .cr-part-badge {
    background: rgba(59, 56, 88, 0.1);
    color: #3b3858;
  }
  .cr-part-03 .cr-part-badge {
    background: rgba(122, 46, 56, 0.1);
    color: #7a2e38;
  }
  .cr-part-04 .cr-part-badge {
    background: rgba(107, 82, 36, 0.1);
    color: #6b5224;
  }

  .cr-card-arrow {
    width: 18px;
    height: 18px;
    color: #71717a;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), color 0.18s ease;
  }

  .cr-link-card:hover .cr-card-arrow {
    transform: translateX(4px);
    color: #974543;
  }

  .cr-part-title {
    font-family: var(--font-display, 'Literata', Georgia, serif);
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.18;
    color: #09090b;
    margin: 10px 0 8px 0;
    transition: color 0.18s ease;
  }

  .cr-link-card:hover .cr-part-title {
    color: #974543;
  }

  .cr-part-subtitle {
    font-size: 1rem;
    font-weight: 400;
    color: #52525b;
    margin: 0;
    line-height: 1.5;
  }

  /* Portal Footer */
  .cr-portal-footer {
    text-align: center;
    max-width: 580px;
    margin: 0 auto;
    padding-top: 16px;
    border-top: 1px solid #e4e4e7;
  }

  .cr-footer-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #71717a;
    background: #f4f4f5;
    padding: 3px 10px;
    border-radius: 9999px;
    margin-bottom: 8px;
  }

  .cr-footer-text {
    font-size: 0.8125rem;
    color: #71717a;
    margin: 0;
  }

  @media (max-width: 520px) {
    .cr-link-card {
      padding: 22px;
    }
    .cr-part-title {
      font-size: 1.5rem;
    }
  }
</style>
