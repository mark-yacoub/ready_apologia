---
/**
 * Hub of "12 occasions of revelation" (URL slug kept: /discover/convenient-revelations).
 * Intro → method note (collapsed) → Start here (item 1 with its quote and compact showcase) →
 * 4 chapter sections (reader question + item rows) → sources used (derived counts).
 * The hub doubles as the at-a-glance view; there are no per-item pages. Stateless by design.
 */
import AudioListen from '../../../components/audio/AudioListen.astro';
import Layout from '../../../layouts/Layout.astro';
import RouteAnalytics from '../../../components/common/RouteAnalytics.astro';
import Icon from '../../../components/discover/hadith-reliability/Icon.astro';
import ItemShowcase from '../../../components/discover/convenient-revelations/ItemShowcase.astro';
import ItemRow from '../../../components/discover/convenient-revelations/ItemRow.astro';
import { loadConvenientRevelations } from '../../../utils/convenientRevelations/model.js';
import { BASE, BASE_PATH, LABELS, OG_IMAGE, HUB, ANALYTICS_ARTICLE } from '../../../utils/convenientRevelations/config.js';
import { hubSchema } from '../../../utils/convenientRevelations/schema.js';
import { tl, createRenderer } from '../../../utils/hadithReliability/render.js';
import '../../../styles/hadith-reliability.css';
import '../../../styles/convenient-revelations.css';

const model = loadConvenientRevelations();
const { parts, startHere, sourceStats } = model;
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${site}${BASE_PATH}`;
const md = createRenderer({ rootLinks: true });
---
<Layout
  title={HUB.seo.title}
  description={HUB.seo.description}
  keywords={HUB.seo.keywords || undefined}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={OG_IMAGE || undefined}
  ogType="website"
  schema={hubSchema({ site, model })}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article: ANALYTICS_ARTICLE, page: 'hub' }} />
  <div class="hrv crv crv-hub">
    <div class="hrv-wrap">
      <header class="hrv-hero">
        <a class="hrv-crumb" href={`${BASE}/discover`}><Icon name="chevronLeft" />{LABELS.hubCrumb}</a>
        <h1 class="hrv-h1" set:html={tl(HUB.h1)} />
        <AudioListen />
        <p class="hrv-intro" set:html={md.inline(HUB.intro)} />
      </header>

      <details class="hrv-disclosure crv-method" open>
        <summary><span>{HUB.methodSummary}</span><Icon name="chevronDown" /></summary>
        <div class="hrv-disclosure__body" set:html={md.block(HUB.method)} />
      </details>

      <h2 class="hrv-eyebrow hrv-eyebrow--verify hrv-section-label" id="start-here">{LABELS.startHere}</h2>
      <a class="hrv-start crv-start" href={startHere.href} aria-labelledby="start-title start-cta">
        <span class="hrv-eyebrow crv-start__eyebrow">{LABELS.itemOf.replace('{n}', 1).replace('{total}', startHere.total)} · <span set:html={tl(startHere.partLabel)} /></span>
        <span class="hrv-start__title" id="start-title" set:html={startHere.copy.title.html} />
        <div aria-hidden="true"><ItemShowcase item={startHere} compact /></div>
        <span class="hrv-start__cta" id="start-cta">{LABELS.openStart}<Icon name="arrowRight" /></span>
      </a>

      {parts.map(p => (
        <section class="hrv-q crv-q-sec" id={`chapter-${p.number}`} aria-labelledby={`chapter-${p.number}-h`}>
          <div class="hrv-q__head">
            <span class="hrv-q__num" aria-hidden="true">{String(p.number).padStart(2, '0')}</span>
            <h2 class="hrv-q__title" id={`chapter-${p.number}-h`} set:html={tl(p.question)} />
          </div>
          <p class="crv-chapter-line">
            <span set:html={tl(p.label)} /> · {LABELS.itemsCount.replace('{n}', p.items.length)} · <a href={p.href}>{LABELS.openChapter}<Icon name="chevronRight" /></a>
          </p>
          <ul class="hrv-rows">
            {p.items.map(it => (
              <li>
                {it === startHere ? (
                  <a class="hrv-row crv-row crv-row--start" href={it.href}>
                    <span class="hrv-row__icon" aria-hidden="true"><Icon name={it.showcase.type} /></span>
                    <span>
                      <span class="crv-row__start">{LABELS.startHereRow}</span>
                      <span class="hrv-row__title" set:html={it.copy.title.html} />
                      <span class="crv-row__take" set:html={it.copy.takeaway.html} />
                    </span>
                    <span class="hrv-row__chev"><Icon name="chevronRight" /></span>
                  </a>
                ) : <ItemRow item={it} />}
              </li>
            ))}
          </ul>
        </section>
      ))}

      <footer class="hrv-hub-foot">
        {LABELS.sourcesUsed}
        <ul>{sourceStats.map(s => <li><b>{s.count}</b> <span set:html={tl(s.label)} /></li>)}</ul>
        {HUB.footerNote && <p class="crv-foot-note" set:html={md.inline(HUB.footerNote)} />}
      </footer>
    </div>
  </div>
</Layout>
