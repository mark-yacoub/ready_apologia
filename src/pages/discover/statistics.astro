---
import Layout from '../../layouts/Layout.astro';
import { loadBibleStatistics, loadQuranStatistics } from '../../utils/statisticsLoader.js';

const bibleStats = loadBibleStatistics();
const quranStats = loadQuranStatistics();

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/discover/statistics`;

const pageTitle = "Scripture Statistics & Discovery Leaderboards | Ready Apologia";
const pageDesc = "Explore the most discussed, defended, and documented verses across the Bible and Quran: top video mentions, patristics treatises, manuscript density, and classical tafsir records.";
const pageKeywords = "bible statistics, quran statistics, most defended bible verses, top apologetics videos, oldest bible manuscripts, longest tafsir tabari, quran manuscript errors, patristics apologetics";

const schemaObj = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Ready Apologia", "item": `${siteUrl}${base}/` },
        { "@type": "ListItem", "position": 2, "name": "Discover", "item": `${siteUrl}${base}/discover` },
        { "@type": "ListItem", "position": 3, "name": "Statistics & Leaderboards", "item": canonicalURL }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": canonicalURL,
      "headline": pageTitle,
      "name": pageTitle,
      "description": pageDesc,
      "url": canonicalURL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "Ready Apologia",
        "url": `${siteUrl}${base}/`
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={schemaObj}
>
  <div class="stats-hub-container">
    <!-- Header -->
    <header class="stats-header">
      <div class="header-pretitle">
        <a href={`${base}/discover`} class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="back-icon">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          Discover
        </a>
      </div>
      <h1 class="stats-title">Scripture Statistics</h1>
      <p class="stats-subtitle">Data-driven leaderboards pointing you to the most critical, heavily attested, defended, and commented-on verses.</p>
    </header>

    <!-- Corpus Segmented Switcher -->
    <div class="corpus-switch-container">
      <div class="corpus-segmented-pill" role="tablist">
        <button
          type="button"
          class="corpus-tab-btn is-active christian-tab"
          data-target="corpus-bible"
          role="tab"
          aria-selected="true"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-icon">
            <path d="M12 3v18M7 8h10"/>
          </svg>
          <span>Bible Analytics</span>
        </button>

        <button
          type="button"
          class="corpus-tab-btn islam-tab"
          data-target="corpus-quran"
          role="tab"
          aria-selected="false"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="tab-icon">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>Quran Analytics</span>
        </button>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- BIBLE STATISTICS PANEL                                                    -->
    <!-- ========================================================================= -->
    <div id="corpus-bible" class="corpus-panel bible-theme is-active">
      <!-- Fast Filter Chips -->
      <nav class="quick-filter-nav" aria-label="Bible leaderboards navigation">
        <button type="button" class="filter-chip is-active" data-section="bible-videos">Top Videos</button>
        <button type="button" class="filter-chip" data-section="bible-defended">Most Defended</button>
        <button type="button" class="filter-chip" data-section="bible-patristics">Patristics Apologetics</button>
        <button type="button" class="filter-chip" data-section="bible-contradictions">Contradictions</button>
        <button type="button" class="filter-chip" data-section="bible-manuscripts">Manuscript Density</button>
        <button type="button" class="filter-chip" data-section="bible-oldest">Oldest Manuscripts</button>
      </nav>

      <!-- 1. Top 10 Most Discussed in Videos -->
      <section id="bible-videos" class="leaderboard-section">
        <div class="section-badge-header">
          <span class="section-icon-badge">🎬</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Most Discussed Verses in Videos</h2>
            <p class="section-caption">Bible verses featured across the highest number of apologist videos, short breakdowns, and theological debates.</p>
          </div>
        </div>

        <div class="cards-list">
          {bibleStats?.topVideos?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-video">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Watch Apologetics Videos</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 2. Top 10 Most Defended Verses -->
      <section id="bible-defended" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">🛡️</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Most Defended Bible Verses</h2>
            <p class="section-caption">Key Christological, Trinitarian, and theological battleground verses with the most dedicated apologetic exegeses.</p>
          </div>
        </div>

        <div class="cards-list">
          {bibleStats?.topDefended?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-apologetics">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Read Theological Defenses</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Top 10 Verses with Patristics Apologetics -->
      <section id="bible-patristics" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">🏛️</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Verses with Patristics Apologetics</h2>
            <p class="section-caption">Verses most frequently defended and expounded by the Early Church Fathers (Athanasius, John Chrysostom, Cyril of Alexandria, Gregory the Theologian).</p>
          </div>
        </div>

        <div class="cards-list">
          {bibleStats?.topPatristics?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-patristics">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Explore Patristic Exegesis</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Top 10 Most Alleged Contradictions -->
      <section id="bible-contradictions" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">⚖️</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Most Alleged Bible Contradictions</h2>
            <p class="section-caption">Verses most heavily cited in alleged biblical discrepancy pairings, accompanied by harmonization exegeses.</p>
          </div>
        </div>

        <div class="cards-list">
          {bibleStats?.topContradictions?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-contradictions">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>View Harmonization Answers</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. Top 10 Individual Verses by Ancient Manuscripts -->
      <section id="bible-manuscripts" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">📜</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Verses by Ancient Manuscript Density</h2>
            <p class="section-caption">Individual verses with the highest number of surviving physical ancient Greek and Hebrew manuscript witnesses.</p>
          </div>
        </div>

        <div class="cards-list">
          {bibleStats?.topManuscriptVerses?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-manuscripts">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>View Manuscript Scans</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. Oldest Ancient Biblical Manuscripts -->
      <section id="bible-oldest" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">🏺</span>
          <div class="section-text-group">
            <h2 class="section-heading">Oldest Ancient Biblical Manuscripts</h2>
            <p class="section-caption">The earliest surviving physical manuscript artifacts in the Ready Apologia catalog, linked to their first attested verse.</p>
          </div>
        </div>

        <div class="cards-list">
          {bibleStats?.oldestManuscripts?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.name}</a>
                </div>
                <span class="metric-pill pill-date">{item.date}</span>
              </div>

              <div class="ms-meta-details">
                <span class="ms-corpus-tag">{item.testament}</span>
                <span class="ms-first-verse-tag">First Verse: <strong>{item.firstVerseTitle}</strong></span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Inspect Manuscript at {item.firstVerseTitle}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- ========================================================================= -->
    <!-- QURAN STATISTICS PANEL                                                    -->
    <!-- ========================================================================= -->
    <div id="corpus-quran" class="corpus-panel quran-theme">
      <!-- Fast Filter Chips -->
      <nav class="quick-filter-nav" aria-label="Quran leaderboards navigation">
        <button type="button" class="filter-chip is-active" data-section="quran-videos">Top Videos</button>
        <button type="button" class="filter-chip" data-section="quran-tabari">Longest Tabari</button>
        <button type="button" class="filter-chip" data-section="quran-kathir">Longest Ibn Kathir</button>
        <button type="button" class="filter-chip" data-section="quran-footnotes">Christian Footnotes</button>
        <button type="button" class="filter-chip" data-section="quran-labels">Most Labels</button>
        <button type="button" class="filter-chip" data-section="quran-manuscripts">Manuscript Density</button>
        <button type="button" class="filter-chip" data-section="quran-mistakes">Manuscript Alterations</button>
      </nav>

      <!-- 1. Top 10 Most Examined in Videos -->
      <section id="quran-videos" class="leaderboard-section">
        <div class="section-badge-header">
          <span class="section-icon-badge">🎬</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Most Examined Quran Verses in Videos</h2>
            <p class="section-caption">Quranic verses most frequently critiqued, analyzed, and refuted across apologetic video breakdowns.</p>
          </div>
        </div>

        <div class="cards-list">
          {quranStats?.topVideos?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-video">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Watch Apologetics Videos</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 2. Top 10 Longest Commentaries by Tafsir al-Tabari -->
      <section id="quran-tabari" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">📚</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Longest Commentaries by Tafsir al-Tabari</h2>
            <p class="section-caption">Verses where the foundational Islamic commentator Imam al-Tabari wrote monumental, multi-thousand-word treatises trying to harmonize difficult passages.</p>
          </div>
        </div>

        <div class="cards-list">
          {quranStats?.topTabari?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-tafsir">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Read Full Tabari Exegesis</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 3. Top 10 Longest Commentaries by Tafsir Ibn Kathir -->
      <section id="quran-kathir" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">📖</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Longest Commentaries by Tafsir Ibn Kathir</h2>
            <p class="section-caption">The longest commentaries by Ibn Kathir, containing comprehensive chains of Hadith narrations on miraculous and legal claims.</p>
          </div>
        </div>

        <div class="cards-list">
          {quranStats?.topKathir?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-tafsir">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Read Full Ibn Kathir Exegesis</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. Top 10 Longest Christian Scholarly Footnotes -->
      <section id="quran-footnotes" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">📝</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Longest Christian Scholarly Footnotes</h2>
            <p class="section-caption">Quranic passages with the most extensive critical annotations by Christian scholars (Dr. Gordon Nickel, Dr. Daniel A. Brubaker, David Marshall).</p>
          </div>
        </div>

        <div class="cards-list">
          {quranStats?.topFootnotes?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-footnote">{item.metricValue}</span>
              </div>

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              {item.preview && (
                <p class="footnote-preview-text">{item.preview.slice(0, 160)}...</p>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Read Scholarly Footnotes</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 5. Top Verses with Most Critical Deficiency Labels -->
      <section id="quran-labels" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">⚠️</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top Quran Verses with Most Critical Labels</h2>
            <p class="section-caption">Verses identified with multiple theological, historical, or moral defects (Slavery & Concubinage, Devaluing Women, Theological Defects, Contradicting the Bible).</p>
          </div>
        </div>

        <div class="cards-list">
          {quranStats?.topLabels?.map((item) => (
            <div class="leaderboard-card">
              <div class="card-top-row">
                <div class="rank-badge-wrapper">
                  <span class={`rank-badge ${item.rank <= 3 ? 'rank-top' : ''}`}>#{item.rank}</span>
                  <a href={`${base}${item.url}`} class="verse-link-title">{item.title}</a>
                </div>
                <span class="metric-pill pill-critical">{item.metricValue}</span>
              </div>

              {item.labels && (
                <div class="labels-tag-cloud">
                  {item.labels.map((lbl) => (
                    <span class="critical-tag-badge">{lbl}</span>
                  ))}
                </div>
              )}

              {item.text && (
                <blockquote class="verse-quote-box">
                  "{item.text}"
                </blockquote>
              )}

              <div class="card-footer-action">
                <a href={`${base}${item.url}`} class="action-btn">
                  <span>Inspect Deficiencies & Citations</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 6. Top 10 Quran Verses by Manuscript Density -->
      <section id="quran-manuscripts" class="leaderboard-section" style="display: none;">
        <div class="section-badge-header">
          <span class="section-icon-badge">📜</span>
          <div class="section-text-group">
            <h2 class="section-heading">Top 10 Quran Verses by Manuscript Density</h2>
            <p class="section-caption">Verses with the highest count of physical early Quranic codices and folios indexed across world libraries.</p>
          </div>
        </div>

        <div class="cards-list">
          {quranStats?.topManuscriptVerses?.map((item) => (
