<script>
  let isHashListenerAttached = false;

  function setupStatisticsTabs() {
    const segmentedControls = document.querySelector('.corpus-segmented-pill');
    const panels = document.querySelectorAll('.corpus-panel');
    if (!panels.length) return;

    function activateSection(panel, sectionId, updateHash = true) {
      if (!panel) return;
      const chips = panel.querySelectorAll('.filter-chip');
      const sections = panel.querySelectorAll('.leaderboard-section');

      let targetSection = sectionId ? panel.querySelector(`#${sectionId}`) : null;
      if (!targetSection && sections.length > 0) {
        targetSection = sections[0];
        sectionId = targetSection.id;
      }

      chips.forEach(chip => {
        const isMatch = chip.getAttribute('data-section') === sectionId;
        if (isMatch) {
          chip.classList.add('is-active');
          chip.setAttribute('aria-selected', 'true');
        } else {
          chip.classList.remove('is-active');
          chip.setAttribute('aria-selected', 'false');
        }
      });

      sections.forEach(sec => {
        if (sec.id === sectionId) {
          sec.style.display = 'flex';
        } else {
          sec.style.display = 'none';
        }
      });

      if (updateHash && typeof window !== 'undefined' && sectionId) {
        window.history.replaceState(null, '', `#${sectionId}`);
      }
    }

    function activateTab(targetId, targetSectionId = null, updateHash = true) {
      const buttons = segmentedControls ? segmentedControls.querySelectorAll('.corpus-tab-btn') : [];
      buttons.forEach(b => {
        const isTarget = b.getAttribute('data-target') === targetId;
        if (isTarget) {
          b.classList.add('is-active');
          b.setAttribute('aria-selected', 'true');
        } else {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        }
      });

      panels.forEach(p => {
        if (p.id === targetId) {
          p.classList.add('is-active');
          const activeChip = p.querySelector('.filter-chip.is-active');
          const secId = targetSectionId || (activeChip ? activeChip.getAttribute('data-section') : null);
          activateSection(p, secId, updateHash);
        } else {
          p.classList.remove('is-active');
        }
      });

      if (updateHash && !targetSectionId && typeof window !== 'undefined') {
        const hash = targetId === 'corpus-quran' ? 'quran' : 'bible';
        window.history.replaceState(null, '', `#${hash}`);
      }
    }

    // Attach click listeners with dataset initialization flags to prevent duplicate listeners
    panels.forEach(panel => {
      const filterNav = panel.querySelector('.quick-filter-nav');
      if (filterNav && filterNav.dataset.initialized !== 'true') {
        filterNav.dataset.initialized = 'true';
        filterNav.addEventListener('click', (e) => {
          const chip = e.target.closest('.filter-chip');
          if (!chip) return;
          const sectionId = chip.getAttribute('data-section');
          if (sectionId) {
            activateSection(panel, sectionId, true);
          }
        });
      }
    });

    if (segmentedControls && segmentedControls.dataset.initialized !== 'true') {
      segmentedControls.dataset.initialized = 'true';
      segmentedControls.addEventListener('click', (e) => {
        const btn = e.target.closest('.corpus-tab-btn');
        if (!btn) return;
        const targetId = btn.getAttribute('data-target');
        activateTab(targetId, null, true);
      });
    }

    function syncFromUrlHash() {
      if (typeof window === 'undefined' || !window.location.hash) return;
      const rawHash = window.location.hash.slice(1).toLowerCase();
      if (!rawHash) return;

      if (rawHash === 'quran') {
        activateTab('corpus-quran', null, false);
      } else if (rawHash === 'bible') {
        activateTab('corpus-bible', null, false);
      } else if (rawHash.startsWith('quran-')) {
        activateTab('corpus-quran', rawHash, false);
      } else if (rawHash.startsWith('bible-')) {
        activateTab('corpus-bible', rawHash, false);
      }
    }

    // Initial sync
    syncFromUrlHash();

    // Attach single persistent hashchange listener
    if (!isHashListenerAttached && typeof window !== 'undefined') {
      window.addEventListener('hashchange', syncFromUrlHash);
      isHashListenerAttached = true;
    }
  }

  setupStatisticsTabs();
  document.addEventListener('astro:page-load', setupStatisticsTabs);
  document.addEventListener('astro:after-swap', setupStatisticsTabs);
</script>

