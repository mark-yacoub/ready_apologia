---
/**
 * How was the Qurʾān preserved? One static page (no React islands), stateless.
 * Intro → Start here (item 1, rendered once) → 5 reader-question sections of self-contained,
 * anchored items → "Check the sources" → a separated, collapsed Christian reflection → "What others
 * are saying". Everything comes from loadQuranPreservation() (dataset + config copy overrides).
 * Old `#stage-N` links land on the element that now carries that content (LEGACY_ANCHORS).
 */
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import SourcesList from '../../components/discover/hadith-reliability/SourcesList.astro';
import FurtherReading from '../../components/discover/hadith-reliability/FurtherReading.astro';
import Item from '../../components/discover/quran-preservation/Item.astro';
import { loadQuranPreservation } from '../../utils/quranPreservation/loader.js';
import { BASE, BASE_PATH, LABELS, OG_IMAGE } from '../../utils/quranPreservation/config.js';
import { pageSchema } from '../../utils/quranPreservation/schema.js';
import { tl } from '../../utils/hadithReliability/render.js';
import AudioButton from '../../components/audio/AudioButton.astro';
import '../../styles/hadith-reliability.css';
import '../../styles/quran-preservation.css';

const m = loadQuranPreservation();
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
// BASE_PATH already includes the site base.
const canonicalURL = `${site}${BASE_PATH}`;
const ogImage = `${site}${OG_IMAGE}`;
const pad = n => String(n).padStart(2, '0');
---
<Layout
  title={m.seo.title}
  description={m.seo.description}
  keywords={m.seo.keywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  schema={pageSchema({ site, model: m, image: ogImage })}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: 'quran-preservation' }} />
  <div class="hrv qp" data-qp>
    <nav class="hrv-bar qp-bar" aria-label="Article navigation">
      <a class="hrv-bar__back" href={`${BASE}/discover`}><Icon name="chevronLeft" /><span class="hrv-bar__backtext">{LABELS.back}</span></a>
      <details class="qp-index" data-qp-index>
        <summary class="qp-index__sum">{LABELS.onThisPage} · {m.counts.items}<Icon name="chevronDown" /></summary>
        <div class="qp-index__panel">
          <ol class="qp-index__groups">
            {m.index.map(g => (
              <li>
                <p class="qp-index__q">
                  {g.number && <span class="qp-index__qn">{pad(g.number)}</span>}
                  {g.id ? <a href={`#${g.id}`}><span set:html={g.questionHtml} /></a> : <span set:html={g.questionHtml} />}
                </p>
                <ol class="qp-index__items">
                  {g.items.map(i => (
                    <li><a href={`#${i.id}`}><span class="qp-index__n">{i.number}</span><span set:html={tl(i.title)} /></a></li>
                  ))}
                </ol>
              </li>
            ))}
            <li class="qp-index__tail">
              <a href="#check-sources">{LABELS.checkSources}</a>
            </li>
          </ol>
        </div>
      </details>
      <div class="hrv-bar__actions">
        <AudioButton><button class="hrv-iconbtn" type="button" data-hrv-copy aria-label={LABELS.copyLink} title={LABELS.copyLink}><Icon name="link" /></button></AudioButton>
      </div>
    </nav>
    <div class="hrv-toast" role="status" aria-live="polite" data-hrv-toast>{LABELS.copied}</div>

    <div class="hrv-wrap">
      <header class="hrv-hero qp-hero" id="intro">
        {m.intro.legacy.map(a => <span id={a} class="qp-legacy" aria-hidden="true" />)}
        <h1 class="hrv-h1" set:html={m.intro.h1Html} />
        <p class="hrv-intro" set:html={m.intro.html} />
      </header>

      {m.startHere && <Item it={m.startHere} />}

      {m.sections.map(s => (
        <section class="hrv-q qp-q" id={s.id} aria-labelledby={`${s.id}-h`}>
          {s.legacy.map(a => <span id={a} class="qp-legacy" aria-hidden="true" />)}
          <div class="hrv-q__head">
            <span class="hrv-q__num" aria-hidden="true">{pad(s.number)}</span>
            <h2 class="hrv-q__title" id={`${s.id}-h`} set:html={s.questionHtml} />
          </div>
          {s.dekHtml && <p class="qp-dek" set:html={s.dekHtml} />}
          {s.backToStart && (
            <a class="qp-backlink" href={`#${s.backToStart.id}`}><span aria-hidden="true">↑</span><span set:html={tl(LABELS.backToStart.replace('{title}', s.backToStart.title))} /></a>
          )}
          {s.items.map(it => <Item it={it} />)}
        </section>
      ))}

      {m.summary && (
        <section class="hrv-sec qp-summary" id={m.summary.id} aria-labelledby={`${m.summary.id}-h`}>
          <h2 class="hrv-eyebrow" id={`${m.summary.id}-h`} set:html={m.summary.titleHtml} />
          <div class="qp-primer__body" set:html={m.summary.html} />
        </section>
      )}

      <section class="hrv-sec qp-sources" id="check-sources" aria-labelledby="check-sources-h">
        <h2 class="hrv-eyebrow" id="check-sources-h">{LABELS.checkSources}</h2>
        <p class="hrv-further-note">{LABELS.checkIntro}</p>
        <SourcesList groups={m.sourceGroups} />
      </section>

      <section class="hrv-sec qp-closing" id={m.closing.id} aria-label={m.closing.reflectionTitle}>
        {m.closing.legacy.map(a => <span id={a} class="qp-legacy" aria-hidden="true" />)}
        <p class="qp-disclosure" set:html={m.closing.disclosureHtml} />
        <details class="hrv-disclosure qp-reflection">
          <summary><span set:html={m.closing.reflectionTitleHtml} /><Icon name="chevronDown" /></summary>
          <div class="hrv-disclosure__body qp-reflection__body" set:html={m.closing.reflectionHtml} />
        </details>
        {m.closing.crossPointer && (
          <a class="qp-cross" href={m.closing.crossPointer.href}><span set:html={m.closing.crossPointer.html} /><Icon name="arrowRight" /></a>
        )}
      </section>

      {m.closing.perspective.length > 0 && (
        <section class="hrv-sec hrv-sec--others" id="others" aria-label={LABELS.othersSaying}>
          <FurtherReading items={m.closing.perspective} kind="perspective" title={LABELS.othersSaying} note={m.closing.perspectiveNote} />
        </section>
      )}
    </div>
  </div>
  <script src="../../components/discover/hadith-reliability/client.js"></script>
  <script src="../../components/discover/quran-preservation/client.js"></script>
</Layout>
