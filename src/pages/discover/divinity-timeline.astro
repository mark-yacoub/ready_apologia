---
/**
 * `/discover/divinity-timeline` — Static `.hrv.dtl` scholarly reference dossier.
 *
 * Replaces the legacy Leaflet/KaTeX/Marked/DOMPurify interactive timeline with a
 * zero-CDN, stateless editorial article examining pre-Nicene inscriptions,
 * mosaics, Roman and pagan witnesses, first-century Aramaic/Greek creedal
 * formulas, and second- and third-century papyri before AD 325.
 *
 * Preserves all 42 `#event-<id>` anchors uniquely in the rendered HTML.
 */
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import SectionNav from '../../components/discover/divinity-timeline/SectionNav.astro';
import TimelineShowcase from '../../components/discover/divinity-timeline/TimelineShowcase.astro';
import GlanceRows from '../../components/discover/divinity-timeline/GlanceRows.astro';
import SectionHead from '../../components/discover/divinity-timeline/SectionHead.astro';
import ArtifactCard from '../../components/discover/divinity-timeline/ArtifactCard.astro';
import HistoriographicalPair from '../../components/discover/divinity-timeline/HistoriographicalPair.astro';
import ExcludedItemsDisclosure from '../../components/discover/divinity-timeline/ExcludedItemsDisclosure.astro';
import SourcesBlock from '../../components/discover/divinity-timeline/SourcesBlock.astro';
import { BASE, discoverHref } from '../../utils/divinityTimeline/config.js';
import { buildDivinityTimelinePage } from '../../utils/divinityTimeline/model.js';
import {
  buildBreadcrumbSchema,
  DEFAULT_LOGO_URL,
  SITE_NAME,
} from '../../utils/seoFactory.js';

import '../../styles/hadith-reliability.css';
import '../../styles/divinity-timeline.css';

const page = buildDivinityTimelinePage();
const site = Astro.site
  ? Astro.site.toString().replace(/\/$/, '')
  : 'https://readyapologia.com';
const canonicalURL = `${site}${page.path}`;
const ogImage = `${site}${page.ogImage}`;

const [, articleNode] = page.jsonLd;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumbSchema([
      { name: 'Ready Apologia', url: `${site}${BASE}/` },
      { name: 'Discover', url: `${site}${BASE}/discover` },
      { name: page.meta.breadcrumbLabel, url: canonicalURL },
    ]),
    {
      ...articleNode,
      '@context': undefined,
      '@id': `${canonicalURL}#article`,
      url: canonicalURL,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      image: [ogImage],
      author: { '@type': 'Organization', name: SITE_NAME, url: site },
      publisher: {
        '@type': 'Organization',
        name: SITE_NAME,
        logo: { '@type': 'ImageObject', url: DEFAULT_LOGO_URL },
      },
    },
  ],
};
---
<Layout
  title={page.meta.metaTitle}
  description={page.meta.description}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  showOnboarding={false}
>
  <RouteAnalytics
    eventName="discover_article_view"
    params={{ article_slug: page.slug }}
  />
  <article class="hrv dtl" id="top">
    <SectionNav chips={page.navChips} canonicalUrl={canonicalURL} backHref={discoverHref()} />
    <div class="hrv-wrap">
      <header class="hrv-case-head dtl-head">
        <p class="hrv-eyebrow">{page.meta.eyebrow}</p>
        <h1 class="hrv-case-h1 dtl-h1">{page.meta.h1}</h1>
        <div class="dtl-intro">
          {page.introParagraphs.map((pHtml) => (
            <p set:html={pHtml} />
          ))}
        </div>
        <a
          class="dtl-head__context"
          href="#methodology-and-scope"
          title="View dating methodology, composition vs. copy dates, and excluded artifacts"
        >
          <span>
            Methodology: Stratigraphic sealing, paleographical hand ranges &amp; AD 325 cutoff
          </span>
          <Icon name="chevronRight" />
        </a>
      </header>

      <aside class="dtl-framing" aria-labelledby="dtl-framing-h">
        <p class="hrv-eyebrow dtl-framing__eyebrow">{page.framing.eyebrow}</p>
        <h2 class="dtl-framing__h" id="dtl-framing-h">{page.framing.heading}</h2>
        <p class="dtl-framing__p" set:html={page.framing.hypothesesHtml} />
        <p class="hrv-eyebrow dtl-framing__subh">{page.framing.tiersHeading}</p>
        <ul class="dtl-framing__tiers">
          {page.framing.tiers.map((t) => (
            <li class="dtl-framing__tier">
              <span class={`dtl-card__tier dtl-card__tier--${t.tier}`}>
                {t.badge}
              </span>
              <span class="dtl-framing__tierbody" set:html={t.bodyHtml} />
            </li>
          ))}
        </ul>
      </aside>

      <TimelineShowcase showcase={page.timelineShowcase} />

      <GlanceRows rows={page.glanceRows} />

      {page.sections.map((sec) => (
        <section
          class="hrv-sec dtl-sec"
          id={sec.id}
          aria-labelledby={`${sec.id}-h`}
        >
          <SectionHead
            num={sec.num}
            eyebrow={sec.eyebrow}
            title={sec.title}
            leadHtml={sec.leadHtml}
            headingId={`${sec.id}-h`}
          />

          <div class="dtl-cards">
            {sec.cards.map((card) => (
              <ArtifactCard card={card} />
            ))}
          </div>

          <HistoriographicalPair historiography={sec.historiography} />
        </section>
      ))}

      <section
        class="hrv-sec dtl-sec dtl-sec--method"
        id={page.methodology.id}
        aria-labelledby={`${page.methodology.id}-h`}
      >
        <SectionHead
          eyebrow={page.methodology.eyebrow}
          title={page.methodology.title}
          leadHtml={page.methodology.leadHtml}
          headingId={`${page.methodology.id}-h`}
        />

        <div class="dtl-principles">
          {page.methodology.principles.map((p) => (
            <div class="dtl-principle">
              <h3 class="dtl-principle__h">{p.title}</h3>
              <p class="dtl-principle__p" set:html={p.bodyHtml} />
            </div>
          ))}
        </div>

        <ExcludedItemsDisclosure
          disclosure={page.methodology.excludedDisclosure}
        />
      </section>

      <SourcesBlock groups={page.sourcesGroups} />
    </div>
  </article>

  <script>
    import '../../components/discover/divinity-timeline/client.js';
  </script>
</Layout>
