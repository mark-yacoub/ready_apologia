---
/**
 * Hub of "Muhammad and slavery": short intro → Start here (Qurʾān 4:24 with its full witnesses
 * showcase) → browse by source (3 cards) → reader-question sections whose rows link into item
 * anchors on the 3 sub-pages; each section ends with a closed <details> listing every remaining
 * item, so every item is one tap away → sources footer (computed counts).
 * Stateless by design: the reader is assumed to visit once, for the first time.
 */
import AudioListen from '../../../components/audio/AudioListen.astro';
import Layout from '../../../layouts/Layout.astro';
import RouteAnalytics from '../../../components/common/RouteAnalytics.astro';
import Icon from '../../../components/discover/hadith-reliability/Icon.astro';
import Showcase from '../../../components/discover/hadith-reliability/showcase/Showcase.astro';
import CaseRow from '../../../components/discover/hadith-reliability/CaseRow.astro';
import { loadMuhammadSlavery } from '../../../utils/muhammadSlavery/loader.js';
import { ANALYTICS, ANALYTICS_EVENT, BASE, LABELS, OG_IMAGE, PAGE_PATHS } from '../../../utils/muhammadSlavery/config.js';
import { hubSchema } from '../../../utils/muhammadSlavery/schema.js';
import { tl } from '../../../utils/hadithReliability/render.js';
import '../../../styles/hadith-reliability.css';
import '../../../styles/muhammad-slavery.css';

const model = loadMuhammadSlavery();
const { hub } = model;
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
// PAGE_PATHS already include the site base.
const canonicalURL = `${site}${PAGE_PATHS.hub}`;
const ogImage = `${site}${OG_IMAGE}`;
const pad = n => String(n).padStart(2, '0');
const asCase = r => ({ href: r.href, archetype: r.archetype, shortTitle: r.title, badges: r.badges });
const start = hub.startHere;
---
<Layout
  title={hub.seo.title}
  description={hub.seo.description}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  keywords=""
  schema={hubSchema({ site, model, image: ogImage })}
  showOnboarding={false}
>
  <RouteAnalytics eventName={ANALYTICS_EVENT} params={ANALYTICS.hub} />
  <div class="hrv ms ms--hub" data-ms>
    <div class="hrv-wrap">
      <header class="hrv-hero">
        <a class="hrv-crumb" href={`${BASE}/discover`}><Icon name="chevronLeft" />{LABELS.back}</a>
        <h1 class="hrv-h1" set:html={tl(hub.h1)} />
        <AudioListen />
        <p class="hrv-intro" set:html={hub.introHtml} />
      </header>

      {start && (
        <>
          <h2 class="hrv-eyebrow hrv-eyebrow--verify hrv-section-label">{LABELS.startHere}</h2>
          <div class="hrv-start ms-start">
            <p class="hrv-start__title" set:html={tl(start.title)} />
            {start.hookHtml && <p class="hrv-hook ms-start__hook" set:html={start.hookHtml} />}
            {start.showcase && <Showcase sc={start.showcase} id="sc-start" label={start.showcase.caption} level={3} />}
            {start.showcase?.quotesTabari && <p class="ms-tnote" set:html={tl(LABELS.tabariTranslationNote)} />}
            {start.testHtml && (
              <div class="hrv-eval ms-block ms-start__test">
                <h3 class="hrv-eval__h"><Icon name="search" />{start.testLabel}</h3>
                <div set:html={start.testHtml} />
              </div>
            )}
            <a class="hrv-start__cta ms-start__cta" href={start.item.href}>{LABELS.openStart}<Icon name="arrowRight" /></a>
          </div>
        </>
      )}

      <h2 class="hrv-eyebrow hrv-section-label" set:html={tl(hub.browseLabel)} />
      <ul class="ms-browse">
        {hub.browse.map(b => (
          <li><a class="ms-browse__card" href={b.href} data-astro-prefetch="hover">
            <span class="ms-browse__title" set:html={tl(b.title)} />
            <span class="ms-browse__text" set:html={tl(b.text)} />
            {b.descriptionHtml && <span class="ms-browse__desc" set:html={b.descriptionHtml} />}
            <Icon name="chevronRight" />
          </a></li>
        ))}
      </ul>

      {hub.sections.map(s => (
        <section class="hrv-q ms-hubq" id={s.id} aria-labelledby={`${s.id}-h`}>
          <div class="hrv-q__head">
            <span class="hrv-q__num" aria-hidden="true">{pad(s.number)}</span>
            <h2 class="hrv-q__title" id={`${s.id}-h`} set:html={s.questionHtml} />
          </div>
          {s.dekHtml && <p class="ms-dek" set:html={s.dekHtml} />}
          <ul class="hrv-rows">
            {s.rows.map(r => <li data-archetype={r.archetype}><CaseRow c={asCase(r)} /></li>)}
          </ul>
          {s.more.length > 0 && (
            <details class="ms-more">
              <summary><span set:html={tl(s.moreLabel)} /><Icon name="chevronDown" /></summary>
              <ul class="hrv-rows">
                {s.more.map(r => <li data-archetype={r.archetype}><CaseRow c={asCase(r)} /></li>)}
              </ul>
            </details>
          )}
        </section>
      ))}

      <footer class="hrv-hub-foot">
        <span set:html={tl(hub.sourcesLabel)} />
        <ul>{hub.sourceStats.map(s => <li><b>{s.count}</b> <span set:html={tl(s.label)} /></li>)}</ul>
      </footer>
    </div>
  </div>
  <script src="../../../components/discover/hadith-reliability/client.js"></script>
  <script src="../../../components/discover/muhammad-slavery/client.js"></script>
</Layout>
