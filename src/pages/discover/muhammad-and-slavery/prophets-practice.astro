---
import Layout from '../../../layouts/Layout.astro';
import RouteAnalytics from '../../../components/common/RouteAnalytics.astro';
import HadithPillarView from '../../../components/discover/slavery/HadithPillarView.jsx';
import PillarFooterNav from '../../../components/discover/slavery/PillarFooterNav.astro';
import slaveryData from '../../../data/discover/islam/prophet/slavery.json';

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const hadithCategories = (slaveryData.categories || slaveryData.hadith_categories || []).filter(c => c.items && c.items.some(i => i.hadiths && i.hadiths.length > 0));
const totalHadiths = hadithCategories.reduce((acc, cat) => acc + cat.items.reduce((iAcc, item) => iAcc + (item.hadiths ? item.hadiths.length : 0), 0), 0);

const pageTitle = `Prophet's Practice: ${totalHadiths} Hadiths on Muhammad & Slavery | Ready Apologia`;
const pageDesc = `${totalHadiths} verified hadiths from Sahih al-Bukhari and Sahih Muslim documenting Muhammad's personal slave ownership, commercial trading, auctions, Milk al-Yamin, and legal chattel codification.`;
const pageKeywords = "muhammad slaves hadith, sahih bukhari slavery, sahih muslim slavery, anjasha black slave bukhari, midam slave bukhari, slave trade hadith, milk al yamin bukhari, azl captives hadith";
const ogImage = "/media/slavery/cover.jpg";

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/discover/muhammad-and-slavery/prophets-practice`;

const schemaObj = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Ready Apologia", "item": `${siteUrl}${base}/` },
        { "@type": "ListItem", "position": 2, "name": "Discover", "item": `${siteUrl}${base}/discover` },
        { "@type": "ListItem", "position": 3, "name": "Islamics · The Prophet", "item": `${siteUrl}${base}/discover#panel-islamics` },
        { "@type": "ListItem", "position": 4, "name": "Muhammad & Slavery", "item": `${siteUrl}${base}/discover/muhammad-and-slavery` },
        { "@type": "ListItem", "position": 5, "name": "Prophet's Practice", "item": canonicalURL }
      ]
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  ogImage={ogImage}
  ogType="article"
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={schemaObj}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: 'muhammad-and-slavery-prophets-practice' }} />

  <div class="slavery-subpage-wrapper">
    {/* Breadcrumb Navigation */}
    <nav class="breadcrumb-header" aria-label="Breadcrumb">
      <a href={`${base}/discover/muhammad-and-slavery`} class="back-link" aria-label="Go back to Slavery Overview">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        <span>Slavery Hub</span>
      </a>
      <span class="breadcrumb-sep" aria-hidden="true">/</span>
      <span class="breadcrumb-current">Prophet's Practice</span>
    </nav>

    {/* Header Hero */}
    <header class="subpage-hero">
      <h1 class="subpage-title">
        Prophet's Direct Involvement & Practice in Slavery
      </h1>
    </header>

    {/* Interactive Hadith Categories Island */}
    <main class="subpage-content" aria-label="Hadith Evidence">
      <HadithPillarView categories={hadithCategories} client:load />
    </main>

    {/* Footer Navigation */}
    <PillarFooterNav currentPart="prophets-practice" base={base} />
  </div>
</Layout>

<style>
  .slavery-subpage-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 16px 10px 60px;
    font-family: var(--font-body, 'Public Sans', -apple-system, sans-serif);
    color: var(--color-on-surface, #09090b);
  }

  @media (min-width: 640px) {
    .slavery-subpage-wrapper {
      padding: 28px 20px 80px;
    }
  }

  @media (min-width: 768px) {
    .slavery-subpage-wrapper {
      padding: 36px 24px 96px;
    }
  }

  /* Breadcrumb */
  .breadcrumb-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    margin-bottom: 20px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-on-surface-variant, #71717a);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-primary, #09090b);
  }

  .breadcrumb-sep {
    color: var(--color-outline-variant, #d4d4d8);
  }

  .breadcrumb-current {
    color: var(--color-on-surface-variant, #71717a);
    font-weight: 500;
  }

  /* Hero */
  .subpage-hero {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 28px;
  }

  .subpage-title {
    font-family: var(--font-display, 'Literata', Georgia, serif);
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-on-surface, #09090b);
    margin: 0 0 12px 0;
  }

  .subpage-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.12rem);
    font-weight: 400;
    color: var(--color-on-surface-variant, #52525b);
    line-height: 1.55;
    margin: 0 0 14px 0;
  }

  .subpage-note {
    font-size: 12px;
    color: #71717a;
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto;
    font-style: italic;
  }

  .subpage-content {
    display: flex;
    flex-direction: column;
  }
</style>
