---
/**
 * From Mecca to Medina. One static page (no React islands), stateless.
 * Intro → Start here (item 1, rendered once) → reader-question sections of self-contained, anchored
 * items → "How Muslims read these verses today" → "What the texts show" → "Check the sources" → a
 * disclosed, collapsed Christian reflection → "What others are saying" (when configured).
 * Everything comes from loadMeccaToMedina() (read-only dataset + config copy overrides, checked at
 * build time). Old section hashes (#four-stages-of-warfare, …) land where that content lives now.
 */
import AudioButton from '../../components/audio/AudioButton.astro';
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import FurtherReading from '../../components/discover/hadith-reliability/FurtherReading.astro';
import Item from '../../components/discover/mecca-to-medina/Item.astro';
import Evidence from '../../components/discover/mecca-to-medina/Evidence.astro';
import Table from '../../components/discover/mecca-to-medina/Table.astro';
import Sources from '../../components/discover/mecca-to-medina/Sources.astro';
import { loadMeccaToMedina } from '../../utils/meccaToMedina/loader.js';
import { BASE, BASE_PATH, LABELS, OG_IMAGE, OG_IMAGE_SIZE } from '../../utils/meccaToMedina/config.js';
import { pageSchema } from '../../utils/meccaToMedina/schema.js';
import { tl } from '../../utils/hadithReliability/render.js';
import '../../styles/hadith-reliability.css';
import '../../styles/mecca-to-medina.css';

const m = loadMeccaToMedina();
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${site}${BASE_PATH}`;
const ogImage = `${site}${OG_IMAGE}`;
const pad = n => String(n).padStart(2, '0');
const { readToday, textsShow, reflection, perspective } = m.closing;
---
<Layout
  title={m.seo.title}
  description={m.seo.description}
  keywords={m.seo.keywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogImageWidth={OG_IMAGE_SIZE.width}
  ogImageHeight={OG_IMAGE_SIZE.height}
  ogType="article"
  schema={pageSchema({ site, model: m, image: ogImage })}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: 'from-mecca-to-medina' }} />
  <div class="hrv mm" data-mm>
    <nav class="hrv-bar mm-bar" aria-label="Article navigation">
      <a class="hrv-bar__back" href={`${BASE}/discover`}><Icon name="chevronLeft" /><span class="hrv-bar__backtext">{LABELS.back}</span></a>
      <details class="mm-index" data-mm-index>
        <summary class="mm-index__sum">{LABELS.onThisPage} · {m.counts.items}<Icon name="chevronDown" /></summary>
        <div class="mm-index__panel">
          <ol class="mm-index__groups">
            {m.index.map(g => (
              <li>
                <p class="mm-index__q">
                  {g.number && <span class="mm-index__qn">{pad(g.number)}<span class="hrv-sr">. </span></span>}
                  {g.id ? <a href={`#${g.id}`}><span set:html={g.questionHtml} /></a> : <span set:html={g.questionHtml} />}
                </p>
                <ol class="mm-index__items">
                  {g.items.map(i => (
                    <li><a href={`#${i.id}`}><span class="mm-index__n">{i.number}<span class="hrv-sr">. </span></span><span set:html={tl(i.title)} /></a></li>
                  ))}
                </ol>
              </li>
            ))}
            <li class="mm-index__tail">
              {readToday && <a href={`#${readToday.id}`}><span set:html={readToday.titleHtml} /></a>}
              {textsShow && <a href={`#${textsShow.id}`}><span set:html={textsShow.titleHtml} /></a>}
              <a href="#check-sources"><span>{LABELS.checkSources}</span></a>
            </li>
          </ol>
        </div>
      </details>
      <div class="hrv-bar__actions">
        <AudioButton><button class="hrv-iconbtn" type="button" data-hrv-copy aria-label={LABELS.copyLink} title={LABELS.copyLink}><Icon name="link" /></button></AudioButton>
      </div>
    </nav>
    <div class="hrv-toast" role="status" aria-live="polite" data-hrv-toast>{LABELS.copied}</div>

    <div class="hrv-wrap">
      <header class="hrv-hero mm-hero" id="intro">
        {m.intro.legacy.map(a => <span id={a} class="mm-legacy" aria-hidden="true" />)}
        <h1 class="hrv-h1 mm-h1" set:html={m.intro.h1Html} />
        <p class="hrv-intro" set:html={m.intro.html} />
        <dl class="mm-orient">
          {m.intro.orientation.map(o => (
            <div class="mm-orient__row"><dt set:html={o.label} /><dd set:html={o.html} /></div>
          ))}
        </dl>
        <p class="mm-suranote" set:html={m.intro.suraNote} />
      </header>

      {m.startHere && <Item it={m.startHere} />}

      {m.sections.map(s => (
        <section class="hrv-q mm-q" id={s.id} aria-labelledby={`${s.id}-h`}>
          {s.legacy.map(a => <span id={a} class="mm-legacy" aria-hidden="true" />)}
          <div class="hrv-q__head">
            <span class="hrv-q__num" aria-hidden="true">{pad(s.number)}</span>
            <h2 class="hrv-q__title" id={`${s.id}-h`} set:html={s.questionHtml} />
          </div>
          {s.dekHtml && <p class="mm-dek" set:html={s.dekHtml} />}
          {s.items.map(it => <Item it={it} />)}
        </section>
      ))}

      {readToday && (
        <section class="hrv-sec mm-closing mm-today" id={readToday.id} aria-labelledby={`${readToday.id}-h`}>
          {readToday.legacy.map(a => <span id={a} class="mm-legacy" aria-hidden="true" />)}
          <h2 class="mm-closing__h" id={`${readToday.id}-h`} set:html={readToday.titleHtml} />
          <div class="mm-cards">
            {readToday.cards.map(c => (
              <div class="mm-card">
                <h3 class="mm-card__who" set:html={c.whoHtml} />
                <p set:html={c.html} />
              </div>
            ))}
          </div>
          {readToday.outroHtml && <p class="mm-outro" set:html={readToday.outroHtml} />}
        </section>
      )}

      {textsShow && (
        <section class="hrv-sec mm-closing mm-show" id={textsShow.id} aria-labelledby={`${textsShow.id}-h`}>
          {textsShow.legacy.map(a => <span id={a} class="mm-legacy" aria-hidden="true" />)}
          <h2 class="mm-closing__h" id={`${textsShow.id}-h`} set:html={textsShow.titleHtml} />
          {textsShow.introHtml && <p class="mm-dek" set:html={textsShow.introHtml} />}
          <ol class="mm-show__list">
            {textsShow.rows.map(r => (
              <li><a href={`#${r.id}`}><span class="mm-index__n">{r.number}<span class="hrv-sr">. </span></span><span set:html={tl(r.text)} /></a></li>
            ))}
          </ol>
        </section>
      )}

      <section class="hrv-sec mm-sources" id="check-sources" aria-labelledby="check-sources-h">
        <h2 class="mm-closing__h" id="check-sources-h">{LABELS.checkSources}</h2>
        <p class="hrv-further-note">{LABELS.checkIntro}</p>
        <Sources groups={m.sourceGroups} />
      </section>

      {reflection && (
        <section class="hrv-sec mm-closing mm-reflection" id={reflection.id} aria-labelledby={`${reflection.id}-h`} data-mm-open={`${reflection.id}-body`}>
          {reflection.legacy.map(a => <span id={a} class="mm-legacy" aria-hidden="true" data-mm-open={`${reflection.id}-body`} />)}
          <p class="mm-disclosure" set:html={reflection.disclosureHtml} />
          <details class="hrv-disclosure mm-reflection__d" id={`${reflection.id}-body`}>
            <summary><h2 class="mm-reflection__h" id={`${reflection.id}-h`} set:html={reflection.titleHtml} /><Icon name="chevronDown" /></summary>
            <div class="hrv-disclosure__body mm-reflection__body">
              <Table t={reflection.table} level={3} />
              {reflection.noteHtml && <p class="mm-dek" set:html={reflection.noteHtml} />}
              {reflection.evidence.map((e, i) => (e.type === 'heading'
                ? <h3 class="mm-evgroup" set:html={e.html} />
                : <Evidence e={e} level={reflection.evidence.slice(0, i).some(x => x.type === 'heading') ? 4 : 3} />))}
            </div>
          </details>
        </section>
      )}

      {perspective.length > 0 && (
        <section class="hrv-sec hrv-sec--others" id="others" aria-label={LABELS.othersSaying}>
          <FurtherReading items={perspective} kind="perspective" />
        </section>
      )}
    </div>
  </div>
  <script src="../../components/discover/hadith-reliability/client.js"></script>
  <script src="../../components/discover/mecca-to-medina/client.js"></script>
</Layout>
