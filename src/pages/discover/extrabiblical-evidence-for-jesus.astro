---
/**
 * /discover/extrabiblical-evidence-for-jesus: sixteen non-Christian literary authors/compilations
 * and ten excavated first- and second-century inscriptions, ossuaries, and structures, with a
 * dedicated methodological appendix for corroborative early Christian texts and disputed documents.
 *
 * Built on the shared `.hrv` archive reading-room design system + `.hrv.ebj` scoped layer.
 * Static and stateless: zero React islands, `showOnboarding={false}`, zero storage, zero URL
 * rewriting on scroll, and 100% preservation of all 5 theme IDs and all 52 `#evidence-<id>` slugs.
 */
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import SectionNav from '../../components/discover/extrabiblical-evidence/SectionNav.astro';
import GlanceRows from '../../components/discover/extrabiblical-evidence/GlanceRows.astro';
import SectionHead from '../../components/discover/extrabiblical-evidence/SectionHead.astro';
import ConfrontationFrame from '../../components/discover/extrabiblical-evidence/ConfrontationFrame.astro';
import WitnessStrip from '../../components/discover/extrabiblical-evidence/WitnessStrip.astro';
import CardGroup from '../../components/discover/extrabiblical-evidence/CardGroup.astro';
import ClassicalPair from '../../components/discover/extrabiblical-evidence/ClassicalPair.astro';
import SourcesBlock from '../../components/discover/extrabiblical-evidence/SourcesBlock.astro';
import * as CONTENT from '../../utils/extrabiblicalEvidence/content.js';
import { loadExtrabiblicalEvidence } from '../../utils/extrabiblicalEvidence/model.js';
import {
  BASE,
  BASE_PATH,
  OG_IMAGE,
  SITE_URL,
  DATE_PUBLISHED,
  DATE_MODIFIED,
  GLANCE_ID,
  SOURCES_ID,
  CATALOG_SLUG,
  discoverHref,
} from '../../utils/extrabiblicalEvidence/config.js';
import { buildBreadcrumbSchema, SITE_NAME, DEFAULT_LOGO_URL } from '../../utils/seoFactory.js';
import { tl } from '../../utils/hadithReliability/render.js';
import '../../styles/hadith-reliability.css';
import '../../styles/extrabiblical-evidence.css';

const model = loadExtrabiblicalEvidence(CONTENT);
const { seo, header, heroWitnesses, labels, nav, glance, sections, sources, closing } = model;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : SITE_URL;
const canonicalURL = `${site}${BASE_PATH}`;
const ogImage = `${site}${OG_IMAGE}`;

// JSON-LD: BreadcrumbList (unique URLs — zero duplicate /discover) + Article (with citations).
// No FAQPage or ClaimReview.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumbSchema([
      { name: 'Ready Apologia', url: `${site}${BASE}/` },
      { name: 'Discover', url: `${site}${BASE}/discover` },
      { name: seo.title, url: canonicalURL },
    ]),
    {
      '@type': 'Article',
      '@id': `${canonicalURL}#article`,
      headline: seo.title,
      description: seo.description,
      url: canonicalURL,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      image: [ogImage],
      inLanguage: 'en',
      author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      publisher: {
        '@type': 'Organization',
        name: SITE_NAME,
        logo: { '@type': 'ImageObject', url: DEFAULT_LOGO_URL },
      },
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_MODIFIED,
      citation: model.citations.map(c => ({ '@type': 'CreativeWork', name: c.name, url: c.url })),
    },
  ],
};
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: CATALOG_SLUG }} />
  <article class="hrv ebj" id="top">
    <SectionNav nav={nav} labels={labels} backHref={discoverHref()} canonical={canonicalURL} />
    <div class="hrv-wrap">
      <header class="hrv-case-head ebj-head">
        <p class="hrv-eyebrow" set:html={tl(header.eyebrow)} />
        <h1 class="hrv-case-h1 ebj-h1" set:html={header.h1Html} />
        <p class="hrv-hook ebj-hook" set:html={header.hookHtml} />
        <a class="ebj-head__context" href={`#${SOURCES_ID}`} title={header.contextText}>
          <span set:html={header.contextHtml} />
          <Icon name="chevronRight" />
        </a>
        {heroWitnesses && (
          <div class="ebj-hero-wit">
            <WitnessStrip w={heroWitnesses} />
          </div>
        )}
        {header.framingHtml && <div class="ebj-framing ebj-pair__body" set:html={header.framingHtml} />}
        {header.whosWhoHtml && (
          <details class="hrv-disclosure ebj-deeper ebj-whos-who">
            <summary>
              <span set:html={tl(header.whosWhoSummary)} />
              <Icon name="chevronDown" />
            </summary>
            <div class="hrv-disclosure__body ebj-pair__body" set:html={header.whosWhoHtml} />
          </details>
        )}
        {model.emphasisNote && <p class="ebj-emph" set:html={tl(model.emphasisNote)} />}
      </header>

      <section class="ebj-glance-sec" id={GLANCE_ID} aria-labelledby={`${GLANCE_ID}-h`}>
        <h2 class="hrv-eyebrow ebj-glance-sec__h" id={`${GLANCE_ID}-h`} set:html={tl(labels.glance)} />
        <GlanceRows rows={glance} />
      </section>

      {sections.map(s => (
        <section
          class={`hrv-sec ebj-sec${s.isItem ? '' : ' ebj-sec--appendix'}`}
          id={s.id}
          aria-labelledby={`${s.id}-h`}
        >
          <SectionHead s={s} />
          {s.showcase && <ConfrontationFrame showcase={s.showcase} />}
          {s.introHtml && <p class="ebj-intro" set:html={s.introHtml} />}
          {s.groups.length > 0 && (
            <div class="ebj-say">
              {labels.sourcesWhat && <p class="hrv-eyebrow ebj-what" set:html={tl(labels.sourcesWhat)} />}
              <div class="ebj-say__groups">{s.groups.map(g => <CardGroup g={g} labels={labels} />)}</div>
            </div>
          )}
          <ClassicalPair classical={s.classical} evaluation={s.evaluation} deeper={s.deeper} />
        </section>
      ))}

      <section class="hrv-sec ebj-sec ebj-sec--sources" id={SOURCES_ID} aria-labelledby={`${SOURCES_ID}-h`}>
        <div class="hrv-q__head ebj-sec__head">
          <span class="hrv-q__num ebj-sec__mark" aria-hidden="true"><Icon name="book" /></span>
          <h2 class="hrv-q__title" id={`${SOURCES_ID}-h`} set:html={tl(labels.sources)} />
        </div>
        <SourcesBlock groups={sources} />
        <div class="ebj-closing">
          <h2 class="ebj-closing__h" id="closing-h" set:html={tl(closing.heading || labels.closingHeading)} />
          <div class="ebj-closing__body" set:html={closing.html} />
        </div>
        {labels.backToTop && (
          <a class="ebj-top" href="#top">
            <Icon name="chevronDown" class="ebj-top__icon" />
            <span set:html={tl(labels.backToTop)} />
          </a>
        )}
      </section>
    </div>
  </article>
  <script src="../../components/discover/extrabiblical-evidence/client.js"></script>
</Layout>
