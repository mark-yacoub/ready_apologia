---
/**
 * /discover/islamic-dilemma — what the Qurʾān says about the Gospel Christians held, beside Gospel
 * copies older than Islam. One page, one argument in six reader-question sections (strongest first).
 *
 * Built on the hadith-reliability design system (`.hrv`) plus a small scoped layer (`.hrv.idl`).
 * Copy: src/utils/islamicDilemma/content.js and overrides.js. Data: islamic_dilemma.md (read-only,
 * parsed by dilemma_parser.js) + manuscript scans from data.db. Stateless: no storage, no read
 * marks, no URL rewriting on scroll. The only React islands are the collapsed manuscript carousels
 * (hydrated when opened). Old `#stage-1..7` links land on their new sections via alias anchors.
 */
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import EvidenceCard from '../../components/discover/hadith-reliability/EvidenceCard.astro';
import SourcesList from '../../components/discover/hadith-reliability/SourcesList.astro';
import SectionNav from '../../components/discover/islamic-dilemma/SectionNav.astro';
import SectionHead from '../../components/discover/islamic-dilemma/SectionHead.astro';
import ShowcaseFrame from '../../components/discover/islamic-dilemma/ShowcaseFrame.astro';
import GlanceCards from '../../components/discover/islamic-dilemma/GlanceCards.astro';
import ClassicalPair from '../../components/discover/islamic-dilemma/ClassicalPair.astro';
import VerseCards from '../../components/discover/islamic-dilemma/VerseCards.astro';
import PassageCard from '../../components/discover/islamic-dilemma/PassageCard.astro';
import AnswerList from '../../components/discover/islamic-dilemma/AnswerList.astro';
import ReferenceCards from '../../components/discover/islamic-dilemma/ReferenceCards.astro';
import { getFormattedManuscriptsByVerseId } from '../../utils/evidence_repository.js';
import { loadIslamicDilemma } from '../../utils/islamicDilemma/model.js';
import { BASE, BASE_PATH, OG_IMAGE, SEO, DATE_PUBLISHED, GLANCE_ID, discoverHref } from '../../utils/islamicDilemma/config.js';
import { buildBreadcrumbSchema, SITE_NAME, DEFAULT_LOGO_URL } from '../../utils/seoFactory.js';
import { tl } from '../../utils/hadithReliability/render.js';
import '../../styles/hadith-reliability.css';
import '../../styles/islamic-dilemma.css';

const model = loadIslamicDilemma({ getManuscripts: getFormattedManuscriptsByVerseId });
const { header, sections, core, glance, quran, gospel, onJesus, textHistory, answers, sources, labels, sectionContext } = model;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${site}${BASE_PATH}`;
const ogImage = `${site}${OG_IMAGE}`;
const abs = href => (href.startsWith('http') ? href : `${site}${href}`);

// JSON-LD: Article (+ citation, about) and BreadcrumbList. No FAQPage / ClaimReview.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumbSchema([
      { name: 'Ready Apologia', url: `${site}${BASE}/` },
      { name: 'Discover', url: `${site}${BASE}/discover` },
      { name: SEO.title, url: canonicalURL },
    ]),
    {
      '@type': 'Article',
      '@id': `${canonicalURL}#article`,
      headline: SEO.title,
      description: SEO.description,
      url: canonicalURL,
      mainEntityOfPage: canonicalURL,
      image: [ogImage],
      inLanguage: 'en',
      author: { '@type': 'Organization', name: SITE_NAME, url: 'https://readyapologia.com' },
      publisher: { '@type': 'Organization', name: SITE_NAME, logo: { '@type': 'ImageObject', url: DEFAULT_LOGO_URL } },
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_PUBLISHED,
      about: SEO.about,
      citation: model.citations.slice(0, 20).map(c => ({ '@type': 'CreativeWork', name: c.name, url: abs(c.href) })),
    },
  ],
};
const sec = id => sections.find(s => s.id === id);
---
<Layout
  title={SEO.title}
  description={SEO.description}
  keywords={SEO.keywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: 'islamic-dilemma' }} />
  <article class="hrv idl" id="top">
    <span id={model.topAlias} class="idl-alias" aria-hidden="true"></span>
    <SectionNav sections={sections} labels={labels} backHref={discoverHref()} />
    <div class="hrv-wrap">
      <header class="hrv-case-head idl-head">
        <p class="hrv-eyebrow">{header.eyebrow}</p>
        <h1 class="hrv-case-h1 idl-h1" set:html={header.h1Html} />
        <p class="hrv-hook" set:html={header.hookHtml} />
        <a class="hrv-context" href="#sources"><span set:html={tl(header.context)} /><Icon name="chevronRight" /></a>
      </header>

      <ShowcaseFrame sc={core.sc} caption={core.caption} ariaLabel={core.ariaLabel} id="core" extraClass="idl-core" />

      <section class="idl-glance-sec" id={GLANCE_ID} aria-labelledby={`${GLANCE_ID}-h`}>
        <h2 class="hrv-eyebrow hrv-section-label" id={`${GLANCE_ID}-h`}>{labels.glance}</h2>
        <GlanceCards cards={glance} />
      </section>

      {/* §1 Qurʾān */}
      <section class="hrv-sec idl-sec" id="quran" aria-labelledby="quran-h">
        <SectionHead s={sec('quran')} context={sectionContext} />
        <p class="idl-intro" set:html={quran.introHtml} />
        {quran.cards.map(e => (
          <div class="idl-card-group">
            <EvidenceCard e={e} />
            {(e.classical || e.evaluation || e.deeper) && <ClassicalPair classical={e.classical} evaluation={e.evaluation} deeper={e.deeper} />}
          </div>
        ))}
        <h3 class="idl-sub">{quran.torah.heading}</h3>
        <div class="idl-card-group">
          <EvidenceCard e={quran.torah.e} />
          {quran.torah.deeper && <ClassicalPair deeper={quran.torah.deeper} />}
        </div>
        <h3 class="idl-sub">{quran.compactHeading}</h3>
        <VerseCards items={quran.compact} />
      </section>

      {/* §2 Gospel copies */}
      <section class="hrv-sec idl-sec" id="gospel-copies" aria-labelledby="gospel-copies-h">
        <SectionHead s={sec('gospel-copies')} context={sectionContext} />
        <p class="idl-intro" set:html={gospel.introHtml} />
        <ShowcaseFrame sc={gospel.timeline} caption={labels.timelineCaption} ariaLabel={labels.timelineAria} id="timeline" />
        {gospel.cards.map(e => <EvidenceCard e={e} />)}
        {gospel.summaryHtml && <p class="idl-intro idl-summary" set:html={gospel.summaryHtml} />}
        <div class="idl-passages">
          {gospel.passages.map(p => <PassageCard p={p} labels={labels} />)}
        </div>
      </section>

      {/* §3 On Jesus */}
      <section class="hrv-sec idl-sec" id="on-jesus" aria-labelledby="on-jesus-h">
        <SectionHead s={sec('on-jesus')} context={sectionContext} />
        <p class="idl-intro" set:html={onJesus.introHtml} />
        {onJesus.rows.map((r, i) => <ShowcaseFrame sc={r.sc} caption={r.caption} id={`jesus-${i}`} extraClass="idl-row" />)}
        {onJesus.takeawayParas?.length > 0 && onJesus.takeawayParas.map(p => <p class="hrv-sc__note idl-note idl-takeaway" set:html={p} />)}
        <details class="hrv-disclosure">
          <summary><span>{labels.fullVerses}</span><Icon name="chevronDown" /></summary>
          <div class="hrv-disclosure__body">
            <ul class="idl-fullverses">
              {onJesus.fullVerses.map(v => (
                <li>
                  <blockquote class="hrv-quote"><p class="hrv-quote__en" set:html={`“${v.textHtml}”`} /></blockquote>
                  <a class="hrv-sc__ref is-internal" href={v.ref.href} title={v.ref.title} set:html={tl(v.ref.label)} />
                </li>
              ))}
            </ul>
          </div>
        </details>
        <p class="hrv-sc__note idl-note" set:html={onJesus.noteHtml} />
      </section>

      {/* §4 Text history */}
      <section class="hrv-sec idl-sec" id="text-history" aria-labelledby="text-history-h">
        <SectionHead s={sec('text-history')} context={sectionContext} />
        <p class="idl-intro" set:html={textHistory.introHtml} />
        <ShowcaseFrame sc={textHistory.witnesses} caption={labels.witnessesCaption} id="witnesses" />
        {textHistory.witnessesTakeawayHtml && <p class="hrv-sc__note idl-note idl-takeaway" set:html={textHistory.witnessesTakeawayHtml} />}
        <h3 class="idl-sub" set:html={tl(textHistory.versesHeading)} />
        <p class="idl-intro" set:html={textHistory.versesIntroHtml} />
        <VerseCards items={textHistory.verses} />
        <div class="idl-card-group">
          <ClassicalPair classical={textHistory.versesClassical} evaluation={textHistory.versesEvaluation} level={4} />
        </div>
        <h3 class="idl-sub" set:html={tl(textHistory.summaryHeading)} />
        <div class="idl-card-group">
          <ClassicalPair classical={textHistory.classical} evaluation={textHistory.evaluation} deeper={textHistory.deeper} />
        </div>
      </section>

      {/* §5 Answers */}
      <section class="hrv-sec idl-sec" id="answers" aria-labelledby="answers-h">
        <SectionHead s={sec('answers')} context={sectionContext} />
        <p class="idl-intro" set:html={answers.introHtml} />
        <AnswerList items={answers.items} textsLabel={answers.textsLabel} />
      </section>

      {/* §6 Sources */}
      <section class="hrv-sec idl-sec" id="sources" aria-labelledby="sources-h">
        <SectionHead s={sec('sources')} context={sectionContext} />
        <p class="idl-intro" set:html={sources.introHtml} />
        <SourcesList groups={sources.groups} />
        <details class="hrv-disclosure idl-allrefs">
          <summary><span>{labels.allReferences}</span><span class="hrv-disclosure__meta">{sources.references.length}</span><Icon name="chevronDown" /></summary>
          <div class="hrv-disclosure__body">
            <ReferenceCards refs={sources.references} />
          </div>
        </details>
        {sources.academic.length > 0 && (
          <div class="idl-academic">
            <h3 class="idl-sub">{labels.academic}</h3>
            <p class="hrv-further-note">{labels.academicNote}</p>
            <ul class="hrv-srclist">
              {sources.academic.map(a => (
                <li>{a.href
                  ? <a class="hrv-src" href={a.href} {...a.attrs}><span class="hrv-src__label"><span set:html={a.html} /><span class="hrv-src__meta">{a.host}</span></span><Icon name="book" /></a>
                  : <span class="hrv-src idl-src--text"><span class="hrv-src__label"><span set:html={a.html} /></span><Icon name="book" /></span>}</li>
              ))}
            </ul>
          </div>
        )}
        <aside class="idl-closing" aria-labelledby="closing-h">
          <h2 class="idl-closing__h" id="closing-h">{sources.closing.heading}</h2>
          {sources.closing.beforeHtml.map(p => <p class="idl-closing__line" set:html={p} />)}
          <blockquote class="hrv-quote">
            <p class="hrv-quote__en" set:html={`“${sources.closing.quoteHtml}”`} />
            {sources.closing.citeHref
              ? <a class="hrv-quote__ref" href={sources.closing.citeHref}>{sources.closing.cite}</a>
              : <span class="hrv-quote__ref">{sources.closing.cite}</span>}
          </blockquote>
          <p class="idl-closing__line" set:html={sources.closing.lineHtml} />
        </aside>
      </section>
    </div>
  </article>
  <script src="../../components/discover/islamic-dilemma/client.js"></script>
</Layout>
