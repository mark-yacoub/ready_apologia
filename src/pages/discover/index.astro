---
import Layout from '../../layouts/Layout.astro';
import DiscoverCard from '../../components/DiscoverCard.astro';
import ComingSoonBanner from '../../components/ComingSoonBanner.astro';
import discoverData from '../../data/discoverCatalog.json';
import { clusterCatalogData } from '../../utils/discoverService';

// Safely inject dependencies into the pure service core
const clusteredCatalog = clusterCatalogData(discoverData as unknown[]);
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/discover`;

const pageTitle = "Discover Christian Apologetics & Islamic Studies";
const pageDesc = "Explore interactive deep dives, archaeological timelines, and manuscript evidence examining Christian theology, early church history, and Quranic origins.";
const pageKeywords = "christian apologetics, islamic studies, biblical manuscripts, quranic preservation, historical jesus, pre-nicene church fathers, comparative scripture";

const schemaObj = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Ready Apologia", "item": `${siteUrl}${base}/` },
        { "@type": "ListItem", "position": 2, "name": "Discover", "item": canonicalURL }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": canonicalURL,
      "headline": pageTitle,
      "name": pageTitle,
      "description": pageDesc,
      "url": canonicalURL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "Ready Apologia",
        "url": `${siteUrl}${base}/`
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  keywords={pageKeywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={schemaObj}
>
  <div class="discover-hub">
    <header class="hub-header">
      <div class="hub-header-top">
        <div class="hub-header-text">
          <h1 class="hub-title">Discover</h1>
          <p class="hub-subtitle">Deep dive into topics drawn from historical and scriptural sources.</p>
        </div>
        <a href={`${base}/discover/statistics`} class="stats-header-btn" title="Scripture Statistics & Leaderboards">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="stats-icon">
            <line x1="18" y1="20" x2="18" y2="10"></line>
            <line x1="12" y1="20" x2="12" y2="4"></line>
            <line x1="6" y1="20" x2="6" y2="14"></line>
          </svg>
          <span>Stats</span>
        </a>
      </div>
    </header>

    <div class="hero-cards-container tabs-controller" style="padding-top: 16px; padding-bottom: 24px;">
      {clusteredCatalog.map((categoryGroup, index) => {
        const isActive = index === 0;
        const isChristianity = categoryGroup.name === 'Christianity';
        const safeId = categoryGroup.name.toLowerCase().replace(/\s+/g, '-');
        return (
          <button
            type="button"
            class={`category-hero-card ${isActive ? 'is-active' : ''} ${isChristianity ? 'christian-theme' : 'islam-theme'}`}
            data-target={`panel-${safeId}`}
          >
            <div class="hero-card-content">
              <h2 class="hero-card-title">{categoryGroup.name}</h2>
              <p class="hero-card-subtitle">
                {isChristianity ? 'Defending Core Theology' : 'Evaluating Scripture'}
              </p>
            </div>
            <div class="hero-watermark">
              {isChristianity ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v18M7 8h10"/>
                </svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              )}
            </div>
          </button>
        );
      })}
    </div>

    <div class="categories-container" id="discover-panels">
      {clusteredCatalog.map((categoryGroup, index) => {
        const safeId = categoryGroup.name.toLowerCase().replace(/\s+/g, '-');
        // Pre-hide non-first panels logically
        const initialStyle = index === 0 ? "display: flex;" : "display: none;";
        return (
          <div 
            id={`panel-${safeId}`}
            class="major-category-block animate-fade-in" 
            data-category={categoryGroup.name}
            style={initialStyle}
          >
          
          <div class="subcategories-container">
            {categoryGroup.subcategories.map((subGroup) => (
              <section class="discover-section">
                <div class="section-header">
                  <h3 class="section-title">{subGroup.name}</h3>
                </div>
                <div class="cards-grid">
                  {subGroup.articles.map((card) => (
                    <DiscoverCard card={card} base={base} />
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      );
    })}
    </div>

    <ComingSoonBanner url="https://forms.gle/KVeeDW41J9zqJtdZ7" />

  </div>
</Layout>

<script>
  import { replaceUrl } from '../../utils/url_history.js';

  // This script runs once per session. One window listener delegates to the CURRENT visit's
  // handler (each visit swaps in new DOM), and is a no-op on every other page.
  let syncCurrentPage = null;
  window.addEventListener('hashchange', () => syncCurrentPage?.());
  document.addEventListener('astro:before-swap', () => { syncCurrentPage = null; });

  function setupDiscoverTabs() {
    const parentContainer = document.querySelector('.tabs-controller');
    const panels = document.querySelectorAll('.major-category-block');
    if (!parentContainer || !panels.length) return;
    const buttons = parentContainer.querySelectorAll('.category-hero-card');

    function activateTab(targetId, updateHash = true) {
      buttons.forEach(b => {
        if (b.getAttribute('data-target') === targetId) {
          b.classList.add('is-active');
          // Centre the card in the horizontal rail only. scrollIntoView would also scroll the page
          // vertically, fighting Back/Forward scroll restoration.
          const rail = parentContainer.getBoundingClientRect();
          const card = b.getBoundingClientRect();
          parentContainer.scrollBy({ left: card.left - rail.left - (rail.width - card.width) / 2, behavior: 'smooth' });
        } else {
          b.classList.remove('is-active');
        }
      });
      
      panels.forEach(p => {
        if (p.id === targetId) {
          p.style.display = 'flex';
          p.classList.remove('animate-fade-in');
          void p.offsetWidth; // Force Reflow
          p.classList.add('animate-fade-in');
        } else {
          p.style.display = 'none';
        }
      });

      if (updateHash && typeof window !== 'undefined') {
        const hash = targetId.replace(/^panel-/, '');
        replaceUrl(`#${hash}`);
      }
    }

    function syncFromUrlHash() {
      if (typeof window !== 'undefined' && window.location.hash) {
        const rawHash = window.location.hash.slice(1).toLowerCase();
        const targetPanelId = `panel-${rawHash}`;
        const matchingBtn = parentContainer.querySelector(`[data-target="${targetPanelId}"]`);
        if (matchingBtn) {
          activateTab(targetPanelId, false);
        }
      }
    }

    // Handle initial hash on page load
    syncFromUrlHash();
    syncCurrentPage = syncFromUrlHash;

    // Prevent duplicate event bindings across lifecycle / SPA navigation
    if (parentContainer.dataset.tabsInitialized === 'true') return;
    parentContainer.dataset.tabsInitialized = 'true';

    // Event delegation for tab clicks
    parentContainer.addEventListener('click', (e) => {
      const btn = e.target.closest('.category-hero-card');
      if (!btn) return;
      const targetId = btn.getAttribute('data-target');
      activateTab(targetId, true);
    });
  }

  // Run now (astro:page-load waits for window load on a direct visit), then on every swap. Re-running is safe.
  setupDiscoverTabs();
  document.addEventListener('astro:page-load', setupDiscoverTabs);
</script>



<style>
  .discover-hub {
    display: flex;
    flex-direction: column;
    padding-bottom: 24px;
    animation: fadeIn 0.25s ease-out forwards;
  }

  .hub-header {
    padding: 8px 0 0 0;
  }

  .hub-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hub-header-text {
    flex: 1;
  }

  .stats-header-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 6px 14px;
    border-radius: 9999px;
    background-color: var(--ra-surface, #ffffff);
    color: var(--ra-ink-2, #57514a);
    border: 1px solid var(--ra-line-strong, #d8d0c4);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    box-shadow: var(--ra-shadow-sm, 0 1px 2px rgba(27, 25, 23, 0.04));
  }
  .stats-header-btn:hover {
    color: var(--ra-ink, #1b1917);
    border-color: var(--ra-ink, #1b1917);
    background-color: var(--ra-well, #f3efe8);
    transform: translateY(-1px);
  }

  .stats-icon {
    width: 15px;
    height: 15px;
  }

  .hub-title {
    font-size: 30px;
    font-weight: 800;
    margin: 0 0 4px 0;
    color: var(--ra-ink, #1b1917);
    letter-spacing: -0.02em;
    font-family: var(--ra-display, 'Literata', Georgia, serif);
  }

  .hub-subtitle {
    font-size: 14px;
    color: var(--ra-ink-2, #57514a);
    margin: 0;
    line-height: 1.5;
    font-family: var(--ra-sans, 'Public Sans', sans-serif);
  }

  .hero-cards-container {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    padding-bottom: 8px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .hero-cards-container::-webkit-scrollbar {
    display: none;
  }

  .category-hero-card {
    position: relative;
    flex: 0 0 calc(85% - 8px);
    max-width: 340px;
    height: 136px;
    border-radius: 16px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background-color: var(--ra-surface, #ffffff);
    border: 1px solid var(--ra-line, #e8e2d9);
    cursor: pointer;
    overflow: hidden;
    text-align: left;
    transition: transform 0.22s var(--ra-ease, ease), box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease, opacity 0.22s ease;
    box-shadow: var(--ra-shadow-sm, 0 1px 2px rgba(27, 25, 23, 0.04));
  }
  @media (min-width: 768px) {
    .category-hero-card {
      flex: 1;
      height: 152px;
      padding: 22px 24px;
    }
  }

  .category-hero-card:active {
    transform: scale(0.98);
  }
  .category-hero-card:not(.is-active) {
    opacity: 0.76;
    background: var(--ra-surface, #ffffff);
  }
  .category-hero-card:not(.is-active):hover {
    opacity: 0.94;
    border-color: var(--ra-line-strong, #d8d0c4);
  }
  .category-hero-card.is-active {
    opacity: 1;
    transform: translateY(-1px);
  }

  .category-hero-card.is-active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 3;
  }

  .christian-theme.is-active {
    background: linear-gradient(155deg, #ffffff 0%, #f8f0ee 100%);
    border-color: var(--ra-christian-rule, #dfc5c2);
    box-shadow: 0 8px 22px -8px rgba(122, 53, 48, 0.16);
  }
  .christian-theme.is-active::before { background-color: var(--ra-christian, #7a3530); }
  .christian-theme.is-active .hero-card-title { color: var(--ra-christian, #7a3530); }

  .islam-theme.is-active {
    background: linear-gradient(155deg, #ffffff 0%, #eff5f0 100%);
    border-color: var(--ra-islamic-rule, #c2d6c6);
    box-shadow: 0 8px 22px -8px rgba(51, 89, 58, 0.16);
  }
  .islam-theme.is-active::before { background-color: var(--ra-islamic, #33593a); }
  .islam-theme.is-active .hero-card-title { color: var(--ra-islamic, #33593a); }

  .hero-card-content { position: relative; z-index: 2; }

  .hero-card-title {
    font-family: var(--ra-display, 'Literata', Georgia, serif);
    font-size: 23px;
    font-weight: 800;
    margin: 0 0 3px 0;
    color: var(--ra-ink, #1b1917);
    letter-spacing: -0.02em;
  }
  @media (min-width: 768px) {
    .hero-card-title { font-size: 27px; margin: 0 0 4px 0; }
  }

  .hero-card-subtitle {
    font-family: var(--ra-sans, 'Public Sans', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--ra-ink-3, #6b6560);
    margin: 0;
  }
  @media (min-width: 768px) {
    .hero-card-subtitle { font-size: 14px; }
  }

  .hero-watermark {
    position: absolute;
    right: -18px;
    bottom: -36px;
    z-index: 1;
    opacity: 0.05;
    transform: rotate(-10deg);
    transition: opacity 0.25s ease;
  }
  .category-hero-card.is-active .hero-watermark { opacity: 0.1; }
  .hero-watermark svg { width: 168px; height: 168px; }

  @media (max-width: 767px) {
    .hero-cards-container { overflow-x: visible; gap: 10px; }
    .category-hero-card {
      flex: 1 1 0;
      min-width: 0;
      max-width: none;
      height: 124px;
      padding: 14px;
      transition: flex-grow 0.28s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.25s ease, transform 0.25s ease;
    }
    .category-hero-card.is-active { flex: 0 0 calc(60% - 5px); padding: 16px; }
    .category-hero-card .hero-card-title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .category-hero-card .hero-card-subtitle { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.3; }
    .category-hero-card:not(.is-active) .hero-card-title { font-size: 18px; }
    .category-hero-card:not(.is-active) .hero-card-subtitle { font-size: 12px; }
    .category-hero-card:not(.is-active) { opacity: 0.85; }
  }
  @media (max-width: 399px) {
    .category-hero-card.is-active .hero-card-title { font-size: 20px; }
  }
  .christian-theme .hero-watermark { color: var(--ra-christian, #7a3530); }
  .islam-theme .hero-watermark { color: var(--ra-islamic, #33593a); }

  .categories-container {
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .major-category-block {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .subcategories-container {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .section-header {
    margin-bottom: 12px;
  }

  .section-title {
    font-family: var(--ra-sans, 'Public Sans', sans-serif);
    font-size: 12px;
    font-weight: 800;
    color: var(--ra-ink-3, #6b6560);
    margin: 0 0 10px 0;
    padding: 0 0 8px 0;
    border-bottom: 1px solid var(--ra-line, #e8e2d9);
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    padding: 0 0 12px 0;
  }

  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 16px;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.25s ease-out forwards;
  }
</style>
