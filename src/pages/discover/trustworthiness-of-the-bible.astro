---
/**
 * /discover/trustworthiness-of-the-bible: primary-source reference dossier examining 96 biblical
 * manuscripts, Qumran scrolls, textual-variant tiers, Greco-Roman and Near Eastern inscriptions,
 * non-Christian historians, Palestinian Jewish name frequencies, and pre-Nicene patristic citations.
 *
 * Built on the shared hadith-reliability design system (.hrv) + thin scoped layer (.hrv.twb).
 * Static and stateless: zero React islands, zero client storage, zero URL rewriting, and 100%
 * preservation of legacy stage, theme, chart, and item #hash anchors without JavaScript.
 */
import Layout from '../../layouts/Layout.astro';
import RouteAnalytics from '../../components/common/RouteAnalytics.astro';
import Icon from '../../components/discover/hadith-reliability/Icon.astro';
import SectionNav from '../../components/discover/trustworthiness-of-the-bible/SectionNav.astro';
import GlanceRows from '../../components/discover/trustworthiness-of-the-bible/GlanceRows.astro';
import FolioCard from '../../components/discover/trustworthiness-of-the-bible/FolioCard.astro';
import EvidenceCard from '../../components/discover/trustworthiness-of-the-bible/EvidenceCard.astro';
import ClassicalComparisonTable from '../../components/discover/trustworthiness-of-the-bible/ClassicalComparisonTable.astro';
import OnomasticsTable from '../../components/discover/trustworthiness-of-the-bible/OnomasticsTable.astro';
import FourMoveBlock from '../../components/discover/trustworthiness-of-the-bible/FourMoveBlock.astro';
import SourcesBlock from '../../components/discover/trustworthiness-of-the-bible/SourcesBlock.astro';
import * as CONTENT from '../../utils/trustworthinessBible/content.js';
import { loadTrustworthinessBible } from '../../utils/trustworthinessBible/model.js';
import {
  BASE,
  BASE_PATH,
  OG_IMAGE,
  SITE_URL,
  DATE_PUBLISHED,
  DATE_MODIFIED,
  GLANCE_ID,
  SOURCES_ID,
  CATALOG_SLUG,
  discoverHref,
} from '../../utils/trustworthinessBible/config.js';
import { buildBreadcrumbSchema, SITE_NAME, DEFAULT_LOGO_URL } from '../../utils/seoFactory.js';
import { tl } from '../../utils/hadithReliability/render.js';
import '../../styles/hadith-reliability.css';
import '../../styles/trustworthiness-of-the-bible.css';

const model = loadTrustworthinessBible(CONTENT);
const { seo, header, labels, nav, glance, sections, sources, closing } = model;

const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : SITE_URL;
const canonicalURL = `${site}${BASE_PATH}`;
const ogImage = `${site}${OG_IMAGE}`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    buildBreadcrumbSchema([
      { name: 'Ready Apologia', url: `${site}${BASE}/` },
      { name: 'Discover', url: `${site}${BASE}/discover` },
      { name: seo.title, url: canonicalURL },
    ]),
    {
      '@type': 'Article',
      '@id': `${canonicalURL}#article`,
      headline: seo.title,
      description: seo.description,
      url: canonicalURL,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      image: [ogImage],
      inLanguage: 'en',
      author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      publisher: { '@type': 'Organization', name: SITE_NAME, logo: { '@type': 'ImageObject', url: DEFAULT_LOGO_URL } },
      datePublished: DATE_PUBLISHED,
      dateModified: DATE_MODIFIED,
      citation: model.citations.map(c => ({ '@type': 'CreativeWork', name: c.name, url: c.url })),
    },
  ],
};
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogImage={ogImage}
  ogType="article"
  schema={schema}
  showOnboarding={false}
>
  <RouteAnalytics eventName="discover_article_view" params={{ article_slug: CATALOG_SLUG }} />
  <article class="hrv twb" id="top">
    <SectionNav nav={nav} labels={labels} backHref={discoverHref()} canonical={canonicalURL} />
    <div class="hrv-wrap">
      <header class="hrv-case-head twb-head">
        <p class="hrv-eyebrow" set:html={tl(header.eyebrow)} />
        <h1 class="hrv-case-h1 twb-h1" set:html={header.h1Html} />
        <p class="hrv-hook twb-hook" set:html={header.hookHtml} />
        <a class="twb-head__context" href={`#${SOURCES_ID}`} title={header.contextText}>
          <span set:html={header.contextHtml} /><Icon name="chevronRight" />
        </a>
        <details class="hrv-disclosure twb-whos-who">
          <summary>
            <span set:html={tl(header.whosWhoSummary)} />
            <Icon name="chevronDown" />
          </summary>
          <div class="hrv-disclosure__body twb-pair__body twb-glossary">
            {header.whosWhoGlossary.length > 0 ? (
              header.whosWhoGlossary.map(g => (
                <div class="twb-glossary__group">
                  <h2 class="twb-glossary__h" set:html={g.groupHtml} />
                  <dl class="twb-glossary__dl">
                    {g.entries.map(e => (
                      <div class="twb-glossary__row">
                        <dt class="twb-glossary__dt" set:html={e.termHtml} />
                        <dd class="twb-glossary__dd" set:html={e.defHtml} />
                      </div>
                    ))}
                  </dl>
                </div>
              ))
            ) : (
              <p set:html={header.whosWhoHtml} />
            )}
          </div>
        </details>
      </header>

      <section class="twb-glance-sec" id={GLANCE_ID} aria-labelledby={`${GLANCE_ID}-h`}>
        <span class="twb-alias" id="overview" aria-hidden="true"></span>
        <span class="twb-alias" id="section-overview" aria-hidden="true"></span>
        <h2 class="hrv-eyebrow twb-glance-sec__h" id={`${GLANCE_ID}-h`} set:html={tl(labels.glance)} />
        <GlanceRows rows={glance} />
      </section>

      {sections.map(s => (
        <section class="hrv-sec twb-sec" id={s.id} aria-labelledby={`${s.id}-h`}>
          {s.aliases.map(a => <span class="twb-alias" id={a} aria-hidden="true"></span>)}
          <div class="hrv-q__head twb-sec__head">
            <span class="hrv-q__num" aria-hidden="true">{String(s.number).padStart(2, '0')}</span>
            <h2 class="hrv-q__title" id={`${s.id}-h`} set:html={s.titleHtml} />
          </div>
          <div class="twb-intro" set:html={s.introHtml} />

          {s.themes.map(th => (
            <div class="twb-theme" id={th.id}>
              {th.aliases.map(a => <span class="twb-alias" id={a} aria-hidden="true"></span>)}
              <p class="hrv-eyebrow twb-theme__eyebrow" set:html={th.eyebrowHtml} />
              <h3 class="twb-theme__title" set:html={th.titleHtml} />
              <div class="twb-theme__lead" set:html={th.leadHtml} />

              {th.kind === 'manuscripts' && th.groups.map(g => (
                <div class="twb-ms-group">
                  <p class="hrv-eyebrow twb-ms-group__h" set:html={g.labelHtml} />
                  {g.cards.map(c => <FolioCard c={c} verifyAria={labels.verifyAria} />)}
                </div>
              ))}

              {th.kind === 'classical-table' && (
                <ClassicalComparisonTable rows={th.rows} takeawayHtml={th.takeawayHtml} />
              )}

              {th.kind === 'onomastics' && (
                <>
                  <OnomasticsTable tables={th.tables} />
                  {th.cards.map(c => <EvidenceCard c={c} verifyAria={labels.verifyAria} />)}
                </>
              )}

              {th.kind === 'patristics' && th.cards.map(c => (
                <EvidenceCard c={c} verifyAria={labels.verifyAria} patristicTable={th.patristicTable} />
              ))}

              {th.kind === 'variants' && th.cards.map(c => (
                <EvidenceCard c={c} verifyAria={labels.verifyAria} />
              ))}

              {th.kind === 'cards' && (
                <>
                  {th.primaryCards.map(c => (
                    <EvidenceCard c={c} verifyAria={labels.verifyAria} />
                  ))}
                  {th.contestedCards.length > 0 && (
                    <details class="hrv-disclosure twb-contested">
                      <summary>
                        <span set:html={th.contestedSummaryHtml} />
                        <Icon name="chevronDown" />
                      </summary>
                      <div class="hrv-disclosure__body twb-contested__body">
                        {th.contestedIntroHtml && <p class="twb-contested__intro" set:html={th.contestedIntroHtml} />}
                        {th.contestedCards.map(c => (
                          <EvidenceCard c={c} verifyAria={labels.verifyAria} />
                        ))}
                      </div>
                    </details>
                  )}
                </>
              )}
            </div>
          ))}

          {s.assessments.map(a => (
            <FourMoveBlock classical={a.classical} evaluation={a.evaluation} />
          ))}
        </section>
      ))}

      <section class="hrv-sec twb-sec twb-sec--sources" id={SOURCES_ID} aria-labelledby={`${SOURCES_ID}-h`}>
        <div class="hrv-q__head twb-sec__head">
          <span class="hrv-q__num twb-sec__mark" aria-hidden="true"><Icon name="book" /></span>
          <h2 class="hrv-q__title" id={`${SOURCES_ID}-h`} set:html={tl(labels.sources)} />
        </div>
        <SourcesBlock groups={sources} />
        <div class="twb-closing">
          <h2 class="twb-closing__h" id="closing-h" set:html={tl(closing.heading)} />
          <div class="twb-closing__body" set:html={closing.html} />
        </div>
        <a class="twb-top" href="#top"><Icon name="chevronDown" class="twb-top__icon" /><span set:html={tl(labels.backToTop)} /></a>
      </section>
    </div>
  </article>
  <script src="../../components/discover/trustworthiness-of-the-bible/client.js"></script>
</Layout>
