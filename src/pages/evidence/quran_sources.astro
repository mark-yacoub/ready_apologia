---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import QuranSourcesExplorer from '../../components/quranSources/QuranSourcesExplorer.jsx';
import { CATEGORIES } from '../../utils/quranSources/contract.js';
import { resolveEvidenceSeo, UI_COPY } from '../../utils/quranSources/config.js';

const indexRaw = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'src/data/quran/sources/index.json'), 'utf8')
);

const totalItems = indexRaw.totalItems || 0;
const totalVerses = indexRaw.totalVerses || 0;
const totalCitations = indexRaw.totalCitations || 0;
const categoryStats = Array.isArray(indexRaw.categories) ? indexRaw.categories : [];

const defaultSlug = CATEGORIES[0].slug;
const firstPagePath = path.join(
  process.cwd(),
  'public/data/quran-sources',
  defaultSlug,
  'all',
  '1.json'
);
const initialPageData = fs.existsSync(firstPagePath)
  ? JSON.parse(fs.readFileSync(firstPagePath, 'utf8'))
  : { page: 1, pages: 1, total: 0, cards: [] };

const { title: evidenceTitle, description: evidenceDesc, keywords: evidenceKeywords } =
  resolveEvidenceSeo({ totalItems });

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: UI_COPY.breadcrumbRoot,
          item: `${site}${base}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: UI_COPY.breadcrumbEvidence,
          item: `${site}${base}/evidence`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: UI_COPY.pageHeading,
          item: `${site}${base}/evidence/quran_sources`,
        },
      ],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${site}${base}/evidence/quran_sources`,
      url: `${site}${base}/evidence/quran_sources`,
      name: UI_COPY.pageHeading,
      headline: evidenceTitle,
      description: evidenceDesc,
      keywords: evidenceKeywords,
      isPartOf: {
        '@type': 'WebSite',
        name: UI_COPY.breadcrumbRoot,
        url: `${site}${base}/`,
      },
    },
  ],
};
---

<Layout
  title={evidenceTitle}
  description={evidenceDesc}
  keywords={evidenceKeywords}
  ogImage="/assets/logo.png"
  ogType="article"
  schema={schemaGraph}
  theme="quran"
>
  <QuranSourcesExplorer
    client:load
    totalItems={totalItems}
    totalVerses={totalVerses}
    totalCitations={totalCitations}
    categoryStats={categoryStats}
    initialCategorySlug={defaultSlug}
    initialPageData={initialPageData}
  />
</Layout>
