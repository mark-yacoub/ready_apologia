---
import Layout from '../../layouts/Layout.astro';
import QuranicEvidenceExplorer from '../../components/QuranicEvidenceExplorer.jsx';
import verseLabelsObj from '../../data/quran/verse_labels.json';
import drogeTranslation from '../../data/quran/english/droge_translation.json';
import { loadAllEvidenceData } from '../../utils/evidenceLoader.js';

// We load all evidence solely to populate the generic top-of-page Dropdown selector,
// so users can still switch from "Quranic Deficiencies" back to "Divinity of Christ".
const evidenceDropdownData = loadAllEvidenceData();
const evidenceTitle = "Quranic Deficiencies & Theological Evidence";
const evidenceDesc = "Analyze textual and theological deficiencies in the Quran: historical errors, borrowed mythology, biblical contradictions, and moral controversies.";
const evidenceKeywords = "quranic deficiencies, theological defect, borrowed mythology islam, contradicts the bible, quran promotes violence, historical errors in quran";

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const site = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';

const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Ready Apologia",
          "item": `${site}${base}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Apologetics Evidence",
          "item": `${site}${base}/evidence`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Quranic Deficiencies",
          "item": `${site}${base}/evidence/quranic_deficiencies`
        }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": `${site}${base}/evidence/quranic_deficiencies`,
      "url": `${site}${base}/evidence/quranic_deficiencies`,
      "name": "Quranic Deficiencies & Theological Evidence",
      "headline": evidenceTitle,
      "description": evidenceDesc,
      "keywords": evidenceKeywords,
      "isPartOf": {
        "@type": "WebSite",
        "name": "Ready Apologia",
        "url": `${site}${base}/`
      }
    }
  ]
};
---

<Layout 
  title={evidenceTitle} 
  description={evidenceDesc} 
  keywords={evidenceKeywords} 
  ogImage="/assets/logo.png"
  ogType="article"
  schema={schemaGraph}
  theme="quran"
>
  <div class="evidence-page-container">
    <QuranicEvidenceExplorer
      client:load
      evidenceDropdownData={evidenceDropdownData}
      verseLabels={verseLabelsObj}
      drogeTranslation={drogeTranslation}
    />
  </div>
</Layout>

<style>
  .evidence-page-container {
    display: flex;
    flex-direction: column;
    padding-top: 12px;
    min-height: 100%;
  }
</style>
