---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import QuranPageHeader from '../../components/QuranPageHeader.astro';
import { getQuranOgImage } from '../../utils/ogImageResolver.js';
import { generateQuranSurahSEO } from '../../utils/seoFactory.js';
import VariantCard from '../../components/VariantCard.astro';
import { TOTAL_SURAHS } from '../../utils/quran_config.js';
import { BUILD_SURAHS } from '../../utils/build_config.js';
import { loadEnglishData } from '../../utils/quran_loader.js';
import { getVariantsForSurah } from '../../utils/nonUthmanicLoader.js';
import { getQiraatForSurah } from '../../utils/qiraatLoader.js';
import { loadVerseLabels } from '../../utils/quran_verse_labels_loader.js';
import { parseMarkdown } from '../../utils/markdown.js';
import QiraatCard from '../../components/QiraatCard.astro';
import PillChevron from '../../components/PillChevron.astro';
import { getEvidenceSetsForSurahPrefix, getDefaultTafsirScholarForVerse } from '../../utils/quran_evidence_service.js';


export async function getStaticPaths() {
  const paths = [];
  const surahsToBuild = BUILD_SURAHS ? Array.from(BUILD_SURAHS) : Array.from({length: TOTAL_SURAHS}, (_, i) => String(i + 1));
  for (const surah of surahsToBuild) {
    paths.push({ params: { surah } });
  }
  return paths;
}

const { surah } = Astro.params;
const surahNum = parseInt(surah);

// 1. Load Arabic Data
const arabicFilePath = path.join(process.cwd(), 'src/data/quran/arabic/surahs', `${surah}.json`);
let arabicData = { name: '', transliteration: '', verses: {} };
try {
  const content = fs.readFileSync(arabicFilePath, 'utf-8');
  arabicData = JSON.parse(content);
} catch (e) {
  console.error(`Failed to load Arabic data for surah ${surah}`, e);
}

// 2. Load English Data
const englishData = loadEnglishData();

// 3. Load Variants via O(1) in-memory cache lookup
const variantsByAyah = await getVariantsForSurah(surahNum);
const qiraatByAyah = await getQiraatForSurah(surahNum);
const verseLabelsData = loadVerseLabels();

// 3.5 Load Manuscript Maps
const {
  msQuranSet,
  christianFootnotesSet,
  islamicCommentariesSet,
  quranContradictionsSet,
  scientificErrorsSet,
  debunkingMiraclesSet,
  sourcesSet,
  videosSet
} = getEvidenceSetsForSurahPrefix(surahNum);



function replaceOutsideTags(htmlStr: string, regex: RegExp, wrapFn: (match: string) => string) {
  return htmlStr
    .split(/(<[^>]+>)/g)
    .map((chunk, idx) => (idx % 2 === 0 ? chunk.replace(regex, wrapFn) : chunk))
    .join('');
}

function getShortVariantTypeTag(vtype: string) {
  const t = (vtype || '').toLowerCase();
  if (t.includes('addition')) return '+ Phrase Addition';
  if (t.includes('omission')) return '− Word Omission';
  if (t.includes('substitution')) return '⇄ Word Substitution';
  return '⚙ Form Shift';
}

// 4. Combine verses
const verses = [];
const totalVerses = arabicData.total_verses || 0;

for (let i = 1; i <= totalVerses; i++) {
  const verseKey = `${surah}:${i}`;
  const arabicText = arabicData.verses[String(i)] || '';
  const englishTextObj = englishData[verseKey];
  const englishText = englishTextObj ? englishTextObj.text : '';
  const verseVariants = variantsByAyah[String(i)] || [];
  const qiraatVariants = qiraatByAyah[String(i)] || [];
  const labelsObj = verseLabelsData[verseKey] || {};

  let arabicTextHTML = arabicText;
  let englishTextHTML = englishText;

  if (verseVariants.length > 0) {
    const codexEnSpans = [...new Set(verseVariants.map((v: any) => v.uthmanic_target_english).filter(Boolean))];
    if (codexEnSpans.length > 0) {
      codexEnSpans.sort((a: string, b: string) => b.length - a.length);
      const escapedSpans = codexEnSpans.map((s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      const regex = new RegExp(`(${escapedSpans.join('|')})`, 'gi');
      englishTextHTML = replaceOutsideTags(
        englishTextHTML,
        regex,
        (match) => `<span class="codex-highlight" title="Companion Codex differs on this phrase">${match}</span>`
      );
    }

    const codexArSpans = [...new Set(verseVariants.map((v: any) => v.uthmanic_target_arabic).filter(Boolean))];
    if (codexArSpans.length > 0) {
      codexArSpans.sort((a: string, b: string) => b.length - a.length);
      const escapedAr = codexArSpans.map((s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      const regexAr = new RegExp(`(${escapedAr.join('|')})`, 'g');
      arabicTextHTML = replaceOutsideTags(
        arabicTextHTML,
        regexAr,
        (match) => `<span class="codex-highlight" title="Companion Codex differs on this phrase">${match}</span>`
      );
    }
  }

  if (qiraatVariants.length > 0) {
    const englishWords = [...new Set(qiraatVariants.map((v: any) => v.hafs_english_word).filter(Boolean))];
    if (englishWords.length > 0) {
      // Sort by length descending so longer phrases get replaced first
      englishWords.sort((a: string, b: string) => b.length - a.length);
      const escapedWords = englishWords.map((w: string) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
      const regex = new RegExp(`\\b(${escapedWords.join('|')})\\b`, 'gi');
      englishTextHTML = replaceOutsideTags(
        englishTextHTML,
        regex,
        (match) => `<span class="qiraat-highlight">${match}</span>`
      );
    }

    const arabicWords = [...new Set(qiraatVariants.map((v: any) => v.hafs_arabic_word).filter(Boolean))];
    if (arabicWords.length > 0) {
      // Sort by length descending
      arabicWords.sort((a: string, b: string) => b.length - a.length);
      const regexParts = arabicWords.map((w: string) => {
        // Strip diacritics to get base letters, then allow optional diacritics between AND after letters
        const base = w.replace(/[\u064B-\u065F\u0670]/g, '');
        return base.split('').map(c => c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('[\\u064B-\\u065F\\u0670]*') + '[\\u064B-\\u065F\\u0670]*';
      });
      const regex = new RegExp(`(${regexParts.join('|')})`, 'g');
      arabicTextHTML = replaceOutsideTags(
        arabicTextHTML,
        regex,
        (match) => `<span class="qiraat-highlight">${match}</span>`
      );
    }
  }

  let competingCodexPillLabel = 'Companion Codex';
  let competingCodexHookPreview = '';
  if (verseVariants.length > 0) {
    const allCompNames = [...new Set(
      verseVariants.flatMap((v: any) => v.primary_companions || [v.companion || v.companion_codex]).filter(Boolean)
    )];
    const compSummary = allCompNames.slice(0, 2).join(' & ') + (allCompNames.length > 2 ? ` +${allCompNames.length - 2}` : '');
    const typeTag = getShortVariantTypeTag(verseVariants[0].variant_type);
    competingCodexPillLabel = verseVariants.length === 1
      ? `Companion Codex · ${compSummary} (${typeTag})`
      : `Companion Codices (${verseVariants.length}) · ${compSummary}`;
    competingCodexHookPreview = verseVariants[0].short_title || '';
  }

  const hasManuscript = msQuranSet.has(verseKey);
  const hasChristianFootnotes = christianFootnotesSet.has(verseKey);
  const hasContradictions = quranContradictionsSet.has(verseKey);
  const hasScientificErrors = scientificErrorsSet.has(verseKey);
  const hasIslamicCommentary = islamicCommentariesSet.has(verseKey);
  const hasDebunkingMiracles = debunkingMiraclesSet.has(verseKey);
  const defaultScholar = hasIslamicCommentary ? getDefaultTafsirScholarForVerse(verseKey) : '';
  const tafsirLinkTab = hasIslamicCommentary ? `tafsir/${defaultScholar}` : '';
  const hasVideos = videosSet.has(verseKey);
  const hasSources = sourcesSet.has(verseKey);
  const hasEvidence = hasManuscript || hasChristianFootnotes || hasContradictions || hasScientificErrors || hasIslamicCommentary || hasDebunkingMiracles || hasSources || hasVideos;

  let defaultFirstTab = '';
  if (hasDebunkingMiracles) defaultFirstTab = 'debunking-miracles';
  else if (hasContradictions) defaultFirstTab = 'contradictions';
  else if (hasScientificErrors) defaultFirstTab = 'scientific-errors';
  else if (hasChristianFootnotes) defaultFirstTab = 'christian-footnotes';
  else if (hasIslamicCommentary) defaultFirstTab = tafsirLinkTab;
  else if (hasVideos) defaultFirstTab = 'videos';
  else if (hasSources) defaultFirstTab = 'sources';
  else if (hasManuscript) defaultFirstTab = 'manuscripts';

  verses.push({
    number: i,
    arabic: arabicText,
    english: englishText,
    arabicHTML: arabicTextHTML,
    englishHTML: englishTextHTML,
    defaultFirstTab: defaultFirstTab,
    variants: verseVariants,
    competingCodexPillLabel,
    competingCodexHookPreview,
    qiraatVariants: qiraatVariants,
    labels: labelsObj,
    hasManuscript: hasManuscript,
    hasChristianFootnotes: hasChristianFootnotes,
    hasContradictions: hasContradictions,
    hasScientificErrors: hasScientificErrors,
    hasIslamicCommentary: hasIslamicCommentary,
    hasDebunkingMiracles: hasDebunkingMiracles,
    hasVideos: hasVideos,
    hasSources: hasSources,
    hasEvidence: hasEvidence,
    tafsirLinkTab: tafsirLinkTab
  });
}

const msVerseCount = verses.filter(v => v.hasManuscript).length;
const seoKeywords = `surah ${arabicData.transliteration}, surah ${surahNum}, quran ${surahNum} tafsir, qiraat variants`;

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/quran/${surahNum}`;
const { seoTitle, seoDescription, surahSchema } = generateQuranSurahSEO({
  transliteration: arabicData.transliteration,
  surahNum,
  totalVerses,
  msVerseCount,
  canonicalUrl: canonicalURL
});

// Generate OG Image from the oldest manuscript belonging to ANY verse in this surah
const ogImage = getQuranOgImage(surahNum, null);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={surahSchema}
>
  <div class="quran-reader-container theme-quran prefer-english" data-page="quran-surah">
    <QuranPageHeader currentTitle={`${surahNum}. ${arabicData.transliteration}`} currentIndex={surahNum} h1Text={`Surah ${surahNum}: ${arabicData.transliteration}`} />

    <!-- Language Toggle -->
    <div class="language-toggle select-none">
      <button id="toggle-en" class="toggle-btn active">English</button>
      <button id="toggle-ar" class="toggle-btn">Arabic</button>
    </div>

    <div class="quran-content">
      {verses.length > 0 ? (
        <div class="verses-list">
          {verses.map(v => (
            <div class="verse-card" id={`${v.number}`}>
              <div class="verse-badge-tray">
                <span class="verse-num">{v.number}</span>
                {v.hasDebunkingMiracles && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/debunking-miracles`} data-tab-id="debunking-miracles" data-onboarding-trigger="verse" class="evidence-badge dm-icon" title="Debunked Miracle available" aria-label={`View debunked miracles for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 2l2 4 4-1-2 4 3 3-4 1 1 4-4-2-3 3-1-4-4 1 2-4-4-2 4-1-1-4 4 2 3-4z" />
                    </svg>
                  </a>
                )}
                {v.hasContradictions && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/contradictions`} data-tab-id="contradictions" data-onboarding-trigger="verse" class="evidence-badge ct-icon" title="Contradictions available" aria-label={`View contradictions for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 11 3-11M15 6l3 11 3-11M12 3v18M6 6h12M12 3C8.5 3 5 4 5 4M12 3c3.5 0 7 1 7 1" />
                    </svg>
                  </a>
                )}
                {v.hasScientificErrors && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/scientific-errors`} data-tab-id="scientific-errors" data-onboarding-trigger="verse" class="evidence-badge se-icon" title="Scientific Error available" aria-label={`View scientific errors for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18h8 M3 22h18 M14 22a7 7 0 1 0 0-14h-1 M9 14h2 M9 12a2 2 0 0 1-2-2V6h6v4a2 2 0 0 1-2 2Z M12 6V3 M20 4v4m0 3v.01" />
                    </svg>
                  </a>
                )}
                {v.hasChristianFootnotes && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/christian-footnotes`} data-tab-id="christian-footnotes" data-onboarding-trigger="verse" class="evidence-badge christian-footnote-icon" title="Christian Commentary" aria-label={`View Christian commentary for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2.5" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m-4-10h8" />
                    </svg>
                  </a>
                )}
                {v.hasIslamicCommentary && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/${v.tafsirLinkTab}`} data-tab-id="tafsir" data-onboarding-trigger="verse" class="evidence-badge ic-icon" title="Islamic Commentary" aria-label={`View Islamic commentary for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2.2" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                  </a>
                )}
                {v.hasVideos && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/videos`} data-tab-id="videos" data-onboarding-trigger="verse" class="evidence-badge vd-icon" title="Apologetics videos available" aria-label={`View apologetics videos for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </a>
                )}
                {v.hasSources && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/sources`} data-tab-id="sources" data-onboarding-trigger="verse" class="evidence-badge ps-icon" title="Primary sources available" aria-label={`View primary sources for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2.2" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V10M9.5 21V10M14.5 21V10M19 21V10M2.5 10h19L12 3 2.5 10z" />
                    </svg>
                  </a>
                )}
                {v.hasManuscript && (
                  <a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/manuscripts`} data-tab-id="manuscripts" data-onboarding-trigger="verse" class="evidence-badge ms-icon" title="Manuscripts available" aria-label={`View manuscript evidence for Surah ${surahNum}, verse ${v.number}`}>
                    <svg viewBox="0 0 24 24" stroke-width="2.5" fill="none" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </a>
                )}
                {v.hasEvidence && (
                  <a
                    href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/${v.defaultFirstTab}`}
                    class="verse-open-cue"
                    data-onboarding-trigger="verse"
                    aria-label={`Open commentary and sources for Surah ${surahNum}, verse ${v.number}`}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m9 18 6-6-6-6" />
                    </svg>
                  </a>
                )}
              </div>
              {v.hasEvidence ? (
                <>
                  <p class="text-arabic"><a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/${v.defaultFirstTab}`} class="verse-text-link" data-onboarding-trigger="verse" set:html={v.arabicHTML} /></p>
                  <p class="text-english"><a href={`${import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL}/quran/${surahNum}/${v.number}/${v.defaultFirstTab}`} class="verse-text-link" data-onboarding-trigger="verse" set:html={v.englishHTML} /></p>
                </>
              ) : (
                <>
                  <p class="text-arabic" set:html={v.arabicHTML} />
                  <p class="text-english" set:html={v.englishHTML} />
                </>
              )}

              {v.qiraatVariants && v.qiraatVariants.length > 0 && (
                <details class="qiraat-details">
                  <summary class="qiraat-summary">
                    <span class="qiraat-pill">
                      <span>{Array.from(new Set(v.qiraatVariants.map((variant: any) => `${variant.category} - ${variant.effect}`))).join(' | ')}</span>
                      <PillChevron />
                    </span>
                  </summary>
                  <div class="variants-list">
                    {v.qiraatVariants.map((variant: any) => (
                      <QiraatCard variant={variant} surah={surahNum} ayah={v.number} />
                    ))}
                  </div>
                </details>
              )}

              {v.variants.length > 0 && (
                <details class="competing-codex-details">
                  <summary class="competing-codex-summary">
                    <div class="competing-summary-row">
                      <span class="competing-pill">
                        <span>{v.competingCodexPillLabel}</span>
                        <PillChevron />
                      </span>
                      {v.competingCodexHookPreview && (
                        <span class="competing-preview-hook">{v.competingCodexHookPreview}</span>
                      )}
                    </div>
                  </summary>
                  <div class="variants-list">
                    {v.variants.map(variant => (
                      <VariantCard variant={variant} showCompanionHeader={true} />
                    ))}
                  </div>
                </details>
              )}

              {v.labels && Object.keys(v.labels).length > 0 && (
                <div class="verse-labels-container">
                  {Object.entries(v.labels).map(([labelName, noteText]) => (
                    <details class="label-details" data-surah={surahNum} data-verse={v.number} data-label-name={labelName}>
                      <summary class="label-summary">
                        <span class="label-pill">
                          <span>{labelName}</span>
                          <PillChevron />
                        </span>
                      </summary>
                      <div class="label-note" set:html={parseMarkdown(noteText)} />
                    </details>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="empty-message">No verses found for this Surah.</p>
      )}
    </div>
  </div>
</Layout>

<script>
  import { replaceUrl } from '../../utils/url_history.js';
  import { hasSavedScroll } from '../../utils/scroll_restoration.js';
  import { DEFAULT_QURAN_TAB_ORDER } from '../../utils/quran_config.js';
  import { trackQuranLabelInteraction } from '../../utils/analytics.js';
  import { enforceUserBadgePriority } from '../../utils/dom_tabs.js';

  const initToggle = () => {
    const btnEn = document.getElementById('toggle-en');
    const btnAr = document.getElementById('toggle-ar');
    const container = document.querySelector('.quran-reader-container') as HTMLElement | null;

    if (!btnEn || !btnAr || !container || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    const setLanguage = (lang) => {
      localStorage.setItem('quranLanguage', lang);
      if (lang === 'arabic') {
        container.classList.remove('prefer-english');
        container.classList.add('prefer-arabic');
        btnAr.classList.add('active');
        btnEn.classList.remove('active');
      } else {
        container.classList.remove('prefer-arabic');
        container.classList.add('prefer-english');
        btnEn.classList.add('active');
        btnAr.classList.remove('active');
      }
    };

    // Initialize from localStorage
    const savedLang = localStorage.getItem('quranLanguage') || 'english';
    setLanguage(savedLang);

    btnEn.addEventListener('click', () => setLanguage('english'));
    btnAr.addEventListener('click', () => setLanguage('arabic'));

    // Enforce dynamic user layout preferences immediately on hydration
    enforceUserBadgePriority('ready_apologia_quran_tab_order', DEFAULT_QURAN_TAB_ORDER, '.verse-card', '.verse-badge-tray', '.verse-text-link, .verse-open-cue');

    // Analytics: Track Verse Label Expansions (O(1) Global Delegation)
    container.addEventListener('toggle', (e) => {
      const target = e.target;
      if (target instanceof HTMLDetailsElement && target.matches('.label-details') && target.open) {
        trackQuranLabelInteraction({
          surahNum: target.getAttribute('data-surah') || '',
          verseNum: target.getAttribute('data-verse') || '',
          labelName: target.getAttribute('data-label-name') || '',
          action: 'expand_label'
        });
      }
    }, true); // useCapture: true is REQUIRED because toggle events do not bubble
  };

  // L6 Event Delegation for Verse Clicks
  const handleQuranVerseClick = (e) => {
    // Ignore middle-clicks, cmd/ctrl-clicks which open in new tabs
    if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey) return;

    const link = e.target.closest('.verse-card a[href]');
    if (!link) return;
    // Same-page links (e.g. a cross-reference to another verse in this chapter) are handled by the
    // router; rewriting the URL here would replace the target #hash with this verse's id.
    const url = new URL(link.href, window.location.href);
    if (url.pathname === window.location.pathname && url.search === window.location.search) return;

    const verseCard = link.closest('.verse-card');
    if (verseCard && verseCard.id) {
      replaceUrl(window.location.pathname + '#' + verseCard.id);
    }
  };

  // ------------------------------------------------------------------
  // L6 Refactor: Deterministic Scroll Restoration
  // ------------------------------------------------------------------
  const restoreScrollPosition = () => {
    // Astro's default scroll restoration crashes if IDs are purely numeric (e.g., id="15").
    // We manually intercept the hash and use getElementById which natively handles numbers.
    if (!window.location.hash) return;
    // Back/Forward/reload: scroll_restoration puts the reader exactly where they left off instead.
    if (hasSavedScroll()) return;

    const hashId = window.location.hash.substring(1);
    const element = document.getElementById(hashId);

    if (element) {
      // Deterministically wait for the browser's layout engine to finish painting
      // before telling it to calculate geometrical scroll positions.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          element.scrollIntoView({ behavior: 'auto', block: 'center' });
        });
      });
    }
  };

  // ------------------------------------------------------------------
  // Lifecycle Bindings
  // ------------------------------------------------------------------
  // This bundled script runs once per session, so its page-load handler fires on EVERY later page.
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('[data-page="quran-surah"]')) return;
    initToggle();
    document.addEventListener('click', handleQuranVerseClick);
    restoreScrollPosition();
  });

  document.addEventListener('astro:before-swap', () => {
    document.removeEventListener('click', handleQuranVerseClick);
  });
</script>

