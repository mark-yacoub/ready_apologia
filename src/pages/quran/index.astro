---
import Layout from '../../layouts/Layout.astro';
import QuranPageHeader from '../../components/QuranPageHeader.astro';
import EvidenceCard from '../../components/EvidenceCard.astro';
import FilterPill from '../../components/FilterPill.astro';
import { getAllQiraatCategoriesAndEffects } from '../../utils/qiraatLoader.js';
import { loadAllCompanions, loadTopNonUthmanicVariants, loadLostVersesPageData, companionToSlug } from '../../utils/nonUthmanicLoader.js';

// Load Qiraat categories and effects
const qiraatFilters = await getAllQiraatCategoriesAndEffects();
const effects = qiraatFilters.filter(f => f.type === 'effect').sort((a, b) => b.count - a.count);
const categories = qiraatFilters.filter(f => f.type === 'category').sort((a, b) => b.count - a.count);

// Load verified Companions, Top Variants, and Lost Verses stats
const [companions, topCodexVariants, lostPageData] = await Promise.all([
  loadAllCompanions(),
  loadTopNonUthmanicVariants(5),
  loadLostVersesPageData()
]);

const lostVersesCount = lostPageData.lostPassages.length + lostPageData.featuredVerseVariants.length;
const totalCodexVariantsCount = lostPageData.totalVariantsCount;

// Ensure base path for links
const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/quran`;

const seoTitle = "Quran Evidence - Variant Manuscripts, Competing Codices & Critical Apologetics";
const seoDescription = "Discover the historical transmission of the Quran. Explore lost verses, 11 pre-Uthmanic companion codices preserved in Sahih Bukhari, Muslim, Tabari & Ibn Kathir, and canonical Qiraat variants.";
const seoKeywords = "quran manuscript variants, companion codices, ibn masud codex, ubayy bin kab codex, qiraat differences, lost verses of the quran";

const schemaObj = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Ready Apologia", "item": `${siteUrl}${base}/` },
        { "@type": "ListItem", "position": 2, "name": "Quran Evidence", "item": canonicalURL }
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": canonicalURL,
      "headline": seoTitle,
      "name": seoTitle,
      "description": seoDescription,
      "url": canonicalURL,
      "isPartOf": {
        "@type": "WebSite",
        "name": "Ready Apologia",
        "url": `${siteUrl}${base}/`
      }
    }
  ]
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={schemaObj}
>
  <div class="quran-reader-container theme-quran prefer-english">
    <QuranPageHeader
      currentTitle="Evidence & Filters"
      currentIndex="home"
      hideDropdown={true}
    />

    <div class="evidence-page-container fade-in">
      <!-- 1. Lost Verses Card -->
      <EvidenceCard
        title="Lost Verses"
        className="warm-tint"
        intro="Islamic tradition records numerous instances where verses or entire chapters of the Quran were recited during the lifetime of Muhammad but were subsequently forgotten, omitted, or lost prior to Uthman's standardization."
      >
        <div class="pill-grid">
          <FilterPill href={`${base}/quran/0`} title="Explore Ranked Lost Verses" count={lostVersesCount} variant="primary" />
        </div>
      </EvidenceCard>

      <!-- 2. Competing Codices Card (Upgraded with Companion Cards & Top Samples) -->
      <EvidenceCard
        title="Competing Companion Codices (Pre-Uthmanic Manuscripts)"
        className="warm-tint"
        intro={`Before Caliph Uthman standardized a single consonantal text and ordered all other Quranic manuscripts burned (<a href='https://sunnah.com/bukhari:4987' target='_blank' rel='noopener noreferrer'>Sahih al-Bukhari 4987</a>), senior companions—whom Muhammad explicitly commanded Muslims to learn the Quran from—maintained their own personal codices (<em>Masahif</em>). ${totalCodexVariantsCount} verified textual differences across ${companions.length} Companion Codices survive in <em>Sahih al-Bukhari</em>, <em>Sahih Muslim</em>, <em>Tafsir al-Tabari</em>, and <em>Tafsir Ibn Kathir</em>.`}
      >
        <!-- Companion Codex Directory Grid -->
        <div class="companion-cards-grid">
          {companions.map(comp => (
            <a href={`${base}/quran/codex/${comp.slug}`} class="companion-directory-card">
              <div class="cdir-top">
                <span class="cdir-name">{comp.name}</span>
                <span class="cdir-count-badge">{comp.count} {comp.count === 1 ? 'variant' : 'variants'}</span>
              </div>
              {comp.title && <span class="cdir-role">{comp.title}</span>}
              <div class="cdir-meta">
                {comp.region && <span>{comp.region}</span>}
                {comp.era && <span>• {comp.era}</span>}
              </div>
            </a>
          ))}
        </div>

        <!-- Expandable Quick-Preview of Top 5 Most Impactful Codex Differences -->
        {topCodexVariants.length > 0 && (
          <details class="top-codex-preview-details">
            <summary class="top-codex-preview-summary">
              <span>Preview Top {topCodexVariants.length} Most Impactful Codex Differences (Instant Diff)</span>
              <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="top-codex-preview-list">
              {topCodexVariants.map((v, idx) => {
                const compNames = (v.primary_companions || [v.companion]).join(' & ');
                const primarySlug = companionToSlug((v.primary_companions || [v.companion])[0]);
                return (
                  <div class="mini-diff-item">
                    <div class="mini-diff-header">
                      <div class="mini-diff-left">
                        <span class="mini-rank">#{idx + 1}</span>
                        <a href={`${base}/quran/${v.surah}#${v.ayah}`} class="mini-verse-link">
                          Surah {v.surah}:{v.ayah} ({v.surah_name}) ↗
                        </a>
                        <span class="mini-type-tag">{v.variant_type}</span>
                      </div>
                      <a href={`${base}/quran/codex/${primarySlug}`} class="mini-comp-link">
                        {compNames}'s Codex →
                      </a>
                    </div>
                    <p class="mini-hook">{v.plain_english_hook}</p>
                    <div class="mini-diff-boxes">
                      <div class="mini-box mini-uthmanic">
                        <span class="mini-box-label">Today's Uthmanic Text</span>
                        <span class="mini-del">{v.uthmanic_target_english}</span>
                      </div>
                      <div class="mini-box mini-companion">
                        <span class="mini-box-label">{compNames}'s Codex</span>
                        <span class="mini-ins">{v.variant_target_english}</span>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </details>
        )}
      </EvidenceCard>

      <!-- 3. Variant Readings (Qiraat) by Effect -->
      <EvidenceCard
        title="Variant Readings (Qiraat) – By Change Effect"
        className="warm-tint"
        intro="Due to the inherent ambiguity of the early Arabic consonantal script (<em>rasm</em>)—which lacked diacritical dots (<em>i'jam</em>) and vowel markers (<em>harakat</em>)—early reciters supplied their own vocalizations and consonant choices. This resulted in thousands of officially recognized variants that alter the semantic meaning or grammatical structure of the text."
      >
        <div class="pill-grid">
          {effects.map(filter => (
            <FilterPill href={`${base}/quran/variant/${filter.slug}`} title={filter.title} count={filter.count} variant="primary-soft" />
          ))}
        </div>
      </EvidenceCard>

      <!-- 4. Variant Readings (Qiraat) by Category -->
      <EvidenceCard
        title="Variant Readings (Qiraat) – By Change Category"
        className="warm-tint"
        intro="The Qiraat variants can also be categorized by their specific textual mechanism, such as vowel shifts, dotting variations, or the addition/omission of letters. These variations demonstrate the fluidity of the early oral and written transmission of the Quran."
      >
        <div class="pill-grid">
          {categories.map(filter => (
            <FilterPill href={`${base}/quran/variant/${filter.slug}`} title={filter.title} count={filter.count} variant="primary-soft" />
          ))}
        </div>
      </EvidenceCard>
    </div>
  </div>
</Layout>

<style>
  .evidence-page-container {
    max-width: 840px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    padding-bottom: 5rem;
  }

  .fade-in {
    animation: fadeIn 0.4s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .pill-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Companion Directory Grid */
  .companion-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 10px;
    margin-bottom: 14px;
  }

  .companion-directory-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 10px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .companion-directory-card:hover {
    border-color: var(--color-secondary);
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
    transform: translateY(-1px);
  }

  .cdir-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
  }

  .cdir-name {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 800;
    color: var(--color-primary);
  }

  .cdir-count-badge {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 800;
    color: var(--color-secondary);
    background-color: rgba(151, 69, 67, 0.09);
    padding: 2px 7px;
    border-radius: 9999px;
    white-space: nowrap;
  }

  .cdir-role {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-on-surface);
    line-height: 1.35;
  }

  .cdir-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-family: var(--font-body);
    font-size: 10.5px;
    color: var(--color-on-surface-variant);
    margin-top: 2px;
  }

  /* Top Codex Preview Accordion */
  .top-codex-preview-details {
    border: 1px solid var(--color-outline-variant);
    border-radius: 10px;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .top-codex-preview-summary {
    padding: 12px 16px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-secondary);
    cursor: pointer;
    user-select: none;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-surface-container-low);
  }

  .top-codex-preview-summary::-webkit-details-marker {
    display: none;
  }

  .top-codex-preview-details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .top-codex-preview-list {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid var(--color-outline-variant);
  }

  .mini-diff-item {
    padding: 12px 14px;
    border: 1px solid var(--color-outline-variant);
    border-radius: 8px;
    background-color: var(--color-surface-container-low);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mini-diff-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mini-diff-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .mini-rank {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 800;
    background-color: var(--color-primary);
    color: #ffffff;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .mini-verse-link {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 800;
    color: var(--color-primary);
    text-decoration: none;
  }

  .mini-verse-link:hover {
    text-decoration: underline;
  }

  .mini-type-tag {
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    padding: 1px 6px;
    border-radius: 4px;
  }

  .mini-comp-link {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .mini-comp-link:hover {
    text-decoration: underline;
  }

  .mini-hook {
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-on-surface);
    margin: 0;
  }

  .mini-diff-boxes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .mini-box {
    padding: 8px 10px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--font-display);
    font-size: 13px;
  }

  .mini-uthmanic {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #7f1d1d;
  }

  .mini-companion {
    background-color: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #064e3b;
  }

  .mini-box-label {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    opacity: 0.75;
  }

  .mini-del,
  .mini-ins {
    font-weight: 700;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  @media (max-width: 600px) {
    .mini-diff-boxes {
      grid-template-columns: 1fr;
    }
  }
</style>
