---
import fs from 'node:fs';
import path from 'node:path';

import { generateQuranTabSEO } from '../../../../utils/seoFactory.js';
import Layout from '../../../../layouts/Layout.astro';
import RouteAnalytics from '../../../../components/common/RouteAnalytics.astro';
import QuranVerseTabs from '../../../../components/QuranVerseTabs.jsx';
import QuranManuscriptCarousel from '../../../../components/QuranManuscriptCarousel.jsx';
import VideosGrid from '../../../../components/VideosGrid.astro';
import TafseerViewer from '../../../../components/TafseerViewer.jsx';
import { getQuranOgImage } from '../../../../utils/ogImageResolver.js';
import { query } from '../../../../db.js';
import { loadEnglishData, loadArabicSurah } from '../../../../utils/quran_loader.js';
import { assignManuscriptScanNames } from '../../../../utils/manuscript_utils.js';
import { loadChristianFootnotes } from '../../../../utils/christian_footnotes_loader.js';
import { loadIslamicCommentaries } from '../../../../utils/islamic_commentaries_loader.js';
import { parseMarkdown } from '../../../../utils/markdown.js';
import { loadQuranContradictions } from '../../../../utils/quran_contradictions_loader.js';
import { loadScientificErrors, parseScientificErrorItem } from '../../../../utils/quran_scientific_errors_loader.js';
import { loadDebunkingMiracles } from '../../../../utils/quran_debunking_loader.js';
import { buildDebunkingCard, buildScientificErrorCard } from '../../../../utils/scholarly_card_view_model.js';
import { getEvidenceSets } from '../../../../utils/quran_evidence_service.js';
import { enrichVideosWithVerses } from '../../../../utils/video_service.js';
import { R2_BASE_URL } from '../../../../utils/cdn_config.js';
import { BUILD_SURAHS } from '../../../../utils/build_config.js';

export async function getStaticPaths() {
  const {
    msQuranSet,
    footnotesSet,
    contradictionsSet,
    scientificErrorsSet,
    islamicCommentariesSet,
    debunkingSet,
    videosSet
  } = getEvidenceSets();

  const paths = [];
  const addPaths = (set, tabName) => {
    set.forEach(id => {
      const [s, a] = id.split(':');
      if (s && a && (!BUILD_SURAHS || BUILD_SURAHS.has(s))) {
        paths.push({ params: { surah: s, ayah: a, tab: tabName } });
      }
    });
  };

  addPaths(msQuranSet, 'manuscripts');
  addPaths(footnotesSet, 'christian-footnotes');
  addPaths(contradictionsSet, 'contradictions');
  addPaths(scientificErrorsSet, 'scientific-errors');
    const islamicMapPaths = loadIslamicCommentaries();
  Object.keys(islamicMapPaths).forEach(verseId => {
    const [s, a] = verseId.split(':');
    if (s && a && (!BUILD_SURAHS || BUILD_SURAHS.has(s))) {
      islamicMapPaths[verseId].forEach(comm => {
        paths.push({ params: { surah: s, ayah: a, tab: `tafsir/${comm.id}` } });
      });
    }
  });
  addPaths(debunkingSet, 'debunking-miracles');
  addPaths(videosSet, 'videos');

  return paths;
}

const { surah, ayah, tab } = Astro.params;
const isTafsirTab = tab.startsWith('tafsir');
const activeScholarId = isTafsirTab ? tab.split('/')[1] : null;
const verseId = `${surah}:${ayah}`;

const msCountInfo = query("SELECT COUNT(DISTINCT image_name) as count FROM manuscript_per_verse_quran WHERE verse_id = :verseId", { verseId });
const msCount = msCountInfo.length > 0 ? msCountInfo[0].count : 0;

const footnotesMap = loadChristianFootnotes();
const christianFootnotes = footnotesMap[verseId] || [];
const christianFootnotesCount = christianFootnotes.length;

const islamicMap = loadIslamicCommentaries();
const __rawIslamicCommentaries = islamicMap[verseId] || [];
const islamicCommentariesCount = __rawIslamicCommentaries.length;

const islamicCommentaries = __rawIslamicCommentaries.map(comm => ({
  ...comm,
  formattedContent: comm.commentary ? parseMarkdown(comm.commentary) : '',
  formattedArabicContent: comm.commentary_arabic ? parseMarkdown(comm.commentary_arabic) : ''
}));

const quranContradictionsMap = loadQuranContradictions();
const verseContradictions = quranContradictionsMap[verseId] || [];
const contradictionsCount = verseContradictions.length;

const quranScientificErrorsMap = loadScientificErrors();
const rawVerseError = quranScientificErrorsMap[verseId];
const parsedScientificErrors = rawVerseError ? parseScientificErrorItem(rawVerseError, 0) : [];
const scientificErrorsCount = parsedScientificErrors.length > 0 ? 1 : 0;

const quranDebunkingMap = loadDebunkingMiracles();
const verseDebunking = quranDebunkingMap[verseId] || [];
const debunkingCount = verseDebunking.length;

// Both long-form scholarly tabs share one card template; build the view models for the active tab only.
const scholarlyCards =
  tab === 'debunking-miracles' ? verseDebunking.map(buildDebunkingCard)
  : tab === 'scientific-errors' ? parsedScientificErrors.map(buildScientificErrorCard)
  : [];

const dbVerseId = verseId.replace(':', '_');
const vdCountInfo = query("SELECT COUNT(DISTINCT video_id) as count FROM short_per_verse WHERE verse_id = :dbVerseId", { dbVerseId });
const videosCount = vdCountInfo.length > 0 ? vdCountInfo[0].count : 0;

// 3. Rejoin and pass non-box paragraphs through Markdown parser
const englishData = loadEnglishData();
const verseTextObj = englishData[verseId];
const verseText = verseTextObj ? verseTextObj.text : '';

const arabicData = loadArabicSurah(surah);
const arabicVerseText = arabicData.verses[ayah] || '';

let manuscripts = [];

if (tab === 'manuscripts') {
  const rawManuscripts = query(`
    SELECT m.image_name, mm.*
    FROM manuscript_per_verse_quran m
    LEFT JOIN manuscripts_meta_quran mm ON m.ms_id = mm.ms_id
    WHERE m.verse_id = :verseId
    ORDER BY mm.earliest_date ASC
  `, { verseId });

  manuscripts = assignManuscriptScanNames(rawManuscripts);
}

let videos = [];
if (tab === 'videos') {
  const rawVideos = query(`
    SELECT sm.*, spv.verse_id as target_verse_id, spv.ref_order, spv.total_passages,
           spv.is_primary, spv.relevance_score, spv.composite_score
    FROM short_per_verse spv
    JOIN shorts_metadata sm ON spv.video_id = sm.video_id
    WHERE spv.verse_id = :dbVerseId
    ORDER BY spv.composite_score DESC, sm.rigor_score DESC
  `, { dbVerseId });
  videos = enrichVideosWithVerses(rawVideos, import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL, dbVerseId);
}

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

// Construct explicit self-referencing canonical URL for the active Quran ayah tab
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/quran/${surah}/${ayah}/${tab}`;

// Generate OG Image
const ogImage = getQuranOgImage(surah, ayah);


const activeCommentary = isTafsirTab 
  ? (islamicCommentaries.find(c => c.id === activeScholarId) || islamicCommentaries[0]) 
  : null;
const scholarMenu = isTafsirTab 
  ? islamicCommentaries.map(c => ({ id: c.id, title: c.title || c.name || "Tafsir" })) 
  : [];

const { seoTitle, seoDescription, seoKeywords, seoSchema, openingLine } = generateQuranTabSEO({
  tab: isTafsirTab ? 'tafsir' : tab,
  activeCommentary,
  surah,
  ayah,
  manuscripts,
  christianFootnotes,
  verseContradictions,
  parsedScientificErrors,
  verseDebunking,
  islamicCommentaries,
  videos,
  canonicalUrl: canonicalURL
});

---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  schema={seoSchema}
>
  <RouteAnalytics
    eventName="evidence_tab_view"
    params={{
      testament: 'Quran',
      book_or_surah: surah,
      chapter_or_ayah: ayah,
      verse_id: `${surah}:${ayah}`,
      tab_id: tab
    }}
  />
  <div class="verse-detail-container theme-quran">

    <header class="detail-header select-none">
      <a href={`${base}/quran/${surah}#${ayah}`} class="back-btn" aria-label="Go back to surah reader">
        <span class="back-arrow">
          <svg width="6" height="10" fill="none" stroke="currentColor" viewBox="0 0 6 10" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 9L1 5l4-4" />
          </svg>
        </span>
        <span>Surah {surah}</span>
      </a>

      <div style="display: flex; align-items: center; gap: 8px;">
        <h1 class="verse-drawer-title" style="color: var(--quran-primary);">
          Surah {surah}:{ayah}
        </h1>
        <button id="open-quran-tab-settings-btn" class="subtle-ellipsis-btn" aria-label="Customize Quran Verse View" title="Customize Tabs">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 12a2 2 0 114 0 2 2 0 01-4 0zm8 0a2 2 0 114 0 2 2 0 01-4 0zm8 0a2 2 0 114 0 2 2 0 01-4 0z" />
          </svg>
        </button>
      </div>
    </header>

    {openingLine && (
      <p class="verse-opening-line">{openingLine}</p>
    )}

    {(verseText || arabicVerseText) && (
      <div class="verse-text-reminder header-verse-box select-text" style="border-left-color: var(--quran-primary);">
        {arabicVerseText && (
          <div class="arabic-reminder-text" dir="rtl">{arabicVerseText}</div>
        )}
        {arabicVerseText && verseText && <div class="verse-reminder-divider"></div>}
        {verseText && (
          <div class="english-reminder-text">"{verseText}"</div>
        )}
      </div>
    )}

    <script is:inline>
      try { localStorage.setItem('ready_apologia_has_seen_full_evidence', 'true'); } catch (e) {}
    </script>
    <script>
      function initDebunkingInteractions() {
        const btn = document.getElementById('open-quran-tab-settings-btn');
        if (btn) {
          btn.onclick = () => {
            window.dispatchEvent(new CustomEvent('open-quran-tab-settings'));
          };
        }

        // 1-Tap Copy Quick Summary button (plain-text clipboard copy + debounce-safe timer)
        document.querySelectorAll('[data-copy-summary]').forEach((copyBtn) => {
          copyBtn.onclick = async () => {
            const text = copyBtn.getAttribute('data-copy-summary') || '';
            const labelEl = copyBtn.querySelector('.copy-summary-label');
            try {
              await navigator.clipboard.writeText(text);
              if (labelEl) {
                if (copyBtn._copyTimer) clearTimeout(copyBtn._copyTimer);
                labelEl.textContent = 'Copied!';
                copyBtn.classList.add('copied');
                copyBtn._copyTimer = setTimeout(() => {
                  labelEl.textContent = 'Copy Summary';
                  copyBtn.classList.remove('copied');
                  copyBtn._copyTimer = null;
                }, 1800);
              }
            } catch (e) {}
          };
        });

        function syncPillarToggleBtn(cardEl, toggleBtn) {
          if (!cardEl || !toggleBtn) return;
          const detailsList = Array.from(cardEl.querySelectorAll('details.debunking-pillar-card'));
          const anyOpen = detailsList.some((det) => det.hasAttribute('open'));
          toggleBtn.setAttribute('data-expanded', String(anyOpen));
          toggleBtn.setAttribute('aria-expanded', String(anyOpen));
          toggleBtn.textContent = anyOpen ? 'Collapse All Sections' : 'Expand All Sections';
        }

        // 5-Pillar Jump Bar (auto-open target pillar & smooth scroll)
        document.querySelectorAll('[data-pillar-target]').forEach((pill) => {
          pill.onclick = (e) => {
            const targetId = pill.getAttribute('data-pillar-target');
            if (!targetId) return;
            const targetEl = document.getElementById(targetId);
            if (targetEl) {
              e.preventDefault();
              targetEl.setAttribute('open', '');
              targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              const cardEl = targetEl.closest('[data-debunking-card]');
              const toggleBtn = cardEl?.querySelector('[data-toggle-pillars]');
              syncPillarToggleBtn(cardEl, toggleBtn);
            }
          };
        });

        // Expand / Collapse All Pillars toggle + live sync with manual <details> toggles
        document.querySelectorAll('[data-toggle-pillars]').forEach((toggleBtn) => {
          const cardIdx = toggleBtn.getAttribute('data-toggle-pillars');
          const cardEl = document.querySelector(`[data-debunking-card="${cardIdx}"]`);
          if (!cardEl) return;

          cardEl.querySelectorAll('details.debunking-pillar-card').forEach((det) => {
            det.ontoggle = () => syncPillarToggleBtn(cardEl, toggleBtn);
          });

          toggleBtn.onclick = () => {
            const detailsList = Array.from(cardEl.querySelectorAll('details.debunking-pillar-card'));
            const anyOpen = detailsList.some((det) => det.hasAttribute('open'));
            const nextExpanded = !anyOpen;
            detailsList.forEach((det) => {
              if (nextExpanded) {
                det.setAttribute('open', '');
              } else {
                det.removeAttribute('open');
              }
            });
            syncPillarToggleBtn(cardEl, toggleBtn);
          };
        });
      }

      document.addEventListener('astro:page-load', initDebunkingInteractions);
      if (document.readyState !== 'loading') {
        initDebunkingInteractions();
      }
    </script>

    <QuranVerseTabs
      client:load
      msCount={msCount}
      christianFootnotesCount={christianFootnotesCount}
      islamicCommentariesCount={islamicCommentariesCount}
      contradictionsCount={contradictionsCount}
      scientificErrorsCount={scientificErrorsCount}
      debunkingCount={debunkingCount}
      videosCount={videosCount}
      activeTab={isTafsirTab ? 'tafsir' : tab}
      activeTafsirScholarId={__rawIslamicCommentaries.length > 0 ? __rawIslamicCommentaries[0].id : null}
      surah={surah}
      ayah={ayah}
    />

    <div class="tab-panels-window">
      {scholarlyCards.length > 0 && (
        <div class="contradiction-panel-container">
          {scholarlyCards.map((card) => (
            <div class="contradiction-details-card" data-debunking-card={card.cardId}>
              <div class="contradiction-summary-header debunking-card-header">
                <span class="summary-title-main">
                  <span class="ct-scales-icon" style={card.iconColor ? `color: ${card.iconColor};` : undefined}>
                    <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke="currentColor" width="18" height="18">
                      <path stroke-linecap="round" stroke-linejoin="round" d={card.iconPath} />
                    </svg>
                  </span>
                  <span>{card.headerTitle}</span>
                </span>
                {card.headerBadge && (
                  <span class="debunking-header-badge">{card.headerBadge}</span>
                )}
              </div>

              <div class="contradiction-card-content">
                {card.claimMarkdown && (
                  <div class="debunking-claim-box">
                    <span class="debunking-claim-label">CLAIMED SCIENTIFIC MIRACLE</span>
                    <div class="debunking-claim-text" set:html={parseMarkdown(card.claimMarkdown)} />
                  </div>
                )}

                {card.summaryText && (
                  <div class="debunking-quick-summary-card">
                    <div class="debunking-quick-summary-header">
                      <div class="debunking-quick-summary-title">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" style="color: #10b981;">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                        </svg>
                        <span>Quick Summary — At a Glance</span>
                      </div>
                      <button
                        type="button"
                        class="copy-summary-btn"
                        data-copy-summary={card.summaryPlainText}
                        aria-label="Copy quick summary to clipboard"
                        title="Copy quick summary for conversation"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span class="copy-summary-label">Copy Summary</span>
                      </button>
                    </div>
                    <div class="ct-answer-body debunking-quick-summary-body" set:html={parseMarkdown(card.summaryText)} />
                  </div>
                )}

                {card.methodology && (
                  <details class="debunking-methodology-details debunking-methodology-top">
                    <summary class="debunking-methodology-summary">
                      <span class="debunking-methodology-title">
                        <span class="methodology-tag-label">Methodological Classification:</span>
                        <strong>{card.methodology.classification}</strong>
                      </span>
                      <span class="info-icon-btn" title="Click for methodological explanation" aria-label="Explanation info">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
                      </span>
                    </summary>
                    {card.methodology.explanationMarkdown && (
                      <div class="debunking-methodology-body" set:html={parseMarkdown(card.methodology.explanationMarkdown)} />
                    )}
                  </details>
                )}

                {card.sections.length > 0 ? (
                  <div class="debunking-refutation-section debunking-academic-paper-section">
                    <div class="debunking-paper-header-row">
                      <h4 class="debunking-refutation-heading" style="margin: 0;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="color: #10b981;">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                        <span>{card.analysisHeading}</span>
                      </h4>
                      <button
                        type="button"
                        class="toggle-all-pillars-btn"
                        data-toggle-pillars={card.cardId}
                        data-expanded="true"
                        aria-expanded="true"
                      >
                        Collapse All Sections
                      </button>
                    </div>

                    <nav class="debunking-toc-bar" aria-label={card.tocAriaLabel}>
                      {card.sections.map((section) => (
                        <a
                          href={`#${section.id}`}
                          class="debunking-toc-pill"
                          data-pillar-target={section.id}
                        >
                          {section.shortLabel}
                        </a>
                      ))}
                    </nav>

                    {card.introMarkdown && (
                      <div class="ct-answer-body debunking-paper-abstract" set:html={parseMarkdown(card.introMarkdown)} />
                    )}

                    <div class="debunking-pillars-stack">
                      {card.sections.map((section) => (
                        <details class="debunking-pillar-card" id={section.id} open>
                          <summary class="debunking-pillar-summary">
                            <div class="debunking-pillar-heading-left">
                              <span class="pillar-num-badge">{section.number}</span>
                              <span class="pillar-title-text">{section.title}</span>
                            </div>
                            <span class="pillar-chevron-icon" aria-hidden="true">
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                              </svg>
                            </span>
                          </summary>
                          <div class="ct-answer-body debunking-pillar-body" set:html={parseMarkdown(section.bodyMarkdown)} />
                        </details>
                      ))}
                    </div>
                  </div>
                ) : (
                  card.introMarkdown && (
                    <div class="ct-answer-body" style="padding-top: 16px;" set:html={parseMarkdown(card.introMarkdown)} />
                  )
                )}
              </div>
            </div>
          ))}
        </div>
      )}
      {isTafsirTab && activeCommentary && (
        <TafseerViewer 
          client:load 
          activeCommentary={activeCommentary}
          scholarMenu={scholarMenu}
          surah={surah} 
          ayah={ayah}
        />
      )}
      {tab === 'manuscripts' && (
        <div>
          <QuranManuscriptCarousel
            client:load
            manuscripts={manuscripts}
            surah={surah}
            ayah={ayah}
            verseLabel={`Surah ${surah}:${ayah}`}
          />
        </div>
      )}
      {tab === 'christian-footnotes' && (
        <div class="christian-footnotes-panel">
          {christianFootnotes.map((note) => (
            <div class="footnote-card">
              <div class="footnote-content" set:html={parseMarkdown(note.content)} />
              <p class="footnote-source">- from <em>The Quran with Christian Commentary: A Guide to Understanding the Scripture of Islam</em></p>
            </div>
          ))}
        </div>
      )}
      {tab === 'contradictions' && (
        <div class="contradiction-panel-container">
          {verseContradictions.map((ct) => {
            return (
                <div class="contradiction-details-card">
                  <div class="contradiction-summary-header">
                    <span class="summary-title-main">
                      <span class="ct-scales-icon">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 11 3-11M15 6l3 11 3-11M12 3v18M6 6h12M12 3C8.5 3 5 4 5 4M12 3c3.5 0 7 1 7 1"/></svg>
                      </span>
                      {ct.evidence}
                    </span>
                  </div>

                  <div class="contradiction-card-content">
                    <div class="ct-flex-boxes">
                      {ct.supporting_verses && ct.supporting_verses.length > 0 && (
                        <div class="ct-box">
                          <h4 class="ct-box-header" style="color: #10b981;">Supporting Verses</h4>
                          <div class="ct-verses-list">
                            {ct.supporting_verses.map(v => {
                              const [vs, va] = v.split(':');
                              const targetTextObj = englishData[v];
                              const targetText = targetTextObj ? targetTextObj.text : '';
                              return (
                                <div class="verse-text-reminder snippet-reminder snippet-supp">
                                  <a href={`${base}/quran/${vs}#${va}`} class="ct-verse-link" title="Tap to read this supporting verse">{`Surah ${v}`} &rarr;</a>
                                  {targetText && <span> "{targetText}"</span>}
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}

                      {ct.opposite_verses && ct.opposite_verses.length > 0 && (
                        <div class="ct-box">
                          <h4 class="ct-box-header" style="color: #ef4444;">Opposing Verses</h4>
                          <div class="ct-verses-list">
                            {ct.opposite_verses.map(v => {
                              const [vs, va] = v.split(':');
                              const targetTextObj = englishData[v];
                              const targetText = targetTextObj ? targetTextObj.text : '';
                              return (
                                <div class="verse-text-reminder snippet-reminder snippet-opp">
                                  <a href={`${base}/quran/${vs}#${va}`} class="ct-verse-link" title="Tap to read this contrasting verse">{`Surah ${v}`} &rarr;</a>
                                  {targetText && <span> "{targetText}"</span>}
                                </div>
                              );
                            })}
                          </div>
                        </div>
                      )}
                    </div>

                    <div class="ct-answer-body ct-plain-text">
                      {ct.description}
                    </div>
                  </div>
                </div>
            );
          })}
        </div>
      )}
      {tab === 'videos' && (
        <div class="videos-panel-container">
          <VideosGrid videos={videos} />
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
	.verse-detail-container {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.detail-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid var(--color-outline-variant);
