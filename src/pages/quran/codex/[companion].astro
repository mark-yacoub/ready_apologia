---
import Layout from '../../../layouts/Layout.astro';
import RouteAnalytics from '../../../components/common/RouteAnalytics.astro';
import VariantCard from '../../../components/VariantCard.astro';
import VideosCarousel from '../../../components/VideosCarousel.astro';
import { loadCompanionCodex, loadAllCompanions, companionToSlug } from '../../../utils/nonUthmanicLoader.js';
import { query } from '../../../db.js';
import { enrichVideosWithVerses } from '../../../utils/video_service.js';

export async function getStaticPaths() {
  const companions = await loadAllCompanions();
  const paths = companions.map(c => ({
    params: { companion: c.slug },
    props: { companionName: c.name }
  }));

  // Also support legacy slug 'abdullah-bin-abbas' -> 'Ibn Abbas'
  if (!paths.some(p => p.params.companion === 'abdullah-bin-abbas')) {
    paths.push({
      params: { companion: 'abdullah-bin-abbas' },
      props: { companionName: 'Ibn Abbas' }
    });
  }

  return paths;
}

const { companion } = Astro.params;
const { companionName } = Astro.props;

const [codexData, allCompanions] = await Promise.all([
  loadCompanionCodex(companionName),
  loadAllCompanions()
]);

if (!codexData) {
  return Astro.redirect('/404');
}

const base = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL;

const codexVerseId = codexData.verse_id;
let videos = [];
if (codexVerseId) {
  try {
    const rawVideos = query(`
      SELECT sm.*
      FROM short_per_verse spv
      JOIN shorts_metadata sm ON spv.video_id = sm.video_id
      WHERE spv.verse_id = :codexVerseId
    `, { codexVerseId });
    videos = enrichVideosWithVerses(rawVideos, base);
  } catch (e) {
    console.warn(`[CodexPage] Failed to query videos for ${codexVerseId}`, e);
  }
}

const allVariants = codexData.allVariants || [];

// Compute filter category counts for this companion
const countAdditions = allVariants.filter(v => (v.variant_type || '').toLowerCase().includes('addition')).length;
const countOmissions = allVariants.filter(v => (v.variant_type || '').toLowerCase().includes('omission')).length;
const countSubstitutions = allVariants.filter(v => (v.variant_type || '').toLowerCase().includes('substitution')).length;
const countShifts = allVariants.filter(v => {
  const t = (v.variant_type || '').toLowerCase();
  return t.includes('shift') || t.includes('morphological') || t.includes('vocalization');
}).length;
const countSpecial = allVariants.filter(v => {
  const t = (v.variant_type || '').toLowerCase();
  return t.includes('surah') || t.includes('lost') || v.is_special_passage;
}).length;
const countHadith = allVariants.filter(v => Array.isArray(v.hadiths) && v.hadiths.length > 0).length;

const filterCategories = [
  { id: 'all', label: 'All Variants', count: allVariants.length },
  { id: 'hadith', label: 'Sahih Bukhari & Muslim', count: countHadith },
  { id: 'addition', label: '+ Phrase Additions', count: countAdditions },
  { id: 'omission', label: '− Word Omissions', count: countOmissions },
  { id: 'substitution', label: '⇄ Word Substitutions', count: countSubstitutions },
  { id: 'shift', label: '⚙ Form & Consonantal Shifts', count: countShifts },
  { id: 'special', label: '📜 Lost Verses & Surahs', count: countSpecial }
].filter(f => f.id === 'all' || f.count > 0);

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://readyapologia.com';
const canonicalURL = `${siteUrl}${base}/quran/codex/${codexData.slug}`;

const seoTitle = `The Codex of ${codexData.name} (${codexData.total_variants} Variants) - Competing Quranic Manuscripts`;
const seoDescription = `Explore ${codexData.total_variants} verified textual variants, additions, omissions, and lost verses from the personal Quranic codex of ${codexData.name} (${codexData.title}), documented in Sahih al-Bukhari, Sahih Muslim, Tafsir al-Tabari, and Tafsir Ibn Kathir.`;
const seoKeywords = `codex of ${codexData.name}, mushaf of ${codexData.name}, non-uthmanic quran, uthmanic standardization, variant quran manuscripts`;

const schemaObj = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Ready Apologia", "item": `${siteUrl}${base}/` },
        { "@type": "ListItem", "position": 2, "name": "Quran Evidence", "item": `${siteUrl}${base}/quran` },
        { "@type": "ListItem", "position": 3, "name": `Codex of ${codexData.name}`, "item": canonicalURL }
      ]
    },
    {
      "@type": "Article",
      "@id": `${canonicalURL}#article`,
      "headline": seoTitle,
      "description": seoDescription,
      "url": canonicalURL,
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
      "author": { "@type": "Organization", "name": "Ready Apologia" },
      "publisher": { "@type": "Organization", "name": "Ready Apologia", "logo": { "@type": "ImageObject", "url": `${siteUrl}${base}/assets/logo.png` } }
    }
  ]
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonicalURL={canonicalURL}
  ogUrl={canonicalURL}
  ogType="article"
  schema={schemaObj}
>
  <RouteAnalytics
    eventName="quran_special_view"
    params={{
      page_type: 'codex',
      slug_or_id: companion
    }}
  />

  <div class="codex-page-container theme-quran prefer-english">
    <!-- Top Navigation & Companion Switcher -->
    <nav class="codex-top-nav" aria-label="Companion Codices Navigation">
      <div class="nav-top-row">
        <a href={`${base}/quran`} class="back-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Quran Evidence Hub</span>
        </a>
        <a href={`${base}/quran/0`} class="secondary-nav-link">
          <span>View All Lost Verses</span>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="companion-switcher-bar">
        <span class="switcher-label">Switch Companion Codex:</span>
        <div class="switcher-pills">
          {allCompanions.map(c => {
            const isCurrent = c.name === codexData.name;
            return (
              <a
                href={`${base}/quran/codex/${c.slug}`}
                class={`switcher-pill ${isCurrent ? 'active' : ''}`}
                aria-current={isCurrent ? 'page' : undefined}
              >
                <span>{c.name}</span>
                <span class="switcher-count">{c.count}</span>
              </a>
            );
          })}
        </div>
      </div>
    </nav>

    <!-- Companion Hero & Credentials Card -->
    <header class="companion-hero-card">
      <div class="hero-top-row">
        <div class="hero-title-group">
          <div class="eyebrow-row">
            <span class="codex-eyebrow">Pre-Uthmanic Companion Mushaf</span>
            {codexData.region && <span class="meta-chip">{codexData.region}</span>}
            {codexData.era && <span class="meta-chip">{codexData.era}</span>}
          </div>

          <div class="name-row">
            <h1 class="companion-h1">{codexData.name}</h1>
            {codexData.arabic_name && (
              <span class="companion-arabic-name" dir="rtl">{codexData.arabic_name}</span>
            )}
          </div>

          {codexData.title && (
            <p class="companion-subtitle">{codexData.title}</p>
          )}
        </div>

        {codexData.bio_url && (
          <a
            href={codexData.bio_url}
            target="_blank"
            rel="noopener noreferrer"
            class="narrator-profile-btn"
            title={`Verify ${codexData.name}'s biographical profile on Sunnah.com`}
          >
            <span>Sunnah.com Profile</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        )}
      </div>

      <!-- Key Statistics Bar -->
      <div class="hero-stats-grid">
        <div class="stat-box">
          <span class="stat-num">{codexData.total_variants || allVariants.length}</span>
          <span class="stat-label">Verified Textual Variants</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">{codexData.bukhari_muslim_count || countHadith}</span>
          <span class="stat-label">In Sahih Bukhari & Muslim</span>
        </div>
        <div class="stat-box">
          <span class="stat-num">{codexData.tafsir_count || allVariants.length}</span>
          <span class="stat-label">In Tabari & Ibn Kathir</span>
        </div>
      </div>

      <!-- Historical Biography -->
      {(codexData.biography || codexData.bio_text) && (
        <p class="companion-bio-paragraph">
          {codexData.biography || codexData.bio_text}
        </p>
      )}

      <!-- Collapsible Prophetic Endorsements (Virtues Hadiths) -->
      {codexData.virtues && codexData.virtues.length > 0 && (
        <details class="credentials-details">
          <summary class="credentials-summary">
            <span class="credentials-summary-left">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Why {codexData.name}'s Recitation Carries Canonical Authority ({codexData.virtues.length} Sahih Hadiths)</span>
            </span>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="credentials-hadiths-list">
            {codexData.virtues.map((hadith: any) => (
              <div class="credential-hadith-card">
                <div class="cred-top">
                  <span class="cred-ref">{hadith.source_reference}</span>
                  {hadith.sunnah_url && (
                    <a href={hadith.sunnah_url} target="_blank" rel="noopener noreferrer" class="cred-verify-link">
                      <span>Sunnah.com</span>
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </a>
                  )}
                </div>
                {hadith.hadith_arabic && <p class="text-arabic cred-ar" dir="rtl">{hadith.hadith_arabic}</p>}
                {hadith.hadith_english && <p class="text-english cred-en">{hadith.hadith_english}</p>}
              </div>
            ))}
          </div>
        </details>
      )}
    </header>

    <!-- Videos / Shorts Section (if available) -->
    {videos.length > 0 && (
      <section class="codex-videos-section">
        <details class="videos-accordion">
          <summary class="videos-accordion-summary">
            <span>Related Apologetics Shorts on {codexData.name} ({videos.length})</span>
            <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="videos-accordion-body">
            <VideosCarousel videos={videos} />
          </div>
        </details>
      </section>
    )}

    <!-- Interactive Filter, Sort & Language Controls Bar -->
    <section class="controls-toolbar" aria-label="Filter and Sort Variants">
      <div class="filter-pills-row" role="tablist" aria-label="Filter by Change Type">
        {filterCategories.map((cat, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            class={`codex-filter-pill ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
          >
            <span>{cat.label}</span>
            <span class="filter-count">{cat.count}</span>
          </button>
        ))}
      </div>

      <div class="secondary-controls-row">
        <div class="sort-selector-group">
          <span class="control-label">Sort:</span>
          <button type="button" id="sort-impact" class="sort-btn active" data-sort="rank">
            Most Impactful First
          </button>
          <button type="button" id="sort-surah" class="sort-btn" data-sort="surah">
            Surah Order
          </button>
        </div>

        <div class="language-toggle select-none">
          <button type="button" id="toggle-en" class="toggle-btn active">English</button>
          <button type="button" id="toggle-ar" class="toggle-btn">Arabic</button>
        </div>
      </div>
    </section>

    <!-- Unified Stream of 5-Second Diff Cards -->
    <section class="variants-stream" id="codex-variants-stream">
      {allVariants.map((v) => (
        <VariantCard
          variant={v}
          showCompanionHeader={false}
          showVerseLink={true}
          showRank={true}
          activeCompanionName={codexData.name}
          titleTag="h2"
        />
      ))}
    </section>
  </div>
</Layout>

<script>
  const initCodexPage = () => {
    const container = document.querySelector('.codex-page-container') as HTMLElement | null;
    const stream = document.getElementById('codex-variants-stream');
    if (!container || !stream || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    // 1. Language Toggle
    const btnEn = document.getElementById('toggle-en');
    const btnAr = document.getElementById('toggle-ar');

    const setLanguage = (lang: string) => {
      localStorage.setItem('quranLanguage', lang);
      if (lang === 'arabic') {
        container.classList.remove('prefer-english');
        container.classList.add('prefer-arabic');
        btnAr?.classList.add('active');
        btnEn?.classList.remove('active');
      } else {
        container.classList.remove('prefer-arabic');
        container.classList.add('prefer-english');
        btnEn?.classList.add('active');
        btnAr?.classList.remove('active');
      }
    };

    const savedLang = localStorage.getItem('quranLanguage') || 'english';
    setLanguage(savedLang);

    btnEn?.addEventListener('click', () => setLanguage('english'));
    btnAr?.addEventListener('click', () => setLanguage('arabic'));

    // 2. Filter Pills
    const filterBtns = Array.from(container.querySelectorAll('.codex-filter-pill'));
    const cards = Array.from(stream.querySelectorAll('.variant-card')) as HTMLElement[];

    const applyFilter = (filterId: string) => {
      filterBtns.forEach(btn => {
        const isMatch = btn.getAttribute('data-filter') === filterId;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      cards.forEach(card => {
        const vtype = (card.getAttribute('data-variant-type') || '').toLowerCase();
        const hasHadith = card.getAttribute('data-has-hadith') === 'true';
        const surahVal = card.getAttribute('data-surah') || '';
        const ayahVal = card.getAttribute('data-ayah') || '';

        let visible = true;
        if (filterId === 'hadith') {
          visible = hasHadith;
        } else if (filterId === 'addition') {
          visible = vtype.includes('addition');
        } else if (filterId === 'omission') {
          visible = vtype.includes('omission');
        } else if (filterId === 'substitution') {
          visible = vtype.includes('substitution');
        } else if (filterId === 'shift') {
          visible = vtype.includes('shift') || vtype.includes('morphological') || vtype.includes('vocalization');
        } else if (filterId === 'special') {
          visible = vtype.includes('surah') || vtype.includes('lost') || surahVal === '999' || ayahVal === '0';
        }
        card.style.display = visible ? '' : 'none';
      });
    };

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const fid = btn.getAttribute('data-filter') || 'all';
        applyFilter(fid);
      });
    });

    // 3. Sort Buttons (Impact Rank vs Surah Order)
    const sortBtns = Array.from(container.querySelectorAll('.sort-btn'));
    const applySort = (sortMode: string) => {
      sortBtns.forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-sort') === sortMode);
      });

      const sorted = [...cards].sort((a, b) => {
        if (sortMode === 'surah') {
          const sA = parseInt(a.getAttribute('data-surah') || '999', 10);
          const sB = parseInt(b.getAttribute('data-surah') || '999', 10);
          if (sA !== sB) return sA - sB;
          const aA = parseInt(a.getAttribute('data-ayah') || '0', 10);
          const aB = parseInt(b.getAttribute('data-ayah') || '0', 10);
          if (aA !== aB) return aA - aB;
        }
        const rA = parseInt(a.getAttribute('data-global-rank') || '999', 10);
        const rB = parseInt(b.getAttribute('data-global-rank') || '999', 10);
        return rA - rB;
      });

      sorted.forEach(card => stream.appendChild(card));
    };

    sortBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-sort') || 'rank';
        applySort(mode);
      });
    });
  };

  document.addEventListener('astro:page-load', initCodexPage);
</script>

<style>
  .codex-page-container {
    display: flex;
    flex-direction: column;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 16px 64px 16px;
    gap: 24px;
  }

  /* Top Navigation & Companion Switcher */
  .codex-top-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .nav-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .back-link,
  .secondary-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-on-surface-variant);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-link:hover,
  .secondary-nav-link:hover {
    color: var(--color-secondary);
  }

  .companion-switcher-bar {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    border-radius: 10px;
    padding: 10px 14px;
  }

  .switcher-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-on-surface-variant);
  }

  .switcher-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .switcher-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    background-color: var(--color-surface);
    color: var(--color-on-surface-variant);
    border: 1px solid var(--color-outline-variant);
    transition: all 0.15s ease;
  }

  .switcher-pill:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  .switcher-pill.active {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    font-weight: 700;
  }

  .switcher-count {
    font-size: 10.5px;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 9999px;
    background-color: rgba(0, 0, 0, 0.06);
  }

  .switcher-pill.active .switcher-count {
    background-color: rgba(255, 255, 255, 0.22);
    color: #ffffff;
  }

  /* Companion Hero & Credentials Card */
  .companion-hero-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-outline-variant);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
  }

  .hero-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-title-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .eyebrow-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .codex-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--color-secondary);
    background-color: rgba(151, 69, 67, 0.08);
    padding: 3px 8px;
    border-radius: 5px;
  }

  .meta-chip {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-on-surface-variant);
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    padding: 2px 8px;
    border-radius: 5px;
  }

  .name-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 2px;
  }

  .companion-h1 {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.2;
  }

  .companion-arabic-name {
    font-family: 'Amiri', 'Traditional Arabic', serif;
    font-size: 22px;
    color: var(--color-on-surface-variant);
    font-weight: 700;
  }

  .companion-subtitle {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-secondary);
    margin: 0;
  }

  .narrator-profile-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary);
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
    padding: 6px 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .narrator-profile-btn:hover {
    background-color: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
  }

  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .stat-box {
    background-color: var(--color-surface-container-low);
    border: 1px solid var(--color-outline-variant);
