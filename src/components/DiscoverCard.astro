---
export interface Props {
  card: {
    slug: string;
    title: string;
    description: string;
    thumbnail?: string;
  };
  base: string;
}

const { card, base } = Astro.props;

// Image Optimization for remote CDNs (Specifically Unsplash for our mock catalog)
let optimizedThumbnail = card.thumbnail;
if (optimizedThumbnail && optimizedThumbnail.includes('images.unsplash.com')) {
  // If it doesn't already have query params, forcefully append optimal parameters. 
  // Unsplash implicitly uses Imgix across their platform. Using standard APIs `&w=350&q=80&fm=webp` 
  // slashes payloads dynamically without the need for build-time Astro assets pipelines!
  const hasParams = optimizedThumbnail.includes('?');
  optimizedThumbnail += (hasParams ? '&' : '?') + 'w=350&q=80&fm=webp';
}
---

<a href={`${base}/discover/${card.slug}`} class="discover-card">
  <div class="card-image-wrap">
    {optimizedThumbnail ? (
      <img 
        src={optimizedThumbnail.startsWith('/') ? `${base}${optimizedThumbnail}` : optimizedThumbnail} 
        alt={card.title} 
        loading="lazy" 
        decoding="async"
        width="350"
        height="250"
      />
    ) : (
      <div class="fallback-bg"></div>
    )}
  </div>
  <div class="card-content">
    <h4 class="card-title">{card.title}</h4>
    <p class="card-desc">{card.description}</p>
  </div>
</a>

<style>
  .discover-card {
    width: 100%;
    height: 100%;
    min-height: 220px;
    background-color: var(--ra-surface, #ffffff);
    border-radius: 14px;
    border: 1px solid var(--ra-line, #e8e2d9);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--ra-shadow-sm, 0 1px 2px rgba(27, 25, 23, 0.04));
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  @media (hover: hover) {
    .discover-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--ra-shadow, 0 1px 2px rgba(27, 25, 23, 0.04), 0 6px 20px -8px rgba(27, 25, 23, 0.09));
      border-color: var(--ra-line-strong, #d8d0c4);
    }
  }

  .discover-card:active {
    transform: translateY(0px);
  }

  .card-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 140px;
    background-color: var(--ra-well, #f3efe8);
    overflow: hidden;
    border-bottom: 1px solid var(--ra-line, #e8e2d9);
    position: relative;
  }

  .card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  @media (hover: hover) {
    .discover-card:hover .card-image-wrap img {
      transform: scale(1.04);
    }
  }

  .fallback-bg {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--ra-well, #f3efe8) 0%, var(--ra-paper, #fbf9f5) 100%);
  }

  .card-content {
    padding: 12px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 5px;
  }

  .card-title {
    font-family: var(--ra-display, 'Literata', Georgia, serif);
    font-size: 13.5px;
    font-weight: 750;
    margin: 0;
    padding: 0;
    border: 0;
    line-height: 1.28;
    color: var(--ra-ink, #1b1917);
  }

  .card-desc {
    font-family: var(--ra-sans, 'Public Sans', sans-serif);
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--ra-ink-2, #57514a);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .card-content {
      padding: 14px;
      gap: 6px;
    }
    .card-title {
      font-size: 14.5px;
    }
    .card-desc {
      font-size: 12px;
    }
  }
</style>
