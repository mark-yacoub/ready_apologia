---
export interface Props {
  title?: string;
  message?: string;
  buttonText?: string;
  url?: string;
}

const {
  title = "More Topics Coming Soon",
  message = "We are actively researching and building more deep-dive discovery topics to be pushed in the coming weeks. Stay tuned!",
  buttonText = "Vote on next articles",
  url = "https://forms.gle/KVeeDW41J9zqJtdZ7"
} = Astro.props;
---

<aside aria-label="Coming soon announcement" class="discovery-coming-soon">
  <div class="coming-soon-icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
      <path d="M12 7v6M9 10h6" />
    </svg>
  </div>
  <div class="coming-soon-content">
    <h3 class="coming-soon-title">{title}</h3>
    <p class="coming-soon-text">{message}</p>
    <a href={url} target="_blank" rel="noopener noreferrer" class="coming-soon-btn">
      {buttonText}
    </a>
  </div>
</aside>

<style>
  .discovery-coming-soon {
    margin: 28px 0 24px;
    background-color: var(--ra-surface, #ffffff);
    border: 1px solid var(--ra-line, #e8e2d9);
    border-radius: var(--ra-radius, 14px);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    box-shadow: var(--ra-shadow-sm, 0 1px 2px rgba(27, 25, 23, 0.04));
  }

  .coming-soon-icon {
    width: 44px;
    height: 44px;
    background-color: var(--ra-well, #f3efe8);
    color: var(--ra-ink-2, #57514a);
    border: 1px solid var(--ra-line, #e8e2d9);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .coming-soon-icon svg {
    width: 20px;
    height: 20px;
  }

  .coming-soon-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: center;
  }

  .coming-soon-title {
    font-family: var(--ra-display, 'Literata', Georgia, serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--ra-ink, #1b1917);
    margin: 0;
  }

  .coming-soon-text {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ra-ink-2, #57514a);
    margin: 0 0 6px 0;
    max-width: 340px;
  }

  .coming-soon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    background-color: var(--ra-ink, #1b1917);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 700;
    border-radius: var(--ra-radius-sm, 8px);
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .coming-soon-btn:hover {
    background-color: var(--ra-ink-2, #3b3733);
    transform: translateY(-1px);
  }

  .coming-soon-btn:active {
    transform: translateY(0);
  }

  .coming-soon-btn:focus-visible {
    outline: 2px solid var(--ra-verify, #0e5e6f);
    outline-offset: 2px;
  }
</style>
