---
/**
 * Homepage "Start here" card: the introduction to the site, linking to
 * /discover/through-christian-eyes. Reads strictly from `model.js` so all copy
 * passes the same inline rendering and editorial guardrails as the article.
 */
import { loadThroughChristianEyes } from '../../utils/throughChristianEyes/model.js';

interface Props {
  base: string;
}

const { base } = Astro.props;
const m = loadThroughChristianEyes();
const href = `${base}${m.path}`;
---

<section class="ra-section ra-tce" aria-labelledby="ra-sec-tce">
  <a href={href} class="ra-tce-card">
    <div class="ra-tce-main">
      <p class="ra-tce-eyebrow">{m.homeCard.eyebrow}</p>
      <h2 id="ra-sec-tce" class="ra-tce-title" set:html={m.homeCard.titleHtml} />
      <p class="ra-tce-sub" set:html={m.homeCard.subtitleHtml} />
      <p class="ra-tce-body" set:html={m.homeCard.bodyHtml} />
      <span class="ra-tce-cta">{m.homeCard.cta} <span aria-hidden="true">→</span></span>
    </div>
    <ol class="ra-tce-list">
      {m.sections.map((s) => (
        <li><span class="ra-tce-num" aria-hidden="true">{s.number}</span><span set:html={s.titleHtml} /></li>
      ))}
    </ol>
  </a>
</section>

<style>
  /* Kept compact: on phones the five questions are left to the article itself; from 768px they sit beside the copy. */
  .ra-tce {
    --tce-ink: #1c1917;
    --tce-muted: #57534e;
    --tce-accent: #883432;
    --tce-gold: #92400e;
    --tce-paper: #fbf8f3;
    --tce-line: #e2d8ca;
  }
  .ra-tce :global(.hrv-tlm),
  .ra-tce :global(.hrv-ar-inline) {
    font-family: 'Amiri', serif;
    font-style: normal;
    line-height: 1;
  }
  .ra-tce-card {
    display: grid;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 16px;
    background: var(--tce-paper);
    border: 1px solid var(--tce-line);
    border-left: 4px solid var(--tce-accent);
    color: var(--tce-ink);
    text-decoration: none;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .ra-tce-card:hover,
  .ra-tce-card:focus-visible {
    box-shadow: 0 4px 16px rgba(136, 52, 50, 0.12);
  }
  .ra-tce-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .ra-tce-eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tce-gold);
  }
  .ra-tce-title {
    margin: 0;
    font-family: var(--font-display, 'Literata', Georgia, serif);
    font-size: 22px;
    font-weight: 800;
    line-height: 1.15;
    color: var(--tce-accent);
  }
  .ra-tce-sub {
    margin: 0;
    font-family: var(--font-display, 'Literata', Georgia, serif);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }
  .ra-tce-body {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--tce-muted);
  }
  .ra-tce-list {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .ra-tce-list li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ra-tce-num {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    padding-top: 1px;
    border-radius: 50%;
    background: var(--tce-accent);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1;
  }
  .ra-tce-cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    margin-top: 4px;
    border-radius: 999px;
    background: var(--tce-accent);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }
  @media (min-width: 768px) {
    .ra-tce-card {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      gap: 24px;
      padding: 18px 24px;
    }
    .ra-tce-title {
      font-size: 26px;
    }
    .ra-tce-sub {
      font-size: 16px;
    }
    .ra-tce-list {
      display: grid;
      padding-left: 24px;
      border-left: 1px solid var(--tce-line);
    }
  }
</style>
