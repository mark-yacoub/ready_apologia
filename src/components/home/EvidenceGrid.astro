---
import { tl } from '../../utils/hadithReliability/render.js';
import type { HomeStats } from '../../utils/homeStats.js';

interface Props {
  base: string;
  stats: HomeStats;
}

interface EvidenceCard {
  href: string;
  title: string;
  badge: string;
  desc: string;
}

const { base, stats } = Astro.props;
// Every number below is computed at build time (src/utils/homeStats.js); none is typed by hand.
const n = (v: number) => v.toLocaleString('en-US');
const ev = (id: string) => `${base}/evidence/${id}`;

// Christian doctrine first, matching DeepDiveList and the dataset-card order on `/`.
const groups: { heading: string; cards: EvidenceCard[] }[] = [
  {
    heading: 'Defending Christian Doctrine',
    cards: [
      {
        href: ev('divinity_of_christ'),
        title: 'Divinity of Christ',
        badge: `${n(stats.divinityChristCount)} citations`,
        desc: `${n(stats.dcNtVersesCount)} New Testament verses, ${n(stats.dcOtVersesCount)} Old Testament verses, ${n(stats.dcFathersQuotesCount)} quotations from the Ante-Nicene Fathers and ${n(stats.dcJewishSourcesCount)} ancient Jewish “Two Powers in Heaven” sources.`,
      },
      {
        href: ev('nt_authors'),
        title: 'New Testament Authorship',
        badge: `${n(stats.ntAuthorsCount)} patristic passages`,
        desc: `Book-by-book attributions by 1st–4th century writers, and early canon lists, across all ${n(stats.ntAuthorsBooksCount)} New Testament books.`,
      },
      {
        href: ev('prophecies'),
        title: 'Fulfilled Messianic Prophecies',
        badge: `${n(stats.propheciesCount)} items`,
        desc: `${n(stats.prophecyPairsCount)} Old Testament prophecies paired with their New Testament fulfillments, and ${n(stats.prophecyJewishCount)} ancient Jewish messianic expectations.`,
      },
      {
        href: ev('divinity_of_the_holy_spirit'),
        title: 'Divinity of the Holy Spirit',
        badge: `${n(stats.holySpiritCount)} citations`,
        desc: `${n(stats.hsScriptureCount)} Old and New Testament passages, ${n(stats.hsFathersCount)} Ante-Nicene patristic testimonies and ${n(stats.hsJewishCount)} ancient Jewish sources on the personhood and deity of the Holy Spirit.`,
      },
      {
        href: ev('trinity'),
        title: 'The Holy Trinity',
        badge: `${n(stats.trinityCount)} citations`,
        desc: `${n(stats.trinityScriptureCount)} Old and New Testament passages and ${n(stats.trinityFathersCount)} quotations from Church Fathers writing before AD 325.`,
      },
      {
        href: `${base}/bible/jn/1/1/apologetics`,
        title: 'Verse Exegesis & Cross-Referenced Pairings',
        badge: `${n(stats.apologeticsCount)} defenses · ${n(stats.pairingsCount)} pairings`,
        desc: `${n(stats.patristicEntriesCount)} verse-level Patristic commentaries, ${n(stats.scholarlyDefensesCount)} scholarly defenses, and ${n(stats.pairingsCount)} bidirectional cross-referenced scripture pairings.`,
      },
    ],
  },
  {
    heading: 'Examining the Qurʾān',
    cards: [
      {
        href: ev('quran_sources'),
        title: 'Primary Sources of the Qurʾān',
        badge: `${n(stats.qsParallelsCount)} parallels`,
        desc: `${n(stats.qsParallelsCount)} Qurʾān stories, phrases and practices side by side with earlier Rabbinic, apocryphal, Syriac, Zoroastrian and Arabian texts: ${n(stats.qsCitationsCount)} primary-source citations across ${n(stats.qsVersesCount)} verses.`,
      },
      {
        href: ev('quranic_deficiencies'),
        title: 'Qurʾān Passages on History, the Bible & Morality',
        badge: `${n(stats.qdVersesCount)} verses`,
        desc: `${n(stats.qdVersesCount)} verses on history, earlier Jewish and Christian sources, the Bible and moral questions, each beside its classical tafsīr and primary sources.`,
      },
      {
        href: ev('scientific_errors'),
        title: 'Qurʾān Verses on Cosmology & Embryology',
        badge: `${n(stats.seVersesCount)} verses`,
        desc: `${n(stats.seVersesCount)} verses on the heavens, the shape of the earth, embryology and astronomy, beside classical tafsīr, Arabic lexicons and modern science.`,
      },
    ],
  },
];
---

<section class="ra-section" aria-labelledby="ra-sec-evidence">
  <div class="ra-sec-head">
    <div class="ra-sec-head-row">
      <div>
        <p class="ra-eyebrow">Evidence Directories</p>
        <h2 id="ra-sec-evidence" class="ra-h2">The Bible, the Church Fathers &amp; the Qurʾān</h2>
      </div>
      <a href={`${base}/evidence`} class="ra-sec-link">Open Evidence Explorer →</a>
    </div>
    <p class="ra-sec-sub">
      {n(stats.evidenceDirectoriesCount)} directories of primary texts: Old and New Testament verses beside {n(stats.patristicWorksCount)} works by {n(stats.patristicFathersCount)} early Church Fathers and Second Temple Jewish texts, and Qurʾān passages beside earlier writings and classical tafsīr.
    </p>
  </div>

  {groups.map((group, i) => (
    <Fragment>
      <div class:list={['ra-subhead-row', { 'ra-subhead-row--spaced': i > 0 }]}>
        <h3 class="ra-subhead" set:html={tl(group.heading)} />
      </div>
      <div class="ra-list-grid">
        {group.cards.map((card) => (
          <a href={card.href} class="ra-list-card">
            <div class="ra-list-top">
              <span class="ra-list-title" set:html={tl(card.title)} />
              <span class="ra-list-badge">{card.badge}</span>
            </div>
            <p class="ra-list-desc" set:html={tl(card.desc)} />
          </a>
        ))}
      </div>
    </Fragment>
  ))}
</section>
