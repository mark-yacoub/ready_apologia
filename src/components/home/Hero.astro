---
import { tl } from '../../utils/hadithReliability/render.js';
import type { HomeStats } from '../../utils/homeStats.js';
import EntryGrid from './EntryGrid.astro';

interface Props {
  base: string;
  redirectUrl: string;
  stats: HomeStats;
}

const { base, redirectUrl, stats } = Astro.props;
---

<header class="ra-hero">
  <div class="ra-hero-brand">
    <img src={`${base}/assets/logo.png`} alt="" width="36" height="28" class="ra-hero-logo" />
    <span class="ra-hero-eyebrow" set:html={tl('The Bible & Qurʾān from the Primary Sources')} />
  </div>
  <h1 class="ra-h1">Ready Apologia</h1>
  <p
    class="ra-lead"
    set:html={tl(
      'The Bible and the Qurʾān, verse by verse, beside photos of dated manuscripts, the early Church Fathers, classical Qurʾān commentaries (tafsīr) in full, and authentic (Ṣaḥīḥ) hadith. Every source is linked.'
    )}
  />

  <EntryGrid base={base} redirectUrl={redirectUrl} stats={stats} />
</header>
