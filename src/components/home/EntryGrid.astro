---
import type { HomeStats } from '../../utils/homeStats.js';
import { loadApologists } from '../../utils/apologistsLoader.js';

interface Props {
  base: string;
  redirectUrl: string;
  stats: HomeStats;
}

const { base, redirectUrl, stats } = Astro.props;
const apologists = await loadApologists();
---

<nav class="ra-start-grid" aria-label="Primary entry points">
  <a href={redirectUrl} class="ra-start-btn ra-start-btn--primary">
    <span class="ra-start-top">
      <span class="ra-start-title">Read the Bible</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">Manuscripts, answers &amp; videos by verse</span>
  </a>

  <a href={`${base}/quran`} class="ra-start-btn ra-start-btn--quran">
    <span class="ra-start-top">
      <span class="ra-start-title">Qurʾān &amp; Codices</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">{stats.surahsCount} sūras · {stats.companionsCount} Companion Codices</span>
  </a>

  <a href={`${base}/hadith`} class="ra-start-btn">
    <span class="ra-start-top">
      <span class="ra-start-title">Ṣaḥīḥ Hadiths</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">{stats.hadithCount} Bukhārī &amp; Muslim texts</span>
  </a>

  <a href={`${base}/discover`} class="ra-start-btn">
    <span class="ra-start-top">
      <span class="ra-start-title">Discover Deep Dives</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">{stats.discoverArticlesCount} primary-source dossiers</span>
  </a>

  <a href={`${base}/evidence`} class="ra-start-btn">
    <span class="ra-start-top">
      <span class="ra-start-title">Theological Evidence</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">{stats.evidenceDirectoriesCount} Scripture &amp; Patristic directories</span>
  </a>

  <a href={`${base}/apologists`} class="ra-start-btn ra-start-btn--apologists">
    <span class="ra-start-top">
      <span class="ra-start-title">Videos by Apologist</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">{apologists.people.length} apologists · {apologists.totalClips.toLocaleString('en-US')} short answers</span>
  </a>

  <a href={`${base}/discover/statistics`} class="ra-start-btn ra-start-btn--stats">
    <span class="ra-start-top">
      <span class="ra-start-title">Not sure where to start?</span>
      <span class="ra-start-arrow" aria-hidden="true">→</span>
    </span>
    <span class="ra-start-meta">Most-discussed verses, oldest manuscripts &amp; more</span>
  </a>
</nav>
