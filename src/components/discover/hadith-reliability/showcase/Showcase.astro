---
/**
 * The "see it in ten seconds" panel at the top of a case, designed per kind of evidence.
 * `compact` renders the at-a-glance / start-here variant (no links: the card itself is a link).
 * `label` (optional) overrides the caption, for articles whose captions are not hrv's ANGLES.
 */
import Icon from '../Icon.astro';
import NumberFan from './NumberFan.astro';
import Bars from './Bars.astro';
import Versions from './Versions.astro';
import Redline from './Redline.astro';
import Timeline from './Timeline.astro';
import ChainAnatomy from './ChainAnatomy.astro';
import Witnesses from './Witnesses.astro';
import Confrontation from './Confrontation.astro';
import Facts from './Facts.astro';
import { ANGLES } from '../../../../utils/hadithReliability/config.js';

// `label` overrides the caption (other articles reuse the archetypes with their own kind labels).
// `level` is the heading level archetypes use inside the showcase (default h3); only archetypes with
// headings (Confrontation) read it.
const { sc, compact = false, id = 'sc', caption = true, label = null, level = 3 } = Astro.props;
const COMPONENTS = { number_fan: NumberFan, bars: Bars, versions: Versions, redline: Redline, timeline: Timeline, chain: ChainAnatomy, witnesses: Witnesses, confrontation: Confrontation, facts: Facts };
const C = COMPONENTS[sc.type] || Facts;
const angle = ANGLES.find(a => a.id === sc.type);
const capText = label || (sc.type === 'facts' ? 'Key findings' : (angle?.label || 'At a glance'));
---
<section class={`hrv-sc hrv-sc--${sc.type}${compact ? ' hrv-sc--compact' : ''}`} aria-label={capText}>
  {caption && <div class="hrv-sc__cap"><Icon name={sc.type} />{capText}</div>}
  <C sc={sc} compact={compact} id={id} level={level} />
</section>
