---
/**
 * Two texts of the same report; the changed or removed wording is highlighted.
 * Optional `sc.rows` stacks several A/B pairs (e.g. one per verse); each pair is a RedlinePair.
 */
import RedlinePair from './RedlinePair.astro';
const { sc, compact = false } = Astro.props;
const pairs = sc.rows ?? [sc];
---
{pairs.map(p => <RedlinePair p={p} compact={compact} />)}
{sc.noteHtml && !compact && <p class="hrv-sc__note" set:html={sc.noteHtml} />}
