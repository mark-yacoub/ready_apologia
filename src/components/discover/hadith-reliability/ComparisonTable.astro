---
/** Real table on desktop; each row becomes a labelled card on phones (CSS only). */
// `level` sets the title heading (default h3).
const { t, level = 3 } = Astro.props;
const H = `h${level}`;
---
<div class="hrv-table-wrap">
  <H class="hrv-table-title" set:html={t.titleHtml} />
  <table class="hrv-table">
    <thead><tr>{t.headers.map(h => <th scope="col" set:html={h.html} />)}</tr></thead>
    <tbody>
      {t.rows.map(row => (
        <tr>{row.map((cell, i) => <td data-label={t.headers[i]?.label || ''}><span class="hrv-td" set:html={cell} /></td>)}</tr>
      ))}
    </tbody>
  </table>
</div>
