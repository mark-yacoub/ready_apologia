---
/**
 * Compact 4-row "At a glance" index linking directly to #section-stage1..#section-stage4.
 * Each full row is a single tap target (>= 48 px height).
 */
import Icon from '../hadith-reliability/Icon.astro';
import { tl } from '../../../utils/hadithReliability/render.js';
const { rows } = Astro.props;
---
<ol class="twb-glance">
  {rows.map(r => (
    <li>
      <a class="twb-glance__row" href={r.href}>
        <span class="twb-glance__n" aria-hidden="true">{String(r.n).padStart(2, '0')}</span>
        <span class="twb-glance__body">
          <span class="twb-glance__title" set:html={r.titleHtml} />
          {r.takeawayHtml && <span class="twb-glance__take" set:html={r.takeawayHtml} />}
          {r.chips.length > 0 && <span class="hrv-badges twb-glance__chips">{r.chips.map(c => <span set:html={tl(c)} />)}</span>}
        </span>
        <Icon name="chevronDown" class="twb-glance__chev" />
      </a>
    </li>
  ))}
</ol>
