---
/**
 * Sticky section bar: back to Discover · section chips (plain in-page links, horizontally scrollable
 * with a right-edge fade on phones) · copy link. client.js marks the chip of the section being read
 * (aria-current) and, on tap, copies the canonical URL + that section's #id. It never rewrites the URL.
 * The toast is an empty live region until a copy happens, so nothing is announced on load.
 */
import Icon from '../hadith-reliability/Icon.astro';
const { nav, labels, backHref, canonical } = Astro.props;
---
<nav class="orv-nav" aria-label={labels.navAria} data-orv-nav>
  <a class="hrv-iconbtn orv-nav__back" href={backHref} aria-label={labels.back}><Icon name="chevronLeft" /><span class="orv-nav__backtext" aria-hidden="true">{labels.back}</span></a>
  <div class="orv-nav__track" data-orv-track>
    <ol class="orv-nav__list">
      {nav.map(s => (
        <li><a class="orv-nav__chip" href={`#${s.id}`} data-orv-chip={s.id}>{s.n != null && <span class="orv-nav__n" aria-hidden="true">{s.n}</span>}<span set:html={s.labelHtml} /></a></li>
      ))}
    </ol>
  </div>
  <button class="hrv-iconbtn orv-nav__copy" type="button" data-orv-copy data-url={canonical} data-copied={labels.copied} data-failed={labels.copyFailed} aria-label={labels.copyLink} title={labels.copyLink}><Icon name="link" /></button>
</nav>
<div class="hrv-toast" role="status" aria-live="polite" data-orv-toast></div>
