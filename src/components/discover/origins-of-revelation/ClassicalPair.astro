---
/**
 * "The classical explanation" (slate, the scholars' voice) followed by "Comparing with the primary
 * text" (teal). Both stay open; the texts always come last. "Go deeper" panels follow, collapsed.
 */
import Icon from '../hadith-reliability/Icon.astro';
import { tl } from '../../../utils/hadithReliability/render.js';
const { classical, evaluation, deeper = [] } = Astro.props;
---
{classical && (
  <div class="hrv-scholar orv-pair">
    <h3 class="hrv-scholar__h"><Icon name="quote" /><span set:html={tl(classical.label)} /></h3>
    <div class="orv-pair__body" set:html={classical.html} />
    {classical.deeper && (
      <details class="hrv-disclosure orv-pair__more">
        <summary><span set:html={tl(classical.deeper.summary)} /><Icon name="chevronDown" /></summary>
        <div class="hrv-disclosure__body orv-pair__body" set:html={classical.deeper.html} />
      </details>
    )}
  </div>
)}
{evaluation && (
  <div class="hrv-eval orv-pair">
    <h3 class="hrv-eval__h"><Icon name="search" /><span set:html={tl(evaluation.label)} /></h3>
    <div class="orv-pair__body" set:html={evaluation.html} />
    {evaluation.deeper && (
      <details class="hrv-disclosure orv-pair__more">
        <summary><span set:html={tl(evaluation.deeper.summary)} /><Icon name="chevronDown" /></summary>
        <div class="hrv-disclosure__body orv-pair__body" set:html={evaluation.deeper.html} />
      </details>
    )}
  </div>
)}
{deeper.map(d => (
  <details class="hrv-disclosure orv-deeper">
    <summary><span set:html={tl(d.summary)} /><Icon name="chevronDown" /></summary>
    <div class="hrv-disclosure__body orv-pair__body" set:html={d.html} />
  </details>
))}
