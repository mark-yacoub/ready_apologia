---
export interface Props {
  title: string;
  intro?: string;
  className?: string;
}

const { title, intro, className = '' } = Astro.props;
// warm-tint cards carry a top accent bar (ra-accent-bar helper in src/styles/ui.css).
const barClass = className.split(/\s+/).includes('warm-tint') ? 'ra-accent-bar ra-accent-bar--top' : '';
---
<section class={`evidence-card ${className} ${barClass}`.trim()}>
  <div class="card-header">
    <h2>{title}</h2>
    {intro && <p class="scholastic-intro" set:html={intro} />}
  </div>
  <slot />
</section>

<style>
  .evidence-card {
    background-color: var(--ra-surface, #ffffff);
    border: 1px solid var(--ra-line, #e8e2d9);
    border-radius: 14px;
    padding: 1.5rem;
    margin-bottom: 1.75rem;
    box-shadow: var(--ra-shadow-sm, 0 1px 2px rgba(27, 25, 23, 0.04));
  }

  .evidence-card.warm-tint {
    --ra-bar-color: var(--ra-islamic-rule, #c2d6c6);
    background: var(--ra-surface, #ffffff);
    border-color: var(--ra-line, #e8e2d9);
  }

  .card-header h2 {
    font-family: var(--ra-display, 'Literata', Georgia, serif);
    font-size: 1.45rem;
    color: var(--ra-ink, #1b1917);
    margin-top: 0;
    margin-bottom: 0.7rem;
  }

  .scholastic-intro {
    font-family: var(--ra-sans, 'Public Sans', sans-serif);
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--ra-ink-2, #57514a);
    text-align: left;
    margin-bottom: 1.4rem;
    margin-top: 0;
  }

  .scholastic-intro :global(a) {
    color: var(--ra-verify, #0e5e6f);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .evidence-card {
      padding: 1.15rem 1rem;
    }
    .card-header h2 {
      font-size: 1.25rem;
    }
    .scholastic-intro {
      font-size: 0.9rem;
    }
  }
</style>
